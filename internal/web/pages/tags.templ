package pages

import (
	"slices"
	"strconv"

	"github.com/MahmoudDahdouh/musdash-go/internal/db"
	"github.com/MahmoudDahdouh/musdash-go/internal/web/ui"
)

// tagsCard is the part of an app's or a service's settings that holds its
// tags: what it has, and a dialog to change that. The dialog offers every
// tag of the team, so a tag made on the Tags page can be given here without
// being typed again.
templ tagsCard(csrf, action string, tags, teamTags []string) {
	<section class="card" id="tags">
		<div class="card-head">
			<div>
				<h2 class="card-title">Tags</h2>
				<p class="muted text-sm">What shares a tag is listed together on the Tags page, and the API can deploy it in one call.</p>
			</div>
			if len(tags) > 0 {
				@ui.Button(ui.ButtonProps{Small: true, Icon: "pencil", Opens: "edit-tags"}) {
					Edit
				}
			}
		</div>
		if len(tags) == 0 {
			@ui.EmptyState(ui.EmptyProps{Icon: "tag", Title: "No tags", Text: "Give it a tag to group it with everything else that has it.", Size: ui.EmptySmall}) {
				@ui.Button(ui.ButtonProps{Variant: ui.Primary, Small: true, Icon: "plus", Opens: "edit-tags"}) {
					Add tags
				}
			}
		} else {
			<p class="card-body flex flex-wrap gap-2">
				for _, t := range tags {
					<a class="badge" href={ templ.SafeURL("/tags/" + t) }>{ t }</a>
				}
			</p>
		}
	</section>
	@ui.FormDialog(ui.DialogProps{ID: "edit-tags", Title: "Tags", Action: action, CSRF: csrf, Submit: "Save tags"}) {
		if len(teamTags) > 0 {
			<fieldset class="grid gap-2">
				<legend class="field-label">The team's tags</legend>
				<div class="grid gap-2 sm:grid-cols-2">
					for i, t := range teamTags {
						<label class="check" for={ "tag-" + strconv.Itoa(i) }>
							<input type="checkbox" id={ "tag-" + strconv.Itoa(i) } name="tag" value={ t } checked?={ slices.Contains(tags, t) }/>
							<span class="fact">{ t }</span>
						</label>
					}
				</div>
			</fieldset>
		}
		@ui.Field(ui.FieldProps{Label: "New tags", For: "new-tags", Hint: "Separated by commas or spaces. Lowercase letters, numbers, dots and hyphens."}) {
			@ui.Input(ui.InputProps{ID: "new-tags", Name: "tags", Mono: true, Described: true, Placeholder: "nightly, frontend", Autocomplete: "off"})
		}
	}
}

templ newTagDialog(csrf string, f ui.Form) {
	@ui.FormDialog(ui.DialogProps{ID: "new-tag", Title: "New tag", Description: "A tag groups apps and services that belong together. Give it to them afterwards, from their Settings.", Action: "/tags", CSRF: csrf, Submit: "Create tag", Open: !f.OK()}) {
		@ui.TextField(f, "Name", "Lowercase letters, numbers, dots and hyphens.", ui.InputProps{ID: "tag-name", Name: "name", Mono: true, Required: true, Autofocus: true, Placeholder: "weekly", Autocomplete: "off", Attrs: templ.Attributes{"maxlength": "32"}})
	}
}

templ Tags(s ui.Shell, list []db.TagCount, f ui.Form) {
	@ui.Layout(s) {
		@ui.PageHeader("Tags", "Groups of apps and services. What shares a tag is listed together, and the API can deploy it in one call.") {
			if len(list) > 0 {
				@ui.Button(ui.ButtonProps{Variant: ui.Primary, Icon: "plus", Opens: "new-tag"}) {
					New tag
				}
			}
		}
		if len(list) == 0 {
			@ui.EmptyState(ui.EmptyProps{Icon: "tag", Title: "No tags yet", Text: "Make a tag, then give it to apps and services. Everything with that tag is listed together, and the API can deploy it in one call."}) {
				@ui.Button(ui.ButtonProps{Variant: ui.Primary, Icon: "plus", Opens: "new-tag"}) {
					New tag
				}
			}
		} else {
			@ui.Tiles("Tags", false) {
				for _, t := range list {
					@ui.Tile(ui.TileProps{Href: "/tags/" + t.Tag, Icon: "tag", Title: t.Tag}) {
						if t.Apps+t.Services == 0 {
							@ui.Meta("", "Nothing has it yet", "")
						} else {
							@ui.Meta(KindIcon(db.KindApp), strconv.Itoa(t.Apps), noun(t.Apps, "app", "apps"))
							@ui.Meta(KindIcon(db.KindService), strconv.Itoa(t.Services), noun(t.Services, "service", "services"))
						}
					}
				}
			}
		}
		@newTagDialog(s.CSRF, f)
	}
}

// tagHas says how many things have a tag, in a word or two.
func tagHas(t db.TagCount) string {
	if n := t.Apps + t.Services; n > 0 {
		return strconv.Itoa(n)
	}
	return "empty"
}

// TagOptions is what the tag switcher lists: the team's tags. at is the
// one the person is on.
templ TagOptions(list []db.TagCount, at string) {
	for _, t := range list {
		@ui.SwitchOption("/tags/"+t.Tag, "tag", t.Tag, t.Tag == at) {
			<span class="muted text-xs">{ tagHas(t) }</span>
		}
	}
	if len(list) > 0 {
		@ui.MenuSep()
	}
	@ui.MenuAction("/tags", "dashboard", "All tags")
}

func tagSummary(n int) string {
	if n == 0 {
		return "Nothing has this tag yet."
	}
	return plural(n, "resource has", "resources have") + " this tag."
}

// Tag is one tag: what has it, and what can be done with the tag itself.
// f is the rename form.
templ Tag(s ui.Shell, tag string, apps []db.App, services []db.Service, f ui.Form) {
	@ui.Layout(s) {
		@ui.PageHeader(tag, tagSummary(len(apps)+len(services))) {
			@ui.Button(ui.ButtonProps{Icon: "pencil", Opens: "rename-tag"}) {
				Rename
			}
			<form method="post" action={ templ.SafeURL("/tags/" + tag + "/delete") }>
				@ui.CSRF(s.CSRF)
				@ui.Button(ui.ButtonProps{Type: "submit", Variant: ui.DangerQuiet, Icon: "trash", Attrs: ui.Ask("Delete the tag "+tag+"?", "It is taken off everything that has it. The apps and services themselves are not touched.", "Delete tag", true)}) {
					Delete
				}
			</form>
		}
		<div class="grid gap-6">
			if len(apps)+len(services) == 0 {
				@ui.EmptyState(ui.EmptyProps{Icon: "tag", Title: "Nothing has this tag yet", Text: "Give it to an app or a service: open its Settings and edit its tags.", Link: "Go to Projects", LinkHref: "/projects"})
			} else {
				@ResourceTiles(Resources{Apps: apps, Services: services})
			}
		</div>
		@ui.FormDialog(ui.DialogProps{ID: "rename-tag", Title: "Rename tag", Description: "What has the tag keeps it under the new name. A pipeline that deploys by the old name has to be changed.", Action: "/tags/" + tag, CSRF: s.CSRF, Submit: "Rename tag", Open: !f.OK()}) {
			@ui.TextField(f, "Name", "Lowercase letters, numbers, dots and hyphens.", ui.InputProps{ID: "tag-name", Name: "name", Mono: true, Required: true, Value: tag, Autocomplete: "off", Attrs: templ.Attributes{"maxlength": "32"}})
		}
	}
}
