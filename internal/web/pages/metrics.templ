package pages

import (
	"github.com/MahmoudDahdouh/musdash-go/internal/db"
	"github.com/MahmoudDahdouh/musdash-go/internal/web/ui"
)

// Usage is one live reading, as the page shows it. The page asks for it
// when it is opened and again every few seconds while it stays open.
type Usage struct {
	Meters []ui.MeterProps
	Rows   []UsageRow
	// Problem says why there is no reading.
	Problem string
	// Next is where the next reading is asked for, and Every how often.
	// Next is empty once a page has been open long enough that nobody is
	// likely to be looking: the questions stop until it is asked to go on.
	Next  string
	Every string
	// Resume is the page to reload to start again.
	Resume string
}

// UsageRow is one container in a reading.
type UsageRow struct {
	Name string // the container's own
	// Title and Kind are what the container belongs to, when that is
	// something of the reader's team: the row is called by it, and Href
	// is its page.
	Title, Kind string
	Href        string
	CPU         string
	Mem         string
}

// ServerFigures and ResourceFigures are what a reading of a server and of
// a resource's containers measure, in the order they are shown.
var (
	ServerFigures   = []string{"Processor", "Memory", "Load", "Disk"}
	ResourceFigures = []string{"Processor", "Memory", "Network", "Disk"}
)

// UsagePending stands where the first reading will be, at the size the
// reading has: the cells are there, named and empty, so nothing below
// moves when it arrives. It asks again by itself when it was not answered,
// which is what happens while every reading is in use, and not while a
// question is still out: a slow server may take longer than the ten
// seconds.
templ UsagePending(url string, figures []string) {
	<section id="usage" class="card" aria-busy="true" hx-get={ url } hx-trigger="load, every 10s" hx-sync="this:drop" hx-swap="outerHTML">
		<div class="card-head">
			<div>
				<h2 class="card-title">In use now</h2>
				<p class="muted text-sm" role="status">Reading what is in use…</p>
			</div>
		</div>
		@ui.Stats() {
			for _, name := range figures {
				@ui.Stat(ui.MeterProps{Label: name, Share: -1})
			}
		}
	</section>
}

templ UsageNow(u Usage) {
	<section
		id="usage"
		class="card"
		if u.Next != "" {
			hx-get={ u.Next }
			hx-trigger={ "every " + u.Every }
			hx-swap="outerHTML"
		}
	>
		<div class="card-head">
			<div>
				<h2 class="card-title">In use now</h2>
				if u.Next != "" {
					<p class="muted text-sm">Read again every { u.Every } while this page is open.</p>
				} else {
					<p class="muted text-sm">Paused: this page has been open for a while.</p>
				}
			</div>
			if u.Next == "" {
				@ui.LinkButton(u.Resume, ui.ButtonProps{Small: true, Icon: "refresh"}) {
					Read again
				}
			}
		</div>
		if u.Problem != "" {
			<div class="card-body">
				@ui.Notice(ui.ToneWarn) {
					<p class="break-words">{ u.Problem }</p>
				}
			</div>
		}
		if len(u.Meters) > 0 {
			@ui.Stats() {
				for _, m := range u.Meters {
					@ui.Stat(m)
				}
			}
		}
		if len(u.Rows) > 0 {
			<div class="usage-rows">
				// ui.Table's markup, written out for the two columns of
				// figures, whose headings stand over their ends.
				<div class="table-wrap">
					<table class="table">
						<thead>
							<tr>
								<th scope="col">Container</th>
								<th scope="col" class="num">Processor</th>
								<th scope="col" class="num">Memory</th>
							</tr>
						</thead>
						<tbody>
							for _, row := range u.Rows {
								<tr>
									<td>
										if row.Title != "" {
											<span class="flex items-center gap-2">
												@ui.Icon(KindIcon(row.Kind), "text-ink-mute")
												<a class="link" href={ templ.SafeURL(row.Href) }>{ row.Title }</a>
											</span>
											<span class="fact block text-xs text-ink-mute">{ row.Name }</span>
										} else {
											<span class="fact">{ row.Name }</span>
										}
									</td>
									<td class="fact num">{ row.CPU }</td>
									<td class="fact num">{ row.Mem }</td>
								</tr>
							}
						</tbody>
					</table>
				</div>
			</div>
		}
	</section>
}

// History is the charts of a server or a resource.
type History struct {
	// Sampled says whether the server keeps samples at all.
	Sampled bool
	Ranges  []ui.Tab
	Range   string
	Charts  []ui.ChartProps
	// ServerHref is where sampling is switched on, for a resource's page.
	ServerHref string
	// Switch is where the switch itself posts to, on the server's own
	// page, and Admin whether the reader may use it.
	Switch string
	Admin  bool
	CSRF   string
}

// historyCard is what was used over time, and on a server's own page the
// switch that makes musdash keep it: one card for the two, since the
// charts are what the switch fills.
templ historyCard(h History) {
	<section class="card" id="history">
		// The stretches of time go under the title where they do not fit
		// beside it.
		<div class="card-head flex-wrap">
			<div>
				<h2 class="card-title">Over time</h2>
				<p class="muted text-sm">One sample a minute, kept for a day.</p>
			</div>
			if h.Sampled {
				<nav class="flex gap-1" aria-label="Stretch of time">
					for _, t := range h.Ranges {
						<a
							class={ "btn btn-sm", templ.KV("btn-secondary", t.Key == h.Range), templ.KV("btn-ghost", t.Key != h.Range) }
							href={ templ.SafeURL(t.Href) }
							if t.Key == h.Range {
								aria-current="true"
							}
						>{ t.Label }</a>
					}
				</nav>
			}
		</div>
		if !h.Sampled && h.Switch == "" {
			@ui.EmptyState(ui.EmptyProps{Icon: "chart", Title: "Sampling is switched off", Text: "Nothing is kept for this server, which is how it starts.", Size: ui.EmptySmall}) {
				@ui.LinkButton(h.ServerHref, ui.ButtonProps{Variant: ui.Primary, Small: true}) {
					Open the server's usage
				}
			}
		} else if !h.Sampled && h.Admin {
			@ui.EmptyState(ui.EmptyProps{Icon: "chart", Title: "Sampling is switched off", Text: "Nothing is kept for this server, which is how it starts. Switched on, it is asked once a minute what it and its containers use, and the answers are kept for a day.", Size: ui.EmptySmall}) {
				<form method="post" action={ templ.SafeURL(h.Switch) }>
					@ui.CSRF(h.CSRF)
					<input type="hidden" name="sample" value="1"/>
					@ui.Button(ui.ButtonProps{Variant: ui.Primary, Small: true, Type: "submit"}) {
						Switch sampling on
					}
				</form>
			}
		} else if !h.Sampled {
			@ui.EmptyState(ui.EmptyProps{Icon: "chart", Title: "Sampling is switched off", Text: "Nothing is kept for this server, which is how it starts. An Admin or an Owner switches sampling on and off.", Size: ui.EmptySmall})
		} else {
			<div class="card-body grid gap-x-8 gap-y-8 lg:grid-cols-2">
				for _, c := range h.Charts {
					@ui.Chart(c)
				}
			</div>
			if h.Switch != "" {
				<div class="card-foot">
					if h.Admin {
						<p class="muted mr-auto text-sm">Sampling is on: this server is asked once a minute what it and its containers use.</p>
						<form method="post" action={ templ.SafeURL(h.Switch) }>
							@ui.CSRF(h.CSRF)
							<input type="hidden" name="sample" value="0"/>
							@ui.Button(ui.ButtonProps{Small: true, Type: "submit", Attrs: ui.Ask("Switch sampling off?", "This server is no longer asked what it uses, and the samples that were kept are removed. The charts of everything that runs on it start empty when sampling is switched on again.", "Switch sampling off", true)}) {
								Switch sampling off
							}
						</form>
					} else {
						<p class="muted mr-auto text-sm">Sampling is on. An Admin or an Owner switches sampling on and off.</p>
					}
				</div>
			}
		}
	</section>
}

templ AppMetrics(s ui.Shell, v AppView, h History) {
	@appFrame(s, v, "metrics") {
		if v.App.Container == "" {
			@ui.EmptyState(ui.EmptyProps{Icon: "chart", Title: "Nothing is running", Text: "What the app uses appears here once it is deployed.", Link: "See its deployments", LinkHref: v.Path() + "/deployments"})
		} else {
			<div class="grid max-w-5xl gap-6">
				@UsagePending(v.Path()+"/metrics/now", ResourceFigures)
				@historyCard(h)
			</div>
		}
	}
}

templ DatabaseMetrics(s ui.Shell, v DatabaseView, h History) {
	@databaseFrame(s, v, "metrics") {
		if v.DB.Container == "" {
			@ui.EmptyState(ui.EmptyProps{Icon: "chart", Title: "Nothing is running", Text: "What the database uses appears here once it is started."})
		} else {
			<div class="grid max-w-5xl gap-6">
				@UsagePending(v.Path()+"/metrics/now", ResourceFigures)
				@historyCard(h)
			</div>
		}
	}
}

templ ServiceMetrics(s ui.Shell, v ServiceView, h History) {
	@serviceFrame(s, v, "metrics") {
		if v.Service.Members == "" || v.Service.Status == db.AppStopped {
			@ui.EmptyState(ui.EmptyProps{Icon: "chart", Title: "Nothing is running", Text: "What the service uses appears here once it is deployed."})
		} else {
			<div class="grid max-w-5xl gap-6">
				@UsagePending(v.Path()+"/metrics/now", ResourceFigures)
				@historyCard(h)
			</div>
		}
	}
}

// ServerMetrics is a server's usage page, the second of its two tabs.
templ ServerMetrics(s ui.Shell, server db.Server, h History) {
	@serverFrame(s, server, "usage") {
		<div class="grid max-w-5xl gap-6">
			@UsagePending("/servers/"+server.ID+"/metrics/now", ServerFigures)
			@historyCard(h)
		</div>
	}
}
