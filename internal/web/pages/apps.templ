package pages

import (
	"strconv"
	"strings"

	"github.com/MahmoudDahdouh/musdash-go/internal/db"
	"github.com/MahmoudDahdouh/musdash-go/internal/deploy"
	"github.com/MahmoudDahdouh/musdash-go/internal/source"
	"github.com/MahmoudDahdouh/musdash-go/internal/web/ui"
)

// AppView is what every app page needs for its frame.
type AppView struct {
	App     db.App
	Project db.Project
	Env     db.Environment
	Domains []db.Domain
	// Servers are the team's servers, filled in for the Settings page.
	Servers []db.Server
	// Parent is the app a preview belongs to; nil for an ordinary app.
	Parent *db.App
	// Previews are the app's previews, filled in for the Settings page.
	Previews []PreviewRow
	// Tags are the app's tags and TeamTags all of the team's, filled in for
	// the Settings page.
	Tags     []string
	TeamTags []string
}

// PreviewRow is one preview in its parent's list.
type PreviewRow struct {
	App db.App
	URL string // "" when the preview has no address
}

// buildServerOptions offers the app's own server first, then the others.
func buildServerOptions(v AppView) []ui.Option {
	opts := []ui.Option{{Value: "", Label: "The server the app runs on"}}
	for _, s := range v.Servers {
		if s.ID != v.App.ServerID {
			opts = append(opts, ui.Option{Value: s.ID, Label: s.Name})
		}
	}
	return opts
}


// URL is the address a domain is reached at.
func domainURL(d db.Domain) string {
	if d.TLS {
		return "https://" + d.Host + d.Path
	}
	return "http://" + d.Host + d.Path
}

func appTabs(v AppView) []ui.Tab {
	b := v.Path()
	tabs := []ui.Tab{
		{Key: "overview", Label: "Overview", Href: b, Icon: "dashboard"},
		{Key: "deployments", Label: "Deployments", Href: b + "/deployments", Icon: "rocket"},
		{Key: "logs", Label: "Logs", Href: b + "/logs", Icon: "file"},
		{Key: "metrics", Label: "Metrics", Href: b + "/metrics", Icon: "chart"},
		{Key: "terminal", Label: "Terminal", Href: b + "/terminal", Icon: "terminal"},
	}
	// A preview has no variables, domains, storage or tasks of its own.
	if !v.App.IsPreview() {
		tabs = append(tabs,
			ui.Tab{Key: "environment", Label: "Environment", Href: b + "/environment", Icon: "variable"},
			ui.Tab{Key: "domains", Label: "Domains", Href: b + "/domains", Icon: "globe"},
			ui.Tab{Key: "storage", Label: "Storage", Href: b + "/storage", Icon: "drive"},
			ui.Tab{Key: "tasks", Label: "Tasks", Href: b + "/tasks", Icon: "clock"},
		)
	}
	return append(tabs, ui.Tab{Key: "settings", Label: "Settings", Href: b + "/settings", Icon: "settings"})
}

// appSourceLine says in one line where an app's image comes from.
func appSourceLine(app db.App) string {
	if app.Source == db.SourceGit {
		return app.RepoName + " @ " + app.Branch
	}
	return app.Image
}

func headerPoll(app db.App) string {
	// Fast while a deployment is running, slow otherwise: the header only
	// changes on its own when a container starts, stops or is replaced.
	if app.Status == db.AppDeploying {
		return "every 2s"
	}
	return "every 15s"
}

// AppHeader is the app's name, status and actions. It refreshes itself, so
// the page follows a deployment (and offers Stop and Redeploy once it is
// running) without a reload.
templ AppHeader(csrf, base string, app db.App) {
	<header
		id="app-header"
		class="mb-5 flex flex-wrap items-start justify-between gap-x-6 gap-y-3"
		hx-get={ base + "/status" }
		hx-trigger={ headerPoll(app) }
		hx-swap="outerHTML"
	>
		<div class="min-w-0">
			<div class="flex flex-wrap items-center gap-x-3 gap-y-1">
				<h1 class="text-xl font-semibold tracking-tight">{ app.Name }</h1>
				@ui.StatusPill(app.Status)
			</div>
			<p class="fact mt-0.5 truncate text-ink-mute">{ appSourceLine(app) }</p>
		</div>
		<div class="flex flex-wrap items-center gap-2">
			if app.Container != "" {
				<form method="post" action={ templ.SafeURL(base + "/stop") }>
					@ui.CSRF(csrf)
					@ui.Button(ui.ButtonProps{Type: "submit", Icon: "stop", Attrs: ui.Ask("Stop "+app.Name+"?", "The app stops answering until it is deployed again. Its settings, variables and storage are kept.", "Stop app", false)}) {
						Stop
					}
				</form>
			}
			<form method="post" action={ templ.SafeURL(base + "/deploy") }>
				@ui.CSRF(csrf)
				@ui.Button(ui.ButtonProps{Variant: ui.Primary, Type: "submit", Icon: "deploy"}) {
					if app.Container != "" {
						Redeploy
					} else {
						Deploy
					}
				}
			</form>
		</div>
	</header>
}

// appFrame is the header and tabs shared by every app page.
templ appFrame(s ui.Shell, v AppView, tab string) {
	@ui.Layout(s) {
		@AppHeader(s.CSRF, v.Path(), v.App)
		if v.Parent != nil {
			<p class="muted mb-4 text-sm">
				The preview of pull request #{ strconv.Itoa(v.App.PRNumber) } of
				<a class="link" href={ templ.SafeURL(v.Beside(v.Parent.ID)) }>{ v.Parent.Name }</a>.
				It runs with that app's variables and files, and is removed when the pull request is closed.
			</p>
		}
		@ui.Tabs(appTabs(v), tab)
		{ children... }
	}
}

// AccessOption is one way to reach a repository in the Git forms.
type AccessOption struct {
	Value string // "public", "source:<id>" or "key:<id>"
	Label string
}

// GitChoices is what the Git forms offer for reaching a repository.
type GitChoices struct {
	Access  []AccessOption
	Sources []db.GitSource
}

func accessOptions(c GitChoices) []ui.Option {
	opts := make([]ui.Option, 0, len(c.Access))
	for _, a := range c.Access {
		opts = append(opts, ui.Option{Value: a.Value, Label: a.Label})
	}
	return opts
}

var buildPackOptions = []ui.Option{
	{Value: "dockerfile", Label: "Dockerfile"},
	{Value: "static", Label: "Static site"},
	{Value: "nixpacks", Label: "Nixpacks (no Dockerfile needed)"},
	{Value: "railpack", Label: "Railpack (no Dockerfile needed)"},
}

// currentAccess is the way into the repository a Git form shows as chosen:
// what was sent, else what is stored, else the first there is.
func currentAccess(f ui.Form, c GitChoices, app db.App) string {
	want := orDefault(f.V("access"), appAccess(app))
	for _, a := range c.Access {
		if a.Value == want {
			return want
		}
	}
	if len(c.Access) > 0 {
		return c.Access[0].Value
	}
	return want
}

// typedAccess lists the ways in that have no list to choose from, so the
// repository and the branch are typed: a public repository, a deploy key.
func typedAccess(c GitChoices) string {
	var typed []string
	for _, a := range c.Access {
		if !strings.HasPrefix(a.Value, "source:") {
			typed = append(typed, a.Value)
		}
	}
	return strings.Join(typed, " ")
}

// repoShown is what a repository picker's button says of an address: the
// repository's name under its owner.
func repoShown(address string) string {
	repo, err := source.ParseRepo(address)
	if err != nil {
		return address
	}
	return repo.FullName()
}

func repoHint(g db.GitSource) string {
	if g.Kind == db.GitSourceGitLab {
		return "The projects the token is a member of. Another one it can read is named by typing its path, such as group/shop."
	}
	return "The repositories the App is installed on. For one that is missing, use Choose repositories on the Sources page."
}

// buildPack is the build a Git form shows as chosen.
func buildPack(f ui.Form, app db.App) string {
	return orDefault(f.V("build_pack"), orDefault(app.BuildPack, "dockerfile"))
}

// gitSourceFields are the fields describing a repository and how to build
// it, as the app's Source settings have them.
templ gitSourceFields(f ui.Form, c GitChoices, app db.App) {
	@gitWhereFields(f, c, app)
	@gitBuildFields(f, c, app)
}

// gitWhereFields say where the code is: the repository, the branch and the
// folder. When one of them changes, the folder is looked at and the line
// under Build with says what was found (BuildDetected). The request waits a
// moment after the change: the fields of the way in that was just chosen
// are enabled by then, and the others, which are not sent, disabled. The
// pickers inside ask their own questions and inherit nothing of this one.
templ gitWhereFields(f ui.Form, c GitChoices, app db.App) {
	<div
		id="git-where"
		class="grid gap-4"
		hx-get="/sources/detect"
		hx-trigger="change delay:150ms"
		hx-include="#git-where"
		hx-target="#build-detected"
		hx-swap="innerHTML"
		hx-sync="this:replace"
		hx-indicator="#build-found"
		hx-disinherit="*"
	>
		@gitRepoFields(f, c, app)
		@ui.TextField(f, "Base directory", "The folder inside the repository to build from. Empty for the repository root.", ui.InputProps{ID: "base_dir", Mono: true, Value: app.BaseDir, Placeholder: "apps/web"})
	</div>
}

// gitRepoFields say which repository and branch to read, and how. Apps
// and services deployed from Git share them; app carries the stored values.
//
// Each way in has the two fields in a fieldset of its own: a source's are
// pickers, since the source can be asked what there is, and the rest type
// them. Only the fieldset of the way in that is chosen is shown and enabled
// (data-when), so one repository and one branch are sent.
templ gitRepoFields(f ui.Form, c GitChoices, app db.App) {
	@ui.Field(ui.FieldProps{Label: "Read the repository through", For: "access", Hint: "Private repositories need a GitHub App, a GitLab token or, on any host (Bitbucket, Gitea), a deploy key. GitHub and GitLab are connected under Sources, a key is added under Keys & tokens.", Error: f.E("access")}) {
		@ui.Select("access", accessOptions(c), currentAccess(f, c, app), templ.Attributes{"aria-describedby": "access-hint"})
	}
	for _, g := range c.Sources {
		@sourceRepoFields(f, g, app, currentAccess(f, c, app) == "source:"+g.ID)
	}
	<fieldset class="grid min-w-0 gap-4" data-when="access" data-is={ typedAccess(c) } hidden?={ strings.HasPrefix(currentAccess(f, c, app), "source:") } disabled?={ strings.HasPrefix(currentAccess(f, c, app), "source:") }>
		@ui.TextField(f, "Repository", "For example https://github.com/acme/shop or https://gitlab.com/group/shop, or with a deploy key git@github.com:acme/shop.git.", ui.InputProps{ID: "repo", Mono: true, Required: true, Value: app.RepoURL, Placeholder: "https://github.com/acme/shop"})
		@ui.TextField(f, "Branch", "", ui.InputProps{ID: "branch", Mono: true, Required: true, Value: orDefault(app.Branch, defaultBranch)})
	</fieldset>
}

// sourceRepoFields are the repository and the branch of one source, each a
// picker. chosen says whether this is the way in the form shows: only then
// does it hold what was sent or is stored, and the form's errors.
templ sourceRepoFields(f ui.Form, g db.GitSource, app db.App, chosen bool) {
	<fieldset class="grid min-w-0 gap-4" data-when="access" data-is={ "source:" + g.ID } hidden?={ !chosen } disabled?={ !chosen }>
		@ui.Field(ui.FieldProps{Label: "Repository", For: repoPickerID(g.ID), Hint: repoHint(g), Error: ifChosen(chosen, f.E("repo"))}) {
			@ui.Picker(ui.PickerProps{
				ID:          repoPickerID(g.ID),
				Name:        "repo",
				Value:       ifChosen(chosen, orDefault(f.V("repo"), app.RepoURL)),
				Shown:       ifChosen(chosen, repoShown(orDefault(f.V("repo"), app.RepoURL))),
				Placeholder: "Choose a repository",
				Icon:        sourceIcon(g),
				Filter:      "Find a repository",
				Src:         reposPath(g),
				Attrs:       templ.Attributes{"aria-describedby": repoPickerID(g.ID) + "-hint"},
			})
		}
		@ui.Field(ui.FieldProps{Label: "Branch", For: branchPickerID(g.ID), Error: ifChosen(chosen, f.E("branch"))}) {
			@ui.Picker(ui.PickerProps{
				ID:      branchPickerID(g.ID),
				Name:    "branch",
				Value:   orDefault(ifChosen(chosen, orDefault(f.V("branch"), app.Branch)), defaultBranch),
				Icon:    "git-branch",
				Filter:  "Find a branch",
				Src:     branchesPath(g),
				Include: "#" + repoPickerID(g.ID) + "-value",
			})
		}
	</fieldset>
}

func ifChosen(chosen bool, v string) string {
	if chosen {
		return v
	}
	return ""
}

// gitBuildFields say how the code is built. The fields that belong to one
// build are shown for that build only (data-when); they are optional, and
// are sent whether shown or not.
templ gitBuildFields(f ui.Form, c GitChoices, app db.App) {
	@ui.Field(ui.FieldProps{Label: "Build with", For: "build_pack", Hint: "Worked out from the repository where it can be read through a source. Nixpacks and Railpack need no Dockerfile; the app they build must listen on its port, which it is told as PORT.", Error: f.E("build_pack")}) {
		@ui.Select("build_pack", buildPackOptions, buildPack(f, app), templ.Attributes{"aria-describedby": "build_pack-hint"})
		<div id="build-found">
			<p class="found-line busy-line">
				@ui.Icon("refresh", "animate-spin text-ink-mute")
				<span>Looking at the repository…</span>
			</p>
			<div id="build-detected" aria-live="polite"></div>
		</div>
	}
	<div class="grid gap-4" data-when="build_pack" data-is="dockerfile" hidden?={ buildPack(f, app) != "dockerfile" }>
		@ui.TextField(f, "Dockerfile", "Where the Dockerfile is, from the base directory.", ui.InputProps{ID: "dockerfile_path", Mono: true, Value: app.DockerfilePath, Placeholder: "Dockerfile"})
	</div>
	<div class="grid gap-4" data-when="build_pack" data-is="static" hidden?={ buildPack(f, app) != "static" }>
		@ui.TextField(f, "Folder to serve", "The folder of ready-made files, from the base directory. Empty for the base directory itself.", ui.InputProps{ID: "publish_dir", Mono: true, Value: app.PublishDir, Placeholder: "dist"})
		@ui.Checkbox("spa_fallback", checked(f, "spa_fallback", app.SPAFallback), nil) {
			Answer unknown paths with index.html (for single-page apps)
		}
	</div>
	@ui.Checkbox("auto_deploy", checked(f, "auto_deploy", app.AutoDeploy), nil) {
		Deploy automatically when the branch is pushed
	}
}

// checked decides a checkbox's state: what was submitted, or the stored
// value when the form has not been submitted.
func checked(f ui.Form, key string, stored bool) bool {
	if _, submitted := f.Values["_submitted"]; submitted {
		return f.V(key) == "1"
	}
	return stored
}

// appAccess is the form value for how an app reaches its repository.
func appAccess(app db.App) string {
	switch {
	case app.GitSourceID != "":
		return "source:" + app.GitSourceID
	case app.SSHKeyID != "":
		return "key:" + app.SSHKeyID
	}
	return "public"
}

// AppNew is the form a new app is made with. From Git it is three groups,
// the repository first: the build and the name follow from it.
templ AppNew(s ui.Shell, p db.Project, env db.Environment, f ui.Form, suggestedDomain, source string, choices GitChoices, serverList []db.Server) {
	@ui.Layout(s) {
		if source == db.SourceGit {
			@ui.PageHeader("New app from a Git repository", "Runs in "+env.Name+".")
		} else {
			@ui.PageHeader("New app from a Docker image", "Runs in "+env.Name+".")
		}
		<div class="max-w-xl">
			<form class="card card-groups" method="post" action={ templ.SafeURL(EnvPath(p.ID, env.ID) + "/app") }>
				@ui.CSRF(s.CSRF)
				<input type="hidden" name="source" value={ source }/>
				if source == db.SourceGit {
					<div class="card-body grid gap-4">
						<h2 class="card-title">Repository</h2>
						@gitWhereFields(f, choices, db.App{AutoDeploy: true})
					</div>
					<div class="card-body grid gap-4">
						<h2 class="card-title">Build</h2>
						@gitBuildFields(f, choices, db.App{AutoDeploy: true})
					</div>
				}
				<div class="card-body grid gap-4">
					if source == db.SourceGit {
						<h2 class="card-title">App</h2>
					}
					@ui.TextField(f, "Name", "Lowercase letters, numbers and hyphens. Other containers in this environment reach the app by this name.", ui.InputProps{ID: "name", Mono: true, Required: true, Autofocus: source != db.SourceGit, Placeholder: "web", Attrs: templ.Attributes{"maxlength": "32", "data-suggest-here": source == db.SourceGit}})
					if source != db.SourceGit {
						@ui.TextField(f, "Docker image", "For example nginx:alpine or ghcr.io/you/app:1.4.", ui.InputProps{ID: "image", Mono: true, Required: true, Placeholder: "nginx:alpine"})
					}
					@ui.TextField(f, "Port", "The port the app listens on inside its container. A static site listens on 80.", ui.InputProps{ID: "port", Mono: true, Required: true, Value: "80", Attrs: templ.Attributes{"inputmode": "numeric"}})
					@ServerChoice(f, serverList)
					@ui.TextField(f, "Domain", "Leave the generated address, or enter a domain that points at the app's server. Your own domains get HTTPS.", ui.InputProps{ID: "domain", Mono: true, Value: suggestedDomain})
					@ui.Checkbox("deploy", true, nil) {
						Deploy as soon as the app is created
					}
				</div>
				<div class="card-foot">
					@ui.LinkButton(EnvPath(p.ID, env.ID)+"/new", ui.ButtonProps{}) {
						Back
					}
					@ui.Button(ui.ButtonProps{Variant: ui.Primary, Type: "submit"}) {
						Create app
					}
				</div>
			</form>
		</div>
	}
}

// lastCommit is the commit of the latest deployment, shortened, or "none"
// for image deployments.
func lastCommit(d *db.Deployment) string {
	if d == nil || len(d.CommitSHA) < 12 {
		return "none"
	}
	return d.CommitSHA[:12]
}

func internalAddress(a db.App) string {
	return a.Name + ":" + strconv.Itoa(a.Port)
}

func hostPort(a db.App) string {
	if a.HostPort == 0 {
		return "none"
	}
	return "127.0.0.1:" + strconv.Itoa(a.HostPort)
}

func orNone(v string) string {
	if v == "" {
		return "none"
	}
	return v
}

templ AppOverview(s ui.Shell, v AppView, server db.Server, last *db.Deployment) {
	@appFrame(s, v, "overview") {
		<div class="grid gap-6 lg:grid-cols-2">
			<section class="card">
				<div class="card-head">
					<h2 class="card-title">Domains</h2>
					if !v.App.IsPreview() && len(v.Domains) > 0 {
						@ui.LinkButton(v.Path()+"/domains", ui.ButtonProps{Variant: ui.Ghost, Small: true}) {
							Manage
						}
					}
				</div>
				if len(v.Domains) == 0 && v.App.IsPreview() {
					@ui.EmptyState(ui.EmptyProps{Icon: "globe", Title: "No address", Text: "This preview could not be given one: the address it would have may be taken.", Size: ui.EmptySmall})
				} else if len(v.Domains) == 0 {
					@ui.EmptyState(ui.EmptyProps{Icon: "globe", Title: "No domain yet", Text: "Add one to reach the app from outside.", Size: ui.EmptySmall}) {
						@ui.LinkButton(v.Path()+"/domains", ui.ButtonProps{Variant: ui.Primary, Small: true, Icon: "plus"}) {
							Add domain
						}
					}
				} else {
					<div class="rows">
						for _, d := range v.Domains {
							<a class="row" href={ templ.SafeURL(domainURL(d)) } target="_blank" rel="noopener">
								@ui.Icon("globe", "text-ink-mute")
								<span class="fact min-w-0 flex-1 truncate">{ d.Host + d.Path }</span>
								if d.AuthUser != "" {
									@ui.Badge("Password", ui.ToneNeutral)
								}
								if d.TLS {
									@ui.Badge("HTTPS", ui.ToneOK)
								} else {
									@ui.Badge("HTTP", ui.ToneNeutral)
								}
								@ui.Icon("external", "text-ink-mute")
							</a>
						}
					</div>
				}
			</section>
			<section class="card">
				<div class="card-head">
					<h2 class="card-title">Running now</h2>
				</div>
				<div class="card-body">
					@ui.KeyValue([]ui.KVItem{
						{Key: "Image", Value: orNone(v.App.DeployedImage), Mono: true},
						{Key: "Commit", Value: lastCommit(last), Mono: true},
						{Key: "Server", Value: server.Name},
						{Key: "Inside the environment", Value: internalAddress(v.App), Mono: true},
						{Key: "On the server", Value: hostPort(v.App), Mono: true},
						{Key: "Container", Value: orNone(v.App.Container), Mono: true},
					})
				</div>
			</section>
			<section class="card lg:col-span-2">
				<div class="card-head">
					<h2 class="card-title">Latest deployment</h2>
					@ui.LinkButton(v.Path()+"/deployments", ui.ButtonProps{Variant: ui.Ghost, Small: true}) {
						All deployments
					}
				</div>
				if last == nil {
					@ui.EmptyState(ui.EmptyProps{Icon: "rocket", Title: "Not deployed yet", Text: "Choose Deploy to start the app.", Size: ui.EmptySmall})
				} else {
					<a class="row rail" data-state={ last.Status } href={ templ.SafeURL(v.Path() + "/deployments/" + last.ID) }>
						<div class="min-w-0 flex-1">
							<p class="fact truncate">{ orDefault(last.Image, "building") }</p>
							<p class="muted text-sm">{ ui.Ago(last.CreatedAt) }</p>
							if last.Error != "" {
								<p class="mt-1 text-sm text-danger">{ last.Error }</p>
							}
						</div>
						@ui.JobPill(last.Status)
						@ui.Icon("chevron-right", "text-ink-mute")
					</a>
				}
			</section>
		</div>
	}
}

templ AppDeployments(s ui.Shell, v AppView, list []db.Deployment) {
	@appFrame(s, v, "deployments") {
		if len(list) == 0 {
			@ui.EmptyState(ui.EmptyProps{Icon: "rocket", Title: "No deployments yet", Text: "Choose Deploy to start the app. Each deployment is listed here with its log."})
		} else {
			<section class="card">
				@ui.Table("Started", "Image", "Trigger", "Status", "Took", "") {
					for _, d := range list {
						<tr>
							<td class="whitespace-nowrap">{ ui.Ago(d.CreatedAt) }</td>
							<td class="fact">{ orDefault(d.Image, "building") }</td>
							<td>{ ui.StateLabel(d.Trigger) }</td>
							<td>
								<span class="flex flex-wrap items-center gap-2">
									@ui.JobPill(d.Status)
									if v.serving(d) {
										@ui.Badge("Serving", ui.ToneOK)
									}
								</span>
							</td>
							<td class="fact">{ ui.Took(d.StartedAt, d.FinishedAt) }</td>
							<td class="text-right">
								@ui.LinkButton(v.Path()+"/deployments/"+d.ID, ui.ButtonProps{Variant: ui.Ghost, Small: true}) {
									View log
								}
							</td>
						</tr>
					}
				}
			</section>
		}
	}
}

func deploymentDone(d db.Deployment) bool {
	return d.Status == db.DeploySuccess || d.Status == db.DeployFailed
}

// serving reports whether a deployment's container is the one answering
// for the app now.
func (v AppView) serving(d db.Deployment) bool {
	return v.App.Container != "" && strings.HasSuffix(v.App.Container, "-"+d.ID)
}

// canRollBack reports whether a deployment's image can be run again: it
// succeeded, its image was kept, and it is not what is running already.
func (v AppView) canRollBack(d db.Deployment) bool {
	return d.Status == db.DeploySuccess && d.KeptImage != "" && !v.serving(d) && v.App.DeployedImage != d.KeptImage
}

// DeploymentStatus is the status line above a deployment's log. While the
// deployment runs it refreshes itself; once finished it stops.
templ DeploymentStatus(base string, d db.Deployment) {
	<div
		id="deployment-status"
		class="flex flex-wrap items-center gap-x-3 gap-y-1"
		if !deploymentDone(d) {
			hx-get={ base + "/deployments/" + d.ID + "/status" }
			hx-trigger="every 2s"
			hx-swap="outerHTML"
		}
	>
		@ui.JobPill(d.Status)
		<span class="fact">{ orDefault(d.Image, "building from "+ui.StateLabel(d.Trigger)) }</span>
		<span class="muted text-sm">{ ui.Ago(d.CreatedAt) }</span>
		if took := ui.Took(d.StartedAt, d.FinishedAt); took != "" {
			<span class="muted text-sm">took { took }</span>
		}
	</div>
}

templ AppDeployment(s ui.Shell, v AppView, d db.Deployment) {
	@appFrame(s, v, "deployments") {
		<div class="grid gap-4">
			@DeploymentStatus(v.Path(), d)
			if d.Error != "" {
				@ui.Notice(ui.ToneDanger) {
					{ d.Error }
				}
			}
			if d.RollbackOf != "" {
				<p class="muted text-sm">
					A rollback: it runs the image of
					<a class="link" href={ templ.SafeURL(v.Path() + "/deployments/" + d.RollbackOf) }>an earlier deployment</a>
					again.
				</p>
			}
			if v.canRollBack(d) {
				<section class="card">
					<div class="card-head">
						<div>
							<h2 class="card-title">Roll back to this deployment</h2>
							<p class="muted text-sm">Runs this deployment's image again, as it was kept on the server. Nothing is built or pulled. The app's settings and variables stay as they are today; only the image goes back.</p>
						</div>
						<form method="post" action={ templ.SafeURL(v.Path() + "/deployments/" + d.ID + "/rollback") }>
							@ui.CSRF(s.CSRF)
							@ui.Button(ui.ButtonProps{Type: "submit", Variant: ui.Secondary, Icon: "refresh", Attrs: ui.Ask("Roll back "+v.App.Name+"?", "The image of this deployment runs again in place of the one serving now. Nothing is built or pulled, and settings and variables stay as they are today.", "Roll back", false)}) {
								Roll back
							}
						</form>
					</div>
				</section>
			}
			@ui.LogView("deploy-log", templ.Attributes{
				"hx-ext":      "sse",
				"sse-connect": v.Path() + "/deployments/" + d.ID + "/stream",
				"sse-swap":    "line",
				"sse-close":   "done",
				"hx-swap":     "beforeend",
			})
		</div>
	}
}

templ AppLogs(s ui.Shell, v AppView) {
	@appFrame(s, v, "logs") {
		if v.App.Container == "" {
			@ui.EmptyState(ui.EmptyProps{Icon: "file", Title: "Nothing is running", Text: "The app's output appears here once it is deployed.", Link: "See its deployments", LinkHref: v.Path() + "/deployments"})
		} else {
			<div class="grid gap-2">
				<p class="muted text-sm">The last 200 lines, then new output as it arrives.</p>
				@ui.LogView("runtime-log", templ.Attributes{
					"hx-ext":      "sse",
					"sse-connect": v.Path() + "/logs/stream",
					"sse-swap":    "line",
					"sse-close":   "done",
					"hx-swap":     "beforeend",
				})
			</div>
		}
	}
}

func storageKindLabel(kind string) string {
	switch kind {
	case db.StorageVolume:
		return "Volume"
	case db.StorageBind:
		return "Server folder"
	case db.StorageFile:
		return "File"
	}
	return kind
}

func storageSource(st db.Storage) string {
	if st.Kind == db.StorageFile {
		return "written by musdash"
	}
	return st.Source
}

templ AppStorage(s ui.Shell, v AppView, list []db.Storage, f ui.Form) {
	@appFrame(s, v, "storage") {
		<div class="grid max-w-3xl gap-6">
			<section class="card">
				<div class="card-head">
					<div>
						<h2 class="card-title">Storage</h2>
						<p class="muted text-sm">Data that survives a redeploy. Changes apply on the next deploy.</p>
					</div>
					if len(list) > 0 {
						@ui.Button(ui.ButtonProps{Small: true, Icon: "plus", Opens: "add-storage"}) {
							Add storage
						}
					}
				</div>
				if len(list) == 0 {
					@ui.EmptyState(ui.EmptyProps{Icon: "drive", Title: "Nothing is mounted", Text: "Without storage, files the app writes are lost when it is redeployed.", Size: ui.EmptySmall}) {
						@ui.Button(ui.ButtonProps{Variant: ui.Primary, Small: true, Icon: "plus", Opens: "add-storage"}) {
							Add storage
						}
					}
				} else {
					@ui.Table("Type", "Source", "Path in the container", "") {
						for _, st := range list {
							<tr>
								<td>
									@ui.Badge(storageKindLabel(st.Kind), ui.ToneNeutral)
								</td>
								<td class="fact">{ storageSource(st) }</td>
								<td class="fact">{ st.Target }</td>
								<td class="text-right">
									<form method="post" action={ templ.SafeURL(v.Path() + "/storage/" + st.ID + "/delete") }>
										@ui.CSRF(s.CSRF)
										@ui.Button(ui.ButtonProps{Variant: ui.DangerQuiet, Small: true, Type: "submit", Attrs: ui.Ask("Remove this storage?", st.Target+" is no longer mounted from the next deploy on. A volume and a server folder keep their data; a file's content is deleted.", "Remove storage", true)}) {
											Remove
										}
									</form>
								</td>
							</tr>
						}
					}
				}
			</section>
			@ui.FormDialog(ui.DialogProps{ID: "add-storage", Title: "Add storage", Description: "It is mounted from the next deploy on.", Action: v.Path() + "/storage", CSRF: s.CSRF, Submit: "Add storage", Wide: true, Open: !f.OK()}) {
				@ui.Field(ui.FieldProps{Label: "Type", For: "kind", Hint: "A volume is managed by Docker. A server folder is a directory you choose on the server. A file is one file whose content you enter here.", Error: f.E("kind")}) {
					@ui.Select("kind", []ui.Option{{Value: db.StorageVolume, Label: "Volume"}, {Value: db.StorageBind, Label: "Server folder"}, {Value: db.StorageFile, Label: "File"}}, orDefault(f.V("kind"), db.StorageVolume), templ.Attributes{"aria-describedby": "kind-hint"})
				}
				@ui.TextField(f, "Volume name or server folder", "A name such as data for a volume, or a path such as /srv/uploads for a server folder. Leave empty for a file.", ui.InputProps{ID: "source", Mono: true})
				@ui.TextField(f, "Path in the container", "Where the app sees it, for example /var/lib/app/data.", ui.InputProps{ID: "target", Mono: true, Required: true})
				@ui.Field(ui.FieldProps{Label: "File content", For: "file-content", Hint: "Only for the File type. Stored encrypted.", Error: f.E("content")}) {
					@ui.Textarea(ui.InputProps{ID: "file-content", Name: "content", Mono: true, Rows: 6, Value: f.V("content"), Invalid: f.E("content") != "", Described: true})
				}
			}
		</div>
	}
}

func orDefault(v, def string) string {
	if v == "" {
		return def
	}
	return v
}

func zeroBlank(n int) string {
	if n == 0 {
		return ""
	}
	return strconv.Itoa(n)
}

func cpusValue(c float64) string {
	if c == 0 {
		return ""
	}
	return strconv.FormatFloat(c, 'f', -1, 64)
}

// webhookHosts says where each Git host wants the address and the secret,
// and what it calls the events.
var webhookHosts = []ui.KVItem{
	{Key: "GitHub, Gitea, Forgejo", Value: "Settings → Webhooks. Content type application/json, the secret as Secret, the push event (and pull requests)."},
	{Key: "GitLab", Value: "Settings → Webhooks. The secret as Secret token, with Push events (and Merge request events). A signing token is GitLab's own and cannot be used here."},
	{Key: "Bitbucket", Value: "Repository settings → Webhooks. The secret as Secret, with Repository push (and Pull request created, updated, merged and declined)."},
}

// PreviewSettings is the Settings page of a preview: it has nothing of its
// own to set.
templ PreviewSettings(s ui.Shell, v AppView) {
	@appFrame(s, v, "settings") {
		<div class="grid max-w-3xl gap-6">
			<section class="card">
				<div class="card-head">
					<div>
						<h2 class="card-title">Settings</h2>
						<p class="muted text-sm">A preview is built and run with the settings, variables and files of the app it previews. Change them there; they apply to the preview when it is next deployed.</p>
					</div>
				</div>
			</section>
			<section class="card card-danger">
				<div class="card-head">
					<div>
						<h2 class="card-title">Remove preview</h2>
						<p class="muted text-sm">Stops the preview and removes it. A new push to the pull request makes it again.</p>
					</div>
				</div>
				<form class="card-body grid gap-4" method="post" action={ templ.SafeURL(v.Path() + "/delete") }>
					@ui.CSRF(s.CSRF)
					<input type="hidden" name="confirm" value={ v.App.Name }/>
					<div>
						@ui.Button(ui.ButtonProps{Type: "submit", Variant: ui.DangerQuiet, Icon: "trash", Attrs: ui.Ask("Remove this preview?", "The preview is stopped and removed with its address. A new push to the pull request makes it again.", "Remove preview", true)}) {
							Remove preview
						}
					</div>
				</form>
			</section>
		</div>
	}
}

// previewsCard is where an app's pull requests get their previews.
templ previewsCard(csrf string, v AppView, f ui.Form) {
	<section class="card" id="previews">
		<div class="card-head">
			<div>
				<h2 class="card-title">Pull request previews</h2>
				<p class="muted text-sm">Each pull request into { v.App.Branch } gets a deployment and an address of its own, updated on every push and removed when the pull request is closed.</p>
			</div>
			@ui.Button(ui.ButtonProps{Small: true, Icon: "pencil", Opens: "edit-previews"}) {
				Change
			}
		</div>
		<div class={ "card-body", templ.KV("border-b border-line", len(v.Previews) > 0 || v.App.Previews) }>
			@ui.KeyValue([]ui.KVItem{{Key: "Previews", Value: onOff(v.App.Previews)}, {Key: "Domain", Value: orDefault(v.App.PreviewDomain, "Generated addresses over plain HTTP"), Mono: v.App.PreviewDomain != ""}})
		</div>
		if len(v.Previews) > 0 {
			<div class="rows">
				for _, p := range v.Previews {
					<div class="row">
						<div class="min-w-0 flex-1">
							<p class="truncate">
								<a class="link font-semibold" href={ templ.SafeURL(v.Beside(p.App.ID)) }>#{ strconv.Itoa(p.App.PRNumber) }</a>
								<span class="fact ml-2">{ p.App.Branch }</span>
							</p>
							if p.URL != "" {
								<a class="link fact block truncate text-sm" href={ templ.SafeURL(p.URL) } target="_blank" rel="noopener">{ p.URL }</a>
							} else {
								<p class="muted text-sm">No address: the one it would have is taken.</p>
							}
						</div>
						@ui.StatusPill(p.App.Status)
						<form method="post" action={ templ.SafeURL(v.Path() + "/previews/" + strconv.Itoa(p.App.PRNumber) + "/delete") }>
							@ui.CSRF(csrf)
							@ui.Button(ui.ButtonProps{Variant: ui.DangerQuiet, Small: true, Type: "submit", Attrs: ui.Ask("Remove the preview of #"+strconv.Itoa(p.App.PRNumber)+"?", "The preview is stopped and removed with its address. A new push to the pull request makes it again.", "Remove preview", true)}) {
								Remove
							}
						</form>
					</div>
				}
			</div>
		} else if v.App.Previews {
			@ui.EmptyState(ui.EmptyProps{Icon: "git-branch", Title: "No previews at the moment", Text: "A pull request into " + v.App.Branch + " gets one when it is opened or pushed to.", Size: ui.EmptySmall})
		}
	</section>
	@ui.FormDialog(ui.DialogProps{ID: "edit-previews", Title: "Pull request previews", Description: "A preview runs the pull request's code with this app's variables, so anyone who can push a branch to the repository can read them. Pull requests from forks get no preview. Up to ten previews exist at once. A webhook added by hand must also send pull request events.", Action: v.Path() + "/previews", CSRF: csrf, Submit: "Save", Open: !f.OK()}) {
		@ui.CheckboxNamed("previews-on", "previews", checked(f, "previews", v.App.Previews), nil) {
			Give every pull request a preview
		}
		@ui.TextField(f, "Domain for previews", "Optional. With preview.example.com, pull request 12 is served at pr-12-" + v.App.Name + ".preview.example.com: point *.preview.example.com at this server. Empty uses generated addresses over plain HTTP.", ui.InputProps{ID: "preview_domain", Mono: true, Value: v.App.PreviewDomain, Placeholder: "preview.example.com"})
	}
}

func yesNo(b bool, yes, no string) string {
	if b {
		return yes
	}
	return no
}

func onOff(on bool) string {
	if on {
		return "On: every pull request gets one"
	}
	return "Off"
}

// optionLabel is the label of the option that has the value, for a page
// that shows a choice it does not let the reader change in place.
func optionLabel(opts []ui.Option, value string) string {
	for _, o := range opts {
		if o.Value == value {
			return o.Label
		}
	}
	return value
}

templ AppSettings(s ui.Shell, v AppView, general, src, previews ui.Form, choices GitChoices) {
	@appFrame(s, v, "settings") {
		<div class="grid max-w-3xl gap-6">
			@ui.FormCard("General", "Changes apply on the next deploy.", v.Path()+"/settings", s.CSRF, "Save changes") {
				@ui.TextField(general, "Name", "", ui.InputProps{ID: "name", Mono: true, Value: v.App.Name, Required: true, Attrs: templ.Attributes{"maxlength": "32"}})
				if v.App.Source != db.SourceGit {
					@ui.TextField(general, "Docker image", "", ui.InputProps{ID: "image", Mono: true, Value: v.App.Image, Required: true})
				}
				@ui.TextField(general, "Port", "The port the app listens on inside its container.", ui.InputProps{ID: "port", Mono: true, Value: strconv.Itoa(v.App.Port), Required: true, Attrs: templ.Attributes{"inputmode": "numeric"}})
				<div class="grid items-start gap-4 sm:grid-cols-2">
					@ui.TextField(general, "Memory limit (MB)", "Empty for no limit.", ui.InputProps{ID: "memory_mb", Mono: true, Value: zeroBlank(v.App.MemoryMB), Attrs: templ.Attributes{"inputmode": "numeric"}})
					@ui.TextField(general, "CPU limit", "In cores, such as 0.5. Empty for no limit.", ui.InputProps{ID: "cpus", Mono: true, Value: cpusValue(v.App.CPUs), Attrs: templ.Attributes{"inputmode": "decimal"}})
				</div>
				@ui.TextField(general, "Health check path", "A deploy waits for this path to answer before switching traffic. Empty checks only that the port accepts connections.", ui.InputProps{ID: "health_path", Mono: true, Value: v.App.HealthPath, Placeholder: "/healthz"})
				@ui.TextField(general, "Health check command", "Used when no path is set. Runs inside the container and must exit 0.", ui.InputProps{ID: "health_cmd", Mono: true, Value: v.App.HealthCmd})
				@ui.TextField(general, "Health check timeout (seconds)", "How long a deploy waits before giving up and keeping the previous version.", ui.InputProps{ID: "health_timeout", Mono: true, Value: strconv.Itoa(v.App.HealthTimeout), Attrs: templ.Attributes{"inputmode": "numeric"}})
				@ui.TextField(general, "Start command", "Replaces the image's own command. Runs through the image's shell. Empty keeps the image's command.", ui.InputProps{ID: "start_command", Mono: true, Value: v.App.StartCommand, Placeholder: "node server.js"})
				@ui.TextField(general, "Extra Docker options", "Such as --shm-size 256m or --ulimit nofile=65536:65536. Options that reach outside the container, such as --privileged or -v, are refused.", ui.InputProps{ID: "docker_options", Mono: true, Value: v.App.DockerOptions})
			}
			if v.App.Source == db.SourceGit {
				@ui.FormCard("Source", "Where the code comes from and how it is built.", v.Path()+"/source", s.CSRF, "Save source") {
					<input type="hidden" name="_submitted" value="1"/>
					@gitSourceFields(src, choices, v.App)
				}
			}
			if v.App.Source == db.SourceGit && len(v.Servers) > 1 {
				<section class="card" id="build-server">
					<div class="card-head">
						<div>
							<h2 class="card-title">Build server</h2>
							<p class="muted text-sm">A build can need a gigabyte of memory or more. On a small server, build the image on another one: it is moved over when it is ready.</p>
						</div>
						@ui.Button(ui.ButtonProps{Small: true, Icon: "pencil", Opens: "edit-build-server"}) {
							Change
						}
					</div>
					<div class="card-body">
						@ui.KeyValue([]ui.KVItem{{Key: "Builds on", Value: optionLabel(buildServerOptions(v), v.App.BuildServerID)}})
					</div>
				</section>
				@ui.FormDialog(ui.DialogProps{ID: "edit-build-server", Title: "Build server", Action: v.Path() + "/build-server", CSRF: s.CSRF, Submit: "Save"}) {
					@ui.Field(ui.FieldProps{Label: "Build on", For: "build_server", Hint: "Applies from the next deployment."}) {
						@ui.Select("build_server", buildServerOptions(v), v.App.BuildServerID, templ.Attributes{"aria-describedby": "build_server-hint"})
					}
				}
			}
			if v.App.Source == db.SourceGit {
				@previewsCard(s.CSRF, v, previews)
			}
			@tagsCard(s.CSRF, v.Path()+"/tags", v.Tags, v.TeamTags)
			<section class="card card-danger">
				<div class="card-head">
					<div>
						<h2 class="card-title">Delete app</h2>
						<p class="muted text-sm">Stops the app and removes its settings, domains and variables. Volumes are kept.</p>
					</div>
					@ui.Confirm(ui.ConfirmProps{
						ID:      "delete-app",
						Title:   "Delete app",
						Action:  v.Path() + "/delete",
						CSRF:    s.CSRF,
						Match:   v.App.Name,
						Submit:  "Delete app",
						Trigger: "Delete app",
					}) {
						<p><strong>{ v.App.Name }</strong> is stopped and removed. Its deployment history goes with it. This cannot be undone.</p>
					}
				</div>
			</section>
		</div>
	}
}

// domainOptions says how a domain is served, in badges.
templ domainOptions(d db.Domain) {
	<span class="flex flex-wrap gap-1">
		if d.TLS {
			@ui.Badge("HTTPS", ui.ToneOK)
		} else {
			@ui.Badge("HTTP", ui.ToneNeutral)
		}
		if d.AuthUser != "" {
			@ui.Badge("Password: " + d.AuthUser, ui.ToneNeutral)
		}
		if d.RedirectWWW {
			@ui.Badge("www redirect", ui.ToneNeutral)
		}
		if d.StripPrefix {
			@ui.Badge("Path removed", ui.ToneNeutral)
		}
		if d.Port != 0 {
			@ui.Badge("Port " + strconv.Itoa(d.Port), ui.ToneNeutral)
		}
	</span>
}

// schemeOptions are the two ways a domain is served. HTTPS is first: it is
// what a domain of one's own gets.
var schemeOptions = []ui.Option{{Value: "https", Label: "https"}, {Value: "http", Label: "http"}}

// DomainTarget is what the Domains tab knows of the app's server: where a
// domain has to lead. All of it is empty when the server could not be read.
type DomainTarget struct {
	// Suffix is what a generated address of the server ends with.
	Suffix string
	// Record is the type of DNS record a domain of one's own needs ("A",
	// "AAAA") and IP its value; both are empty when the server has no
	// public IP address stored.
	Record string
	IP     string
}

// dnsStep says what a person has to do at their DNS provider before a
// domain of their own is served.
func (t DomainTarget) dnsStep() string {
	if t.Record == "" {
		return "Point each domain's DNS at the app's server first, so its certificate can be issued. The server's public IP address is set under Servers."
	}
	return "For a domain of your own, add an " + t.Record + " record with the value " + t.IP + " at your DNS provider first, so its certificate can be issued."
}

// DNSLine is what Check DNS found for one name.
type DNSLine struct {
	Host  string
	Tone  string // the pill's
	Label string // the pill's words
	Text  string // what it means and what to do
}

// DomainDNS is the answer to Check DNS: a line a name, put in the row
// under the domain's.
templ DomainDNS(lines []DNSLine) {
	<div class="grid gap-2 pb-3">
		for _, l := range lines {
			<div class="grid gap-1">
				<p class="flex flex-wrap items-center gap-2">
					@ui.Pill(l.Tone, l.Label)
					if len(lines) > 1 {
						<span class="fact break-all">{ l.Host }</span>
					}
				</p>
				<p class="muted text-sm">{ l.Text }</p>
			</div>
		}
	</div>
}

// AppDomains is an app's Domains tab: the addresses it answers at, and the
// dialog one is added with. f is that dialog's form, at where a domain of
// the app has to lead.
templ AppDomains(s ui.Shell, v AppView, f ui.Form, at DomainTarget) {
	@appFrame(s, v, "domains") {
		<div class="grid max-w-3xl gap-6">
			<section class="card">
				<div class="card-head">
					<div>
						<h2 class="card-title">Domains</h2>
						<p class="muted text-sm">Where the app is reached from outside. { at.dnsStep() }</p>
					</div>
					if len(v.Domains) > 0 {
						@ui.Button(ui.ButtonProps{Small: true, Icon: "plus", Opens: "add-domain"}) {
							Add domain
						}
					}
				</div>
				if len(v.Domains) == 0 {
					@ui.EmptyState(ui.EmptyProps{Icon: "globe", Title: "No domain yet", Text: "Until it has one, the app is reached only from inside its environment.", Size: ui.EmptySmall}) {
						@ui.Button(ui.ButtonProps{Variant: ui.Primary, Small: true, Icon: "plus", Opens: "add-domain"}) {
							Add domain
						}
					}
				} else {
					@ui.Table("Domain", "Served", "") {
						for _, d := range v.Domains {
							<tr>
								<td>
									<a class="fact break-all" href={ templ.SafeURL(domainURL(d)) } target="_blank" rel="noopener">{ d.Host + d.Path }</a>
								</td>
								<td>
									@domainOptions(d)
								</td>
								<td>
									<div class="flex items-center justify-end gap-2">
										if !deploy.Generated(d.Host) {
											@ui.Button(ui.ButtonProps{Small: true, Icon: "search", Attrs: templ.Attributes{"hx-get": v.Path() + "/domains/" + d.ID + "/dns", "hx-target": "#dns-" + d.ID, "hx-swap": "innerHTML", "hx-disabled-elt": "this"}}) {
												Check DNS
											}
										}
										<form method="post" action={ templ.SafeURL(v.Path() + "/domains/" + d.ID + "/delete") }>
											@ui.CSRF(s.CSRF)
											@ui.Button(ui.ButtonProps{Variant: ui.DangerQuiet, Small: true, Type: "submit", Attrs: ui.Ask("Remove "+d.Host+d.Path+"?", v.App.Name+" stops answering at this address at once.", "Remove domain", true)}) {
												Remove
											}
										</form>
									</div>
								</td>
							</tr>
							if !deploy.Generated(d.Host) {
								<tr class="table-under">
									<td colspan="3">
										<div id={ "dns-" + d.ID } aria-live="polite"></div>
									</td>
								</tr>
							}
						}
					}
				}
			</section>
			@ui.FormDialog(ui.DialogProps{ID: "add-domain", Title: "Add domain", Description: at.dnsStep(), Action: v.Path() + "/domains", CSRF: s.CSRF, Submit: "Add domain", Wide: true, Open: !f.OK()}) {
					<div class="address-row">
						@ui.Field(ui.FieldProps{Label: "Scheme", For: "scheme", Error: f.E("scheme")}) {
							@ui.Select("scheme", schemeOptions, f.V("scheme"), nil)
						}
						<div class="address-domain">
							@ui.TextField(f, "Domain", "", ui.InputProps{ID: "host", Mono: true, Required: true, Placeholder: "app.example.com", Autocomplete: "off"})
						</div>
						<div class="address-port">
							@ui.TextField(f, "Port", "", ui.InputProps{ID: "port", Mono: true, Value: strconv.Itoa(v.App.Port), Autocomplete: "off", Attrs: templ.Attributes{"inputmode": "numeric", "maxlength": "5"}})
						</div>
					</div>
					<div class="flex flex-wrap items-start gap-x-3 gap-y-2">
						<p class="field-hint min-w-0 flex-1 basis-56">
							if at.Suffix != "" {
								<span class="block">A generated domain needs no DNS and is served over plain HTTP.</span>
							}
							<span class="block">The port is the one the app listens on.</span>
						</p>
						if at.Suffix != "" {
							<span class="ms-auto">
								@ui.Button(ui.ButtonProps{Small: true, Icon: "refresh", Attrs: templ.Attributes{"data-generate": "host", "data-suffix": at.Suffix, "data-scheme": "scheme"}}) {
									Generate domain
								}
							</span>
						}
					</div>
					@ui.TextField(f, "Path", "Optional. With /api, this app answers app.example.com/api and what is below it; another app can take the rest of the domain.", ui.InputProps{ID: "path", Mono: true, Placeholder: "/api", Autocomplete: "off"})
					@ui.Checkbox("redirect_www", f.V("redirect_www") == "1", nil) {
						Also redirect the www form of the name to it (or the bare name, if this one starts with www)
					}
					@ui.Checkbox("strip_prefix", f.V("strip_prefix") == "1", nil) {
						Remove the path before passing a request on: the app sees /users for /api/users
					}
					<fieldset class="grid gap-4">
						<legend class="field-label">Ask for a password</legend>
						<p class="muted text-sm">Optional. The browser asks for this user name and password before anything reaches the app. Over plain HTTP they travel unencrypted.</p>
						<div class="grid items-start gap-4 sm:grid-cols-2">
							@ui.TextField(f, "User name", "", ui.InputProps{ID: "auth_user", Autocomplete: "off"})
							@ui.TextField(f, "Password", "8 to 72 characters. It is stored as a hash and cannot be shown again.", ui.InputProps{ID: "auth_password", Type: "password", Autocomplete: "new-password"})
						</div>
					</fieldset>
			}
		</div>
	}
}

// ServerInfo is one server with what was learned by asking it.


templ InstanceSettings(s ui.Shell, f ui.Form, domain, email string) {
	@settingsFrame(s, "dashboard") {
		<div class="max-w-2xl">
			<section class="card">
				<div class="card-head">
					<div>
						<h2 class="card-title">Dashboard address</h2>
						<p class="muted text-sm">Reach this dashboard on its own domain, over HTTPS, through the musdash proxy.</p>
					</div>
					@ui.Button(ui.ButtonProps{Small: true, Icon: "pencil", Opens: "edit-address"}) {
						Change
					}
				</div>
				<div class="card-body">
					@ui.KeyValue([]ui.KVItem{{Key: "Dashboard domain", Value: orDefault(domain, "None: the server's address and port"), Mono: domain != ""}, {Key: "Email for certificates", Value: orDefault(email, "None")}})
				</div>
			</section>
			@ui.FormDialog(ui.DialogProps{ID: "edit-address", Title: "Dashboard address", Description: "The domain is where the dashboard is reached and what its links and webhook addresses are built with. After a change, repositories that send webhooks here need the new address.", Action: "/settings", CSRF: s.CSRF, Submit: "Save settings", Open: !f.OK()}) {
				@ui.TextField(f, "Dashboard domain", "Point the domain's DNS at this server first. Leave empty to keep using the server's address and port.", ui.InputProps{ID: "instance_domain", Mono: true, Value: domain, Placeholder: "musdash.example.com"})
				@ui.TextField(f, "Email for certificates", "Let's Encrypt sends expiry warnings here. Optional.", ui.InputProps{ID: "acme_email", Type: "email", Value: email, Placeholder: "you@example.com"})
			}
		</div>
	}
}
