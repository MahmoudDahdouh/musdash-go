package pages

import (
	"strings"

	"github.com/MahmoudDahdouh/musdash-go/internal/db"
	"github.com/MahmoudDahdouh/musdash-go/internal/source"
	"github.com/MahmoudDahdouh/musdash-go/internal/web/ui"
)

func installURL(g db.GitSource) string {
	return "https://github.com/apps/" + g.Slug + "/installations/new"
}

// SourceKind names a source's kind, as the pages and the Git forms say it.
func SourceKind(g db.GitSource) string {
	if g.Kind == db.GitSourceGitLab {
		return "GitLab"
	}
	return "GitHub App"
}

func sourceIcon(g db.GitSource) string {
	if g.Kind == db.GitSourceGitLab {
		return "gitlab"
	}
	return "github"
}

// sourceAccount is who a source acts as: a GitHub App's slug, or the user
// of a GitLab token on its instance.
func sourceAccount(g db.GitSource) string {
	if g.Kind != db.GitSourceGitLab {
		return g.Slug
	}
	host := source.GitLabHost(g.BaseURL)
	if g.Slug == "" {
		return host
	}
	return g.Slug + " on " + host
}

// reposPath is where a source's repository picker asks for its list.
func reposPath(g db.GitSource) string {
	if g.Kind == db.GitSourceGitLab {
		return "/sources/gitlab/" + g.ID + "/repos"
	}
	return "/sources/github/" + g.ID + "/repos"
}

// branchesPath is where a source's branch picker asks for a repository's
// branches; the repository is sent with the request.
func branchesPath(g db.GitSource) string {
	if g.Kind == db.GitSourceGitLab {
		return "/sources/gitlab/" + g.ID + "/branches"
	}
	return "/sources/github/" + g.ID + "/branches"
}

func removeSourcePath(g db.GitSource) string {
	if g.Kind == db.GitSourceGitLab {
		return "/sources/gitlab/" + g.ID + "/delete"
	}
	return "/sources/github/" + g.ID + "/delete"
}

func removeSourceAsk(g db.GitSource) templ.Attributes {
	if g.Kind == db.GitSourceGitLab {
		return ui.Ask("Remove the GitLab source "+g.Name+"?", "musdash forgets the instance and its token: nothing can be deployed through it any more. The token itself keeps working until you revoke it on GitLab. A source that apps still deploy through is not removed.", "Remove source", true)
	}
	return ui.Ask("Remove the GitHub App "+g.Name+"?", "musdash forgets the App: nothing can be deployed through it any more. The App itself stays on GitHub until you delete it there. An App that apps still deploy through is not removed.", "Remove App", true)
}

// addSourceMenu is the button a source is added with: it opens a menu of
// the hosts, and each host opens the dialog its own process starts from.
// end says the button is at the end of a row.
templ addSourceMenu(end bool) {
	@ui.Menu(ui.MenuProps{ID: "new-source", Label: "Add source", Class: "btn btn-primary", End: end, Button: addSourceButton()}) {
		@ui.MenuItem(ui.MenuItemProps{Label: "GitHub", Icon: "github", Opens: "new-github-app"})
		@ui.MenuItem(ui.MenuItemProps{Label: "GitLab", Icon: "gitlab", Opens: "new-gitlab"})
	}
}

templ addSourceButton() {
	@ui.Icon("plus")
	Add source
	@ui.Icon("chevron-down")
}

// Sources is the team's Git sources in one table. appForm and gitlabForm
// are the two dialogs a source is added with: the one that was sent and
// refused comes back open.
templ Sources(s ui.Shell, sources []db.GitSource, appForm, gitlabForm ui.Form) {
	@ui.Layout(s) {
		@ui.PageHeader("Sources", "How musdash reads your private repositories on GitHub and GitLab. Public repositories need nothing here.") {
			if s.Admin && len(sources) > 0 {
				@addSourceMenu(true)
			}
		}
		if len(sources) == 0 && s.Admin {
			@ui.EmptyState(ui.EmptyProps{Icon: "git-branch", Title: "No source yet", Text: "Connect GitHub or GitLab to deploy from private repositories. A GitHub App also deploys on every push."}) {
				@addSourceMenu(false)
			}
		} else if len(sources) == 0 {
			@ui.EmptyState(ui.EmptyProps{Icon: "git-branch", Title: "No source yet", Text: "An Admin can connect GitHub or GitLab."})
		} else {
			<section class="card">
				@ui.Table("Name", "Type", "Account", "") {
					for _, g := range sources {
						<tr>
							<td>
								<span class="inline-flex items-center gap-2">
									@ui.Icon(sourceIcon(g), "text-ink-mute")
									<span class="font-semibold">{ g.Name }</span>
								</span>
							</td>
							<td>
								@ui.Badge(SourceKind(g), ui.ToneNeutral)
							</td>
							<td>
								<a class="fact break-all" href={ templ.SafeURL(g.HTMLURL) } target="_blank" rel="noopener">{ sourceAccount(g) }</a>
							</td>
							<td class="text-right">
								if s.Admin {
									<div class="flex flex-wrap justify-end gap-2">
										if g.Kind == db.GitSourceGitHubApp {
											@ui.LinkButton(installURL(g), ui.ButtonProps{Small: true, Icon: "external", Attrs: templ.Attributes{"target": "_blank", "rel": "noopener"}}) {
												Choose repositories
											}
										}
										<form method="post" action={ templ.SafeURL(removeSourcePath(g)) }>
											@ui.CSRF(s.CSRF)
											@ui.Button(ui.ButtonProps{Variant: ui.DangerQuiet, Small: true, Type: "submit", Attrs: removeSourceAsk(g)}) {
												Remove
											}
										</form>
									</div>
								}
							</td>
						</tr>
					}
				}
			</section>
		}
		if s.Admin {
			@ui.FormDialog(ui.DialogProps{ID: "new-github-app", Title: "New GitHub App", Description: "A GitHub App gives musdash read access to the repositories you choose, and tells it when you push. Creating it takes two steps on GitHub: confirm its name, then choose which repositories it may read. You come back here in between.", Action: "/sources/github", CSRF: s.CSRF, Submit: "Create GitHub App", Open: !appForm.OK()}) {
				@ui.TextField(appForm, "App name", "Shown on GitHub. It must be unique across GitHub.", ui.InputProps{ID: "name", Required: true, Attrs: templ.Attributes{"maxlength": "34"}})
				@ui.TextField(appForm, "Organisation", "Leave empty to create the App under your own account.", ui.InputProps{ID: "organization", Mono: true, Placeholder: "acme"})
				@ui.TextField(appForm, "This dashboard's address", "GitHub sends you back here, and sends push events here. It must be reachable from the internet for pushes to deploy.", ui.InputProps{ID: "base", Mono: true, Required: true})
			}
			@ui.FormDialog(ui.DialogProps{ID: "new-gitlab", Title: "Connect GitLab", Description: "musdash reads your repositories with an access token, which is stored encrypted and not shown again. GitLab does not report pushes through a token: to deploy on every push, give the app a webhook afterwards, with a secret made under Keys & tokens.", Action: "/sources/gitlab", CSRF: s.CSRF, Submit: "Connect GitLab", Open: !gitlabForm.OK()}) {
				@ui.TextField(gitlabForm, "Name", "What you call it here, such as Work GitLab.", ui.InputProps{ID: "gitlab-name", Name: "gitlab_name", Required: true, Attrs: templ.Attributes{"maxlength": "60"}})
				@ui.TextField(gitlabForm, "GitLab address", "https://gitlab.com, or the address of your own instance.", ui.InputProps{ID: "gitlab-base", Name: "gitlab_base", Mono: true, Required: true})
				@ui.TextField(gitlabForm, "Access token", "A personal, group or project access token with the read_api and read_repository scopes. In GitLab: Preferences, Access tokens.", ui.InputProps{ID: "gitlab-token", Name: "gitlab_token", Type: "password", Mono: true, Required: true, Autocomplete: "off"})
			}
		}
	}
}

// GitHubHandoff sends the App manifest to GitHub. The form posts to
// github.com, which this page's Content-Security-Policy allows.
templ GitHubHandoff(s ui.Shell, name, action, manifest string) {
	@ui.Layout(s) {
		@ui.PageHeader("Connect GitHub", "")
		<div class="max-w-xl">
			<form class="card" method="post" action={ templ.SafeURL(action) }>
				<input type="hidden" name="manifest" value={ manifest }/>
				<div class="card-body grid gap-3">
					<h2 class="card-title">Continue on GitHub</h2>
					<p class="text-ink-soft">
						GitHub will ask you to confirm creating an App called <strong>{ name }</strong>. It can read the code of the repositories you choose and nothing else, and it belongs to you: you can remove it from GitHub at any time.
					</p>
					<p class="muted text-sm">After you confirm, GitHub sends you back here.</p>
				</div>
				<div class="card-foot">
					@ui.LinkButton("/sources", ui.ButtonProps{}) {
						Cancel
					}
					@ui.Button(ui.ButtonProps{Variant: ui.Primary, Type: "submit", Icon: "external"}) {
						Continue to GitHub
					}
				</div>
			</form>
		</div>
	}
}

// RepoPick is what a source's repository picker is answered with.
type RepoPick struct {
	Repos []source.RepoInfo
	// Base is the address the repositories are under, without a slash at
	// its end: https://github.com, or a GitLab instance.
	Base string
	// Source is the id of the source whose picker this is: choosing a
	// repository sets the branch picker beside it.
	Source string
	// None is said when the source can read no repository; Problem, when
	// its list could not be had.
	None    string
	Problem string
}

// repoPickerID and branchPickerID are the two pickers a source has in a
// Git form. A form has a pair for each of the team's sources.
func repoPickerID(sourceID string) string { return "repo-" + sourceID }

func branchPickerID(sourceID string) string { return "branch-" + sourceID }

// defaultBranch is the branch a form starts with.
const defaultBranch = "main"

// SuggestName turns a repository's name into one an app may have, or ""
// when nothing of it is left: lower case, with a hyphen for whatever else
// is not a letter or a digit.
func SuggestName(fullName string) string {
	name := fullName[strings.LastIndex(fullName, "/")+1:]
	var b strings.Builder
	for _, c := range strings.ToLower(name) {
		switch {
		case c >= 'a' && c <= 'z', c >= '0' && c <= '9':
			b.WriteRune(c)
		case b.Len() > 0 && !strings.HasSuffix(b.String(), "-"):
			b.WriteByte('-')
		}
	}
	name = b.String()
	if len(name) > 32 {
		name = name[:32]
	}
	return strings.Trim(name, "-")
}

// repoChoice is what choosing a repository does besides: the branch picker
// beside it takes the repository's own branch and forgets its list, and a
// new app is offered the repository's name.
func repoChoice(v RepoPick, repo source.RepoInfo) templ.Attributes {
	attrs := templ.Attributes{"data-sets": branchPickerID(v.Source), "data-sets-value": orDefault(repo.DefaultBranch, defaultBranch)}
	if name := SuggestName(repo.FullName); name != "" {
		attrs["data-suggest"] = name
	}
	return attrs
}

// RepoList is what the repository picker (ui.Picker) loads when it is first
// opened. It ends with the option for a repository the list does not have,
// by its name: the list is cut, and a source can read more than it lists.
templ RepoList(v RepoPick) {
	if v.Problem != "" {
		@ui.MenuNote(v.Problem, true)
	} else if len(v.Repos) == 0 {
		@ui.MenuNote(v.None, false)
	}
	for _, repo := range v.Repos {
		@ui.PickerOption(ui.PickOption{Value: v.Base + "/" + repo.FullName, Label: repo.FullName, Attrs: repoChoice(v, repo)}) {
			<span class="fact min-w-0 flex-1 break-all">{ repo.FullName }</span>
			if repo.Private {
				@ui.Badge("Private", ui.ToneNeutral)
			}
		}
	}
	@ui.PickerTyped(v.Base+"/", "/", templ.Attributes{"data-sets": branchPickerID(v.Source), "data-sets-value": defaultBranch})
}

// BranchPick is what a source's branch picker is answered with.
type BranchPick struct {
	Branches []string
	// Note is said in place of a list that was not asked for: no
	// repository is chosen yet. Problem, when the list could not be had.
	Note    string
	Problem string
}

// BranchList is what the branch picker loads when it is opened.
templ BranchList(v BranchPick) {
	if v.Note != "" {
		@ui.MenuNote(v.Note, false)
	} else {
		if v.Problem != "" {
			@ui.MenuNote(v.Problem, true)
		} else if len(v.Branches) == 0 {
			@ui.MenuNote("This repository has no branch yet.", false)
		}
		for _, branch := range v.Branches {
			@ui.PickerOption(ui.PickOption{Value: branch, Label: branch}) {
				<span class="fact min-w-0 flex-1 break-all">{ branch }</span>
			}
		}
		@ui.PickerTyped("", "", nil)
	}
}

// Detected is what was worked out about how a repository is built.
type Detected struct {
	// Pack is the build that was found and Found the file that says so;
	// both are from musdash's own lists, never a repository's words.
	Pack  string
	Found string
	// Looked is set when the folder was listed, whatever was found.
	Looked  bool
	Problem string
}

func (d Detected) says() string {
	switch d.Pack {
	case "dockerfile":
		return ": the app is built with it."
	case "railpack":
		return " and no Dockerfile: Railpack works out the build."
	case "nixpacks":
		return " and no Dockerfile: Nixpacks works out the build."
	case "static":
		return " and nothing to build: it is served as a static site."
	}
	return ""
}

// BuildDetected is the line under Build with. With a build found it also
// sets the menu (data-pick), which static/app.js does as if it were chosen.
templ BuildDetected(d Detected) {
	if d.Problem != "" {
		<p class="found-line">
			@ui.Icon("alert", "text-warn")
			<span>{ d.Problem }</span>
		</p>
	} else if d.Pack != "" {
		<p class="found-line" data-pick="build_pack" data-value={ d.Pack }>
			@ui.Icon("check", "text-ok")
			<span>Found <span class="fact">{ d.Found }</span>{ d.says() }</span>
		</p>
	} else if d.Looked {
		<p class="found-line">
			@ui.Icon("info", "text-ink-mute")
			<span>Nothing in this folder says how it is built. Choose it here.</span>
		</p>
	}
}
