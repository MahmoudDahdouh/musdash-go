package pages

import (
	"github.com/MahmoudDahdouh/musdash-go/internal/db"
	"github.com/MahmoudDahdouh/musdash-go/internal/source"
	"github.com/MahmoudDahdouh/musdash-go/internal/web/ui"
)

func installURL(g db.GitSource) string {
	return "https://github.com/apps/" + g.Slug + "/installations/new"
}

templ Sources(s ui.Shell, sources []db.GitSource, appForm ui.Form) {
	@ui.Layout(s) {
		@ui.PageHeader("Sources", "How musdash reads your private repositories. Public repositories need nothing here.")
		<div class="grid max-w-3xl gap-6">
			<section class="card">
				<div class="card-head">
					<div>
						<h2 class="card-title">GitHub Apps</h2>
						<p class="muted text-sm">A GitHub App gives musdash read access to the repositories you choose, and tells it when you push.</p>
					</div>
					if s.Admin {
						@ui.Button(ui.ButtonProps{Small: true, Icon: "plus", Opens: "new-github-app"}) {
							New GitHub App
						}
					}
				</div>
				if len(sources) > 0 {
					<div class="rows">
						for _, g := range sources {
							<div class="row">
								@ui.Icon("github", "text-ink-mute")
								<div class="min-w-0 flex-1">
									<p class="truncate font-semibold">{ g.Name }</p>
									<a class="fact truncate text-ink-mute" href={ templ.SafeURL(g.HTMLURL) } target="_blank" rel="noopener">{ g.Slug }</a>
								</div>
								if s.Admin {
									@ui.LinkButton(installURL(g), ui.ButtonProps{Small: true, Icon: "external", Attrs: templ.Attributes{"target": "_blank", "rel": "noopener"}}) {
										Choose repositories
									}
									<form method="post" action={ templ.SafeURL("/sources/github/" + g.ID + "/delete") }>
										@ui.CSRF(s.CSRF)
										@ui.Button(ui.ButtonProps{Variant: ui.DangerQuiet, Small: true, Type: "submit", Attrs: ui.Ask("Remove the GitHub App "+g.Name+"?", "musdash forgets the App: nothing can be deployed through it any more. The App itself stays on GitHub until you delete it there. An App that apps still deploy through is not removed.", "Remove App", true)}) {
											Remove
										}
									</form>
								}
							</div>
						}
					</div>
				} else if s.Admin {
					<p class="card-body muted">No GitHub App yet.</p>
				} else {
					<p class="card-body muted">No GitHub App yet. An Admin can create one.</p>
				}
			</section>
			if s.Admin {
				@ui.FormDialog(ui.DialogProps{ID: "new-github-app", Title: "New GitHub App", Description: "Creating the App takes two steps on GitHub: confirm its name, then choose which repositories it may read. You come back here in between.", Action: "/sources/github", CSRF: s.CSRF, Submit: "Create GitHub App", Open: !appForm.OK()}) {
					@ui.TextField(appForm, "App name", "Shown on GitHub. It must be unique across GitHub.", ui.InputProps{ID: "name", Required: true, Attrs: templ.Attributes{"maxlength": "34"}})
					@ui.TextField(appForm, "Organisation", "Leave empty to create the App under your own account.", ui.InputProps{ID: "organization", Mono: true, Placeholder: "acme"})
					@ui.TextField(appForm, "This dashboard's address", "GitHub sends you back here, and sends push events here. It must be reachable from the internet for pushes to deploy.", ui.InputProps{ID: "base", Mono: true, Required: true})
				}
			}
		</div>
	}
}

// GitHubHandoff sends the App manifest to GitHub. The form posts to
// github.com, which this page's Content-Security-Policy allows.
templ GitHubHandoff(s ui.Shell, name, action, manifest string) {
	@ui.Layout(s) {
		@ui.PageHeader("Connect GitHub", "")
		<div class="max-w-xl">
			<form class="card" method="post" action={ templ.SafeURL(action) }>
				<input type="hidden" name="manifest" value={ manifest }/>
				<div class="card-body grid gap-3">
					<h2 class="card-title">Continue on GitHub</h2>
					<p class="text-ink-soft">
						GitHub will ask you to confirm creating an App called <strong>{ name }</strong>. It can read the code of the repositories you choose and nothing else, and it belongs to you: you can remove it from GitHub at any time.
					</p>
					<p class="muted text-sm">After you confirm, GitHub sends you back here.</p>
				</div>
				<div class="card-foot">
					@ui.LinkButton("/sources", ui.ButtonProps{}) {
						Cancel
					}
					@ui.Button(ui.ButtonProps{Variant: ui.Primary, Type: "submit", Icon: "external"}) {
						Continue to GitHub
					}
				</div>
			</form>
		</div>
	}
}

// RepoList is what the repository picker (ui.Picker) loads when it is first
// opened. Choosing a repository fills the repository field of the form the
// picker is in.
templ RepoList(repos []source.RepoInfo, problem string) {
	if problem != "" {
		@ui.MenuNote(problem, true)
	} else if len(repos) == 0 {
		@ui.MenuNote("This App is not installed on any repository yet. Use Choose repositories on the Sources page.", false)
	} else {
		for _, repo := range repos {
			@ui.PickerOption("repo", "https://github.com/"+repo.FullName, repo.FullName) {
				@ui.Icon("git-branch", "text-ink-mute")
				<span class="fact min-w-0 flex-1 break-all">{ repo.FullName }</span>
				if repo.Private {
					@ui.Badge("Private", ui.ToneNeutral)
				}
				<span class="muted text-xs">{ repo.DefaultBranch }</span>
			}
		}
	}
}
