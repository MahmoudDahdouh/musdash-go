package pages

import (
	"strconv"

	"github.com/MahmoudDahdouh/musdash-go/internal/db"
	"github.com/MahmoudDahdouh/musdash-go/internal/web/ui"
)

func plural(n int, one, many string) string {
	if n == 1 {
		return "1 " + one
	}
	return strconv.Itoa(n) + " " + many
}

// noun is the word for n of something, without the figure.
func noun(n int, one, many string) string {
	if n == 1 {
		return one
	}
	return many
}

// NewProjectDialog is the form a project is made with. The Projects page
// and Home both open it; a refused form comes back on the Projects page.
templ NewProjectDialog(csrf string, f ui.Form) {
	@ui.FormDialog(ui.DialogProps{ID: "new-project", Title: "New project", Description: "A project groups the apps, databases and services of one product. It starts with one environment called production.", Action: "/projects", CSRF: csrf, Submit: "Create project", Open: !f.OK()}) {
		@ui.TextField(f, "Name", "", ui.InputProps{ID: "project-name", Name: "name", Required: true, Autofocus: true, Attrs: templ.Attributes{"maxlength": "60"}})
		@ui.TextField(f, "Description", "Optional.", ui.InputProps{ID: "project-description", Name: "description", Attrs: templ.Attributes{"maxlength": "200"}})
	}
}

templ ProjectList(s ui.Shell, projects []db.Project, f ui.Form) {
	@ui.Layout(s) {
		@ui.PageHeader("Projects", "A project groups the apps, databases and services of one product.") {
			if len(projects) > 0 {
				@ui.Button(ui.ButtonProps{Variant: ui.Primary, Icon: "plus", Opens: "new-project"}) {
					New project
				}
			}
		}
		if len(projects) == 0 {
			@ui.EmptyState("folder", "No projects yet", "Create a project, then deploy apps, databases and services into it.") {
				@ui.Button(ui.ButtonProps{Variant: ui.Primary, Icon: "plus", Opens: "new-project"}) {
					New project
				}
			}
		} else {
			@ui.Tiles("Projects", false) {
				for _, p := range projects {
					@ui.Tile(ui.TileProps{Href: "/projects/" + p.ID, Icon: "folder", Title: p.Name, Text: p.Description}) {
						@ui.Meta(KindIcon(db.KindApp), strconv.Itoa(p.Apps), noun(p.Apps, "app", "apps"))
						@ui.Meta(KindIcon(db.KindDatabase), strconv.Itoa(p.Databases), noun(p.Databases, "database", "databases"))
						@ui.Meta(KindIcon(db.KindService), strconv.Itoa(p.Services), noun(p.Services, "service", "services"))
						@ui.Meta("", plural(p.EnvCount, "environment", "environments"), "")
					}
				}
			}
		}
		@NewProjectDialog(s.CSRF, f)
	}
}

// projectTabs are the sections of a project. envID is the environment the
// person is in, when the page has one, so Resources leads back to it.
func projectTabs(p db.Project, envID string) []ui.Tab {
	resources := "/projects/" + p.ID
	if envID != "" {
		resources += "/e/" + envID
	}
	return []ui.Tab{
		{Key: "resources", Label: "Resources", Href: resources, Icon: "dashboard"},
		{Key: "domains", Label: "Domains", Href: "/projects/" + p.ID + "/domains", Icon: "globe"},
		{Key: "settings", Label: "Settings", Href: "/projects/" + p.ID + "/settings", Icon: "settings"},
	}
}

// ProjectShow is one environment of a project: what runs in it.
templ ProjectShow(s ui.Shell, p db.Project, env db.Environment, res Resources) {
	@ui.Layout(s) {
		@ui.PageHeader(p.Name, p.Description) {
			if res.Count() > 0 {
				@ui.LinkButton("/projects/"+p.ID+"/e/"+env.ID+"/new", ui.ButtonProps{Variant: ui.Primary, Icon: "plus"}) {
					Add resource
				}
			}
		}
		@ui.Tabs(projectTabs(p, env.ID), "resources")
		if res.Count() == 0 {
			@ui.EmptyState("box", "Nothing is in "+env.Name+" yet", "Add an app from a Git repository or a Docker image, a database, or a ready-made service such as WordPress or n8n.") {
				@ui.LinkButton("/projects/"+p.ID+"/e/"+env.ID+"/new", ui.ButtonProps{Variant: ui.Primary, Icon: "plus"}) {
					Add resource
				}
			}
		} else {
			@ResourceTiles(res)
		}
	}
}

// AppChoice is an app a domain can be added to from the project's tab.
type AppChoice struct {
	ID   string
	Name string
	Env  string
}

func appChoiceOptions(apps []AppChoice) []ui.Option {
	opts := make([]ui.Option, 0, len(apps))
	for _, a := range apps {
		opts = append(opts, ui.Option{Value: a.ID, Label: a.Name + " in " + a.Env})
	}
	return opts
}

func projectDomainOwner(d db.ProjectDomain) string {
	if d.OwnerKind == db.KindService {
		return "/services/" + d.OwnerID + "/settings"
	}
	return "/apps/" + d.OwnerID + "/settings#domains"
}

func projectDomainURL(d db.ProjectDomain) string { return domainURL(d.Domain) }

// ProjectDomains is every address of what a project runs, in one list: an
// app's domains and a service's endpoints, in whichever environment. f is
// the Add domain form.
templ ProjectDomains(s ui.Shell, p db.Project, list []db.ProjectDomain, apps []AppChoice, f ui.Form) {
	@ui.Layout(s) {
		@ui.PageHeader(p.Name, p.Description) {
			if len(apps) > 0 {
				@ui.Button(ui.ButtonProps{Variant: ui.Primary, Icon: "plus", Opens: "add-domain"}) {
					Add domain
				}
			}
		}
		@ui.Tabs(projectTabs(p, ""), "domains")
		if len(list) == 0 {
			if len(apps) > 0 {
				@ui.EmptyState("globe", "No domain yet", "Give an app a domain to reach it from outside. Point the domain's DNS at the app's server first, so its certificate can be issued.") {
					@ui.Button(ui.ButtonProps{Variant: ui.Primary, Icon: "plus", Opens: "add-domain"}) {
						Add domain
					}
				}
			} else {
				@ui.EmptyState("globe", "No domain yet", "A domain leads to an app or to a service. Add one of those to the project first.")
			}
		} else {
			<section class="card">
				@ui.Table("Domain", "Leads to", "Environment", "", "") {
					for _, d := range list {
						<tr>
							<td>
								<a class="fact break-all" href={ templ.SafeURL(projectDomainURL(d)) } target="_blank" rel="noopener">{ d.Host + d.Path }</a>
							</td>
							<td>
								<a class="inline-flex items-center gap-2 text-ink" href={ templ.SafeURL(projectDomainOwner(d)) }>
									@ui.Icon(KindIcon(d.OwnerKind), "text-ink-mute")
									<span class="font-semibold">{ d.OwnerName }</span>
									if d.Endpoint != "" {
										<span class="fact text-ink-mute">{ d.Endpoint }</span>
									}
								</a>
							</td>
							<td>
								<a class="fact" href={ templ.SafeURL("/projects/" + p.ID + "/e/" + d.EnvID) }>{ d.EnvName }</a>
							</td>
							<td>
								<span class="flex flex-wrap gap-1">
									if d.TLS {
										@ui.Badge("HTTPS", ui.ToneOK)
									} else {
										@ui.Badge("HTTP", ui.ToneNeutral)
									}
									if d.AuthUser != "" {
										@ui.Badge("Password", ui.ToneNeutral)
									}
									if d.RedirectWWW {
										@ui.Badge("www redirect", ui.ToneNeutral)
									}
									if d.StripPrefix {
										@ui.Badge("Path removed", ui.ToneNeutral)
									}
								</span>
							</td>
							<td class="text-right">
								if d.OwnerKind == db.KindApp {
									<form method="post" action={ templ.SafeURL("/apps/" + d.OwnerID + "/domains/" + d.ID + "/delete") }>
										@ui.CSRF(s.CSRF)
										<input type="hidden" name="from" value="project"/>
										@ui.Button(ui.ButtonProps{Variant: ui.DangerQuiet, Small: true, Type: "submit", Attrs: ui.Ask("Remove "+d.Host+d.Path+"?", d.OwnerName+" stops answering at this address at once.", "Remove domain", true)}) {
											Remove
										}
									</form>
								} else {
									@ui.LinkButton(projectDomainOwner(d), ui.ButtonProps{Small: true}) {
										Change
									}
								}
							</td>
						</tr>
					}
				}
			</section>
		}
		if len(apps) > 0 {
			@ui.FormDialog(ui.DialogProps{ID: "add-domain", Title: "Add domain", Description: "Point the domain's DNS at the app's server first, so its certificate can be issued. A www redirect, a password and path removal are set in the app's own Settings.", Action: "/projects/" + p.ID + "/domains", CSRF: s.CSRF, Submit: "Add domain", Open: !f.OK()}) {
				@ui.Field(ui.FieldProps{Label: "App", For: "domain-app", Error: f.E("app")}) {
					@ui.SelectNamed("domain-app", "app", appChoiceOptions(apps), f.V("app"), nil)
				}
				@ui.TextField(f, "Domain", "", ui.InputProps{ID: "domain-host", Name: "host", Mono: true, Required: true, Placeholder: "app.example.com"})
				@ui.TextField(f, "Only under this path", "Optional. With /api, the app answers app.example.com/api and what is below it.", ui.InputProps{ID: "domain-path", Name: "path", Mono: true, Placeholder: "/api"})
				@ui.Checkbox("tls", f.V("tls") != "0", nil) {
					Serve over HTTPS with an automatic certificate
				}
			}
		}
	}
}

func orNoDescription(text string) string {
	if text == "" {
		return "None"
	}
	return text
}

templ ProjectSettings(s ui.Shell, p db.Project, envs []db.Environment, details, envForm ui.Form) {
	@ui.Layout(s) {
		@ui.PageHeader(p.Name, p.Description)
		@ui.Tabs(projectTabs(p, ""), "settings")
		<div class="grid max-w-2xl gap-6">
			<section class="card">
				<div class="card-head">
					<h2 class="card-title">Project details</h2>
					@ui.Button(ui.ButtonProps{Small: true, Icon: "pencil", Opens: "edit-project"}) {
						Edit
					}
				</div>
				<div class="card-body">
					@ui.KeyValue([]ui.KVItem{{Key: "Name", Value: p.Name}, {Key: "Description", Value: orNoDescription(p.Description)}})
				</div>
			</section>
			@ui.FormDialog(ui.DialogProps{ID: "edit-project", Title: "Project details", Action: "/projects/" + p.ID, CSRF: s.CSRF, Submit: "Save changes", Open: !details.OK()}) {
				@ui.TextField(details, "Name", "", ui.InputProps{ID: "name", Value: p.Name, Required: true, Attrs: templ.Attributes{"maxlength": "60"}})
				@ui.TextField(details, "Description", "Optional.", ui.InputProps{ID: "description", Value: p.Description, Attrs: templ.Attributes{"maxlength": "200"}})
			}
			<section class="card" id="environments">
				<div class="card-head">
					<div>
						<h2 class="card-title">Environments</h2>
						<p class="muted text-sm">Separate copies of the project, such as production and staging.</p>
					</div>
					@ui.Button(ui.ButtonProps{Small: true, Icon: "plus", Opens: "new-environment"}) {
						New environment
					}
				</div>
				<div class="rows">
					for _, e := range envs {
						<div class="row">
							<a class="fact min-w-0 flex-1 truncate" href={ templ.SafeURL("/projects/" + p.ID + "/e/" + e.ID) }>{ e.Name }</a>
							if len(envs) > 1 {
								@ui.Confirm(ui.ConfirmProps{
									ID:      "delete-env-" + e.ID,
									Title:   "Delete environment",
									Action:  "/environments/" + e.ID + "/delete",
									CSRF:    s.CSRF,
									Match:   e.Name,
									Submit:  "Delete environment",
									Trigger: "Delete",
								}) {
									<p>The environment <strong>{ e.Name }</strong> is removed. It must be empty: delete what is deployed in it first.</p>
								}
							} else {
								<span class="muted text-sm">The only environment</span>
							}
						</div>
					}
				</div>
			</section>
			@ui.FormDialog(ui.DialogProps{ID: "new-environment", Title: "New environment", Description: "It starts empty, with a network of its own: what runs in it does not see the other environments.", Action: "/projects/" + p.ID + "/environments", CSRF: s.CSRF, Submit: "Create environment", Open: !envForm.OK()}) {
				@ui.TextField(envForm, "Name", "Lowercase letters, numbers and hyphens.", ui.InputProps{ID: "env-name", Name: "name", Placeholder: "staging", Mono: true, Required: true, Attrs: templ.Attributes{"maxlength": "32"}})
			}
			<section class="card" id="variables">
				<div class="card-head">
					<div>
						<h2 class="card-title">Shared variables</h2>
						<p class="muted text-sm">Values that apps and services take by name, such as <span class="code">{ "{{project.NAME}}" }</span>, so they are written once.</p>
					</div>
				</div>
				<div class="rows">
					<a class="row" href={ templ.SafeURL("/projects/" + p.ID + "/variables") }>
						<span class="min-w-0 flex-1">The whole project</span>
						@ui.Icon("chevron-right", "text-ink-mute")
					</a>
					for _, e := range envs {
						<a class="row" href={ templ.SafeURL("/environments/" + e.ID + "/variables") }>
							<span class="min-w-0 flex-1">Only <span class="fact">{ e.Name }</span></span>
							@ui.Icon("chevron-right", "text-ink-mute")
						</a>
					}
				</div>
			</section>
			<section class="card card-danger">
				<div class="card-head">
					<div>
						<h2 class="card-title">Delete project</h2>
						<p class="muted text-sm">A project can be deleted once nothing is deployed in it.</p>
					</div>
					@ui.Confirm(ui.ConfirmProps{
						ID:      "delete-project",
						Title:   "Delete project",
						Action:  "/projects/" + p.ID + "/delete",
						CSRF:    s.CSRF,
						Match:   p.Name,
						Submit:  "Delete project",
						Trigger: "Delete project",
					}) {
						<p><strong>{ p.Name }</strong> and its environments are removed. This cannot be undone.</p>
					}
				</div>
			</section>
		</div>
	}
}

templ Account(s ui.Shell, profile, password, twoStep ui.Form, v AccountView) {
	@ui.Layout(s) {
		@ui.PageHeader("Account", "")
		<div class="grid max-w-2xl gap-6">
			<section class="card">
				<div class="card-head">
					<h2 class="card-title">Profile</h2>
					@ui.Button(ui.ButtonProps{Small: true, Icon: "pencil", Opens: "edit-profile"}) {
						Edit
					}
				</div>
				<div class="card-body">
					@ui.KeyValue([]ui.KVItem{{Key: "Name", Value: s.Name}, {Key: "Email", Value: s.Email}})
				</div>
			</section>
			@ui.FormDialog(ui.DialogProps{ID: "edit-profile", Title: "Profile", Action: "/account/profile", CSRF: s.CSRF, Submit: "Save changes", Open: !profile.OK()}) {
				@ui.TextField(profile, "Name", "", ui.InputProps{ID: "name", Value: s.Name, Autocomplete: "name", Required: true})
				@ui.TextField(profile, "Email", "You sign in with this address.", ui.InputProps{ID: "email", Type: "email", Value: s.Email, Autocomplete: "email", Required: true})
			}
			<section class="card">
				<div class="card-head">
					<div>
						<h2 class="card-title">Password</h2>
						<p class="muted text-sm">Changing it signs you out everywhere else and revokes your API tokens.</p>
					</div>
					@ui.Button(ui.ButtonProps{Small: true, Icon: "key", Opens: "change-password"}) {
						Change password
					}
				</div>
			</section>
			@ui.FormDialog(ui.DialogProps{ID: "change-password", Title: "Change password", Description: "You are signed out everywhere else, and your API tokens are revoked.", Action: "/account/password", CSRF: s.CSRF, Submit: "Change password", Open: !password.OK()}) {
				@ui.TextField(password, "Current password", "", ui.InputProps{ID: "current", Type: "password", Autocomplete: "current-password", Required: true})
				@ui.TextField(password, "New password", "10 to 72 characters.", ui.InputProps{ID: "password", Type: "password", Autocomplete: "new-password", Required: true})
			}
			@twoStepCard(s, v, twoStep)
			<section class="card" id="tokens">
				<div class="card-head">
					<div>
						<h2 class="card-title">API tokens</h2>
						<p class="muted text-sm">Your tokens for scripts and pipelines are kept with every other key and token.</p>
					</div>
					@ui.LinkButton("/keys#tokens", ui.ButtonProps{Small: true, Icon: "key"}) {
						Keys & tokens
					}
				</div>
			</section>
		</div>
	}
}

// NotFound is the signed-in 404 page.
templ NotFound(s ui.Shell) {
	@ui.Layout(s) {
		@ui.EmptyState("alert", "Page not found", "It may have been deleted, or the address is wrong.") {
			@ui.LinkButton("/", ui.ButtonProps{}) {
				Go to Home
			}
		}
	}
}
