package pages

import (
	"strconv"

	"github.com/MahmoudDahdouh/musdash-go/internal/db"
	"github.com/MahmoudDahdouh/musdash-go/internal/web/ui"
)

func plural(n int, one, many string) string {
	if n == 1 {
		return "1 " + one
	}
	return strconv.Itoa(n) + " " + many
}

// noun is the word for n of something, without the figure.
func noun(n int, one, many string) string {
	if n == 1 {
		return one
	}
	return many
}

// NewProjectDialog is the form a project is made with. The Projects page
// and Home both open it; a refused form comes back on the Projects page.
templ NewProjectDialog(csrf string, f ui.Form) {
	@ui.FormDialog(ui.DialogProps{ID: "new-project", Title: "New project", Description: "A project groups the apps, databases and services of one product. It starts with one environment called production.", Action: "/projects", CSRF: csrf, Submit: "Create project", Open: !f.OK()}) {
		@ui.TextField(f, "Name", "", ui.InputProps{ID: "project-name", Name: "name", Required: true, Autofocus: true, Attrs: templ.Attributes{"maxlength": "60"}})
		@ui.TextField(f, "Description", "Optional.", ui.InputProps{ID: "project-description", Name: "description", Attrs: templ.Attributes{"maxlength": "200"}})
	}
}

templ ProjectList(s ui.Shell, projects []db.Project, f ui.Form) {
	@ui.Layout(s) {
		@ui.PageHeader("Projects", "A project groups the apps, databases and services of one product.") {
			if len(projects) > 0 {
				@ui.Button(ui.ButtonProps{Variant: ui.Primary, Icon: "plus", Opens: "new-project"}) {
					New project
				}
			}
		}
		if len(projects) == 0 {
			@ui.EmptyState(ui.EmptyProps{Icon: "folder", Title: "No projects yet", Text: "Create a project, then deploy apps, databases and services into it."}) {
				@ui.Button(ui.ButtonProps{Variant: ui.Primary, Icon: "plus", Opens: "new-project"}) {
					New project
				}
			}
		} else {
			@ui.Tiles("Projects", false) {
				for _, p := range projects {
					@ui.Tile(ui.TileProps{Href: "/projects/" + p.ID, Icon: "folder", Title: p.Name, Text: p.Description}) {
						@ui.Meta(KindIcon(db.KindApp), strconv.Itoa(p.Apps), noun(p.Apps, "app", "apps"))
						@ui.Meta(KindIcon(db.KindDatabase), strconv.Itoa(p.Databases), noun(p.Databases, "database", "databases"))
						@ui.Meta(KindIcon(db.KindService), strconv.Itoa(p.Services), noun(p.Services, "service", "services"))
						@ui.Meta("", plural(p.EnvCount, "environment", "environments"), "")
					}
				}
			}
		}
		@NewProjectDialog(s.CSRF, f)
	}
}

// projectTabs are the two pages of a project: its environments, and what
// the project itself has.
func projectTabs(p db.Project) []ui.Tab {
	return []ui.Tab{
		{Key: "environments", Label: "Environments", Href: "/projects/" + p.ID, Icon: "box"},
		{Key: "settings", Label: "Settings", Href: "/projects/" + p.ID + "/settings", Icon: "settings"},
	}
}

// ProjectShow is a project's own page, the first of its two tabs: its
// environments, each a card that leads into it. f is the Add environment
// form, with what was refused when it comes back.
templ ProjectShow(s ui.Shell, p db.Project, envs []db.Environment, f ui.Form) {
	@ui.Layout(s) {
		@ui.PageHeader(p.Name, p.Description) {
			@ui.Button(ui.ButtonProps{Variant: ui.Primary, Icon: "plus", Opens: "new-environment"}) {
				Add environment
			}
		}
		@ui.Tabs(projectTabs(p), "environments")
		@ui.Tiles("Environments", false) {
			for _, e := range envs {
				@ui.Tile(ui.TileProps{Href: EnvPath(p.ID, e.ID), Icon: "box", Title: e.Name}) {
					@ui.Meta(KindIcon(db.KindApp), strconv.Itoa(e.Apps), noun(e.Apps, "app", "apps"))
					@ui.Meta(KindIcon(db.KindDatabase), strconv.Itoa(e.Databases), noun(e.Databases, "database", "databases"))
					@ui.Meta(KindIcon(db.KindService), strconv.Itoa(e.Services), noun(e.Services, "service", "services"))
				}
			}
		}
		@ui.FormDialog(ui.DialogProps{ID: "new-environment", Title: "Add environment", Description: "It starts empty, with a network of its own: what runs in it does not see the other environments.", Action: "/projects/" + p.ID + "/environments", CSRF: s.CSRF, Submit: "Add environment", Open: !f.OK()}) {
			@ui.TextField(f, "Name", "Lowercase letters, numbers and hyphens.", ui.InputProps{ID: "env-name", Name: "name", Placeholder: "staging", Mono: true, Required: true, Attrs: templ.Attributes{"maxlength": "32"}})
		}
	}
}

// EnvironmentShow is one environment of a project: what runs in it.
templ EnvironmentShow(s ui.Shell, p db.Project, env db.Environment, res Resources) {
	@ui.Layout(s) {
		@ui.PageHeader(env.Name, "An environment of "+p.Name+".") {
			@ui.LinkButton(EnvPath(p.ID, env.ID)+"/settings", ui.ButtonProps{Icon: "settings"}) {
				Settings
			}
			if res.Count() > 0 {
				@ui.LinkButton(EnvPath(p.ID, env.ID)+"/new", ui.ButtonProps{Variant: ui.Primary, Icon: "plus"}) {
					Add resource
				}
			}
		}
		if res.Count() == 0 {
			@ui.EmptyState(ui.EmptyProps{Icon: "box", Title: "Nothing is in " + env.Name + " yet", Text: "Add an app from a Git repository or a Docker image, a database, or a ready-made service such as WordPress or n8n."}) {
				@ui.LinkButton(EnvPath(p.ID, env.ID)+"/new", ui.ButtonProps{Variant: ui.Primary, Icon: "plus"}) {
					Add resource
				}
			}
		} else {
			@ResourceTiles(res)
		}
	}
}

// EnvironmentSettings is what an environment has of its own: its name, its
// shared variables, and the way to delete it. only says it is the
// project's one environment, which cannot be deleted. f is the Rename form.
templ EnvironmentSettings(s ui.Shell, p db.Project, env db.Environment, only bool, f ui.Form) {
	@ui.Layout(s) {
		@ui.PageHeader(env.Name, "An environment of "+p.Name+".") {
			@ui.LinkButton(EnvPath(p.ID, env.ID), ui.ButtonProps{Icon: "dashboard"}) {
				Resources
			}
		}
		<div class="grid max-w-2xl gap-6">
			<section class="card">
				<div class="card-head">
					<h2 class="card-title">Environment details</h2>
					@ui.Button(ui.ButtonProps{Small: true, Icon: "pencil", Opens: "rename-environment"}) {
						Rename
					}
				</div>
				<div class="card-body">
					@ui.KeyValue([]ui.KVItem{{Key: "Name", Value: env.Name, Mono: true}})
				</div>
			</section>
			@ui.FormDialog(ui.DialogProps{ID: "rename-environment", Title: "Rename environment", Description: "Only the name changes. What runs in the environment is not touched, and keeps its addresses.", Action: EnvPath(p.ID, env.ID) + "/settings", CSRF: s.CSRF, Submit: "Rename", Open: !f.OK()}) {
				@ui.TextField(f, "Name", "Lowercase letters, numbers and hyphens.", ui.InputProps{ID: "env-name", Name: "name", Value: env.Name, Mono: true, Required: true, Attrs: templ.Attributes{"maxlength": "32"}})
			}
			<section class="card" id="variables">
				<div class="card-head">
					<div>
						<h2 class="card-title">Shared variables</h2>
						<p class="muted text-sm">Values that what runs here takes by name, such as <span class="code">{ "{{environment.NAME}}" }</span>, so they are written once.</p>
					</div>
				</div>
				<div class="rows">
					<a class="row" href={ templ.SafeURL(EnvPath(p.ID, env.ID) + "/variables") }>
						<span class="min-w-0 flex-1">Variables of <span class="fact">{ env.Name }</span></span>
						@ui.Icon("chevron-right", "text-ink-mute")
					</a>
				</div>
			</section>
			<section class="card card-danger">
				<div class="card-head">
					<div>
						<h2 class="card-title">Delete environment</h2>
						if only {
							<p class="muted text-sm">This is the project's only environment, and a project needs one.</p>
						} else {
							<p class="muted text-sm">An environment can be deleted once nothing is deployed in it.</p>
						}
					</div>
					if !only {
						@ui.Confirm(ui.ConfirmProps{
							ID:      "delete-environment",
							Title:   "Delete environment",
							Action:  EnvPath(p.ID, env.ID) + "/delete",
							CSRF:    s.CSRF,
							Match:   env.Name,
							Submit:  "Delete environment",
							Trigger: "Delete environment",
						}) {
							<p>The environment <strong>{ env.Name }</strong> is removed. It must be empty: delete what is deployed in it first.</p>
						}
					}
				</div>
			</section>
		</div>
	}
}

func orNoDescription(text string) string {
	if text == "" {
		return "None"
	}
	return text
}

// ProjectSettings is the project's second tab: what the project itself
// has. An environment's name, variables and deletion are on that
// environment's own Settings. details is the Edit form.
templ ProjectSettings(s ui.Shell, p db.Project, details ui.Form) {
	@ui.Layout(s) {
		@ui.PageHeader(p.Name, p.Description)
		@ui.Tabs(projectTabs(p), "settings")
		<div class="grid max-w-2xl gap-6">
			<section class="card">
				<div class="card-head">
					<h2 class="card-title">Project details</h2>
					@ui.Button(ui.ButtonProps{Small: true, Icon: "pencil", Opens: "edit-project"}) {
						Edit
					}
				</div>
				<div class="card-body">
					@ui.KeyValue([]ui.KVItem{{Key: "Name", Value: p.Name}, {Key: "Description", Value: orNoDescription(p.Description)}})
				</div>
			</section>
			@ui.FormDialog(ui.DialogProps{ID: "edit-project", Title: "Project details", Action: "/projects/" + p.ID, CSRF: s.CSRF, Submit: "Save changes", Open: !details.OK()}) {
				@ui.TextField(details, "Name", "", ui.InputProps{ID: "name", Value: p.Name, Required: true, Attrs: templ.Attributes{"maxlength": "60"}})
				@ui.TextField(details, "Description", "Optional.", ui.InputProps{ID: "description", Value: p.Description, Attrs: templ.Attributes{"maxlength": "200"}})
			}
			<section class="card" id="variables">
				<div class="card-head">
					<div>
						<h2 class="card-title">Shared variables</h2>
						<p class="muted text-sm">Values that apps and services take by name, such as <span class="code">{ "{{project.NAME}}" }</span>, so they are written once.</p>
					</div>
				</div>
				<div class="rows">
					<a class="row" href={ templ.SafeURL("/projects/" + p.ID + "/variables") }>
						<span class="min-w-0 flex-1">The whole project</span>
						@ui.Icon("chevron-right", "text-ink-mute")
					</a>
				</div>
			</section>
			<section class="card card-danger">
				<div class="card-head">
					<div>
						<h2 class="card-title">Delete project</h2>
						<p class="muted text-sm">A project can be deleted once nothing is deployed in it.</p>
					</div>
					@ui.Confirm(ui.ConfirmProps{
						ID:      "delete-project",
						Title:   "Delete project",
						Action:  "/projects/" + p.ID + "/delete",
						CSRF:    s.CSRF,
						Match:   p.Name,
						Submit:  "Delete project",
						Trigger: "Delete project",
					}) {
						<p><strong>{ p.Name }</strong> and its environments are removed. This cannot be undone.</p>
					}
				</div>
			</section>
		</div>
	}
}

templ Account(s ui.Shell, profile, password, twoStep ui.Form, v AccountView) {
	@ui.Layout(s) {
		@ui.PageHeader("Account", "")
		<div class="grid max-w-2xl gap-6">
			<section class="card">
				<div class="card-head">
					<h2 class="card-title">Profile</h2>
					@ui.Button(ui.ButtonProps{Small: true, Icon: "pencil", Opens: "edit-profile"}) {
						Edit
					}
				</div>
				<div class="card-body">
					@ui.KeyValue([]ui.KVItem{{Key: "Name", Value: s.Name}, {Key: "Email", Value: s.Email}})
				</div>
			</section>
			@ui.FormDialog(ui.DialogProps{ID: "edit-profile", Title: "Profile", Action: "/account/profile", CSRF: s.CSRF, Submit: "Save changes", Open: !profile.OK()}) {
				@ui.TextField(profile, "Name", "", ui.InputProps{ID: "name", Value: s.Name, Autocomplete: "name", Required: true})
				@ui.TextField(profile, "Email", "You sign in with this address.", ui.InputProps{ID: "email", Type: "email", Value: s.Email, Autocomplete: "email", Required: true})
			}
			<section class="card">
				<div class="card-head">
					<div>
						<h2 class="card-title">Password</h2>
						<p class="muted text-sm">Changing it signs you out everywhere else and revokes your API tokens.</p>
					</div>
					@ui.Button(ui.ButtonProps{Small: true, Icon: "key", Opens: "change-password"}) {
						Change password
					}
				</div>
			</section>
			@ui.FormDialog(ui.DialogProps{ID: "change-password", Title: "Change password", Description: "You are signed out everywhere else, and your API tokens are revoked.", Action: "/account/password", CSRF: s.CSRF, Submit: "Change password", Open: !password.OK()}) {
				@ui.TextField(password, "Current password", "", ui.InputProps{ID: "current", Type: "password", Autocomplete: "current-password", Required: true})
				@ui.TextField(password, "New password", "10 to 72 characters.", ui.InputProps{ID: "password", Type: "password", Autocomplete: "new-password", Required: true})
			}
			@twoStepCard(s, v, twoStep)
		</div>
	}
}

// NotFound is the signed-in 404 page.
templ NotFound(s ui.Shell) {
	@ui.Layout(s) {
		@ui.EmptyState(ui.EmptyProps{Icon: "alert", Title: "Page not found", Text: "It may have been deleted, or the address is wrong.", Size: ui.EmptyPage}) {
			@ui.LinkButton("/", ui.ButtonProps{Variant: ui.Primary}) {
				Go to Home
			}
		}
	}
}
