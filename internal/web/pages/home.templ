package pages

import (
	"math"
	"strconv"

	"github.com/MahmoudDahdouh/musdash-go/internal/db"
	"github.com/MahmoudDahdouh/musdash-go/internal/web/ui"
)

// HomeView is what Home shows of a team. All of it is read from the
// database: the page asks no server anything, so a server that hangs does
// not hold it up.
type HomeView struct {
	// Admin says the reader may connect a source.
	Admin    bool
	Totals   db.Totals
	// Deployments is how the deployments of the last day went, and Backups
	// how the backups of the team's databases stand: two of the figures
	// the page opens with. Both are read only once something is deployed.
	Deployments db.DeployCount
	Backups     db.BackupState
	Events      []db.Event
	Projects []db.ActiveProject
	Servers  []HomeServer
	// Next is where the page asks again, and Every how often. Next is
	// empty unless something is in progress: a page on which nothing is
	// happening asks nothing.
	Next, Every string
}

// HomeServer is a server with its newest stored reading.
type HomeServer struct {
	Server db.Server
	// Meters is empty when the server's usage is not recorded, or its last
	// reading is too old to be what it uses now.
	Meters []ui.MeterProps
	// Disk is how full its disk was at that reading, 0 to 1, and below
	// zero when there is none.
	Disk float64
}

// The figures Home opens with are the four things a person opens it to
// find out, in the order they ask: is everything up, did my deployments
// work, are the servers there and have they room, is my data safe. A count
// that answers none of these (projects, domains) is not among them. Each
// says how it stands in a flag, in words as well as colour, and leads to
// where it is looked into.

// runningFigure: how much of what the team has is running.
func runningFigure(t db.Totals) ui.FigureProps {
	f := ui.FigureProps{Label: "Running", Icon: "play", Value: strconv.Itoa(t.Running), Of: "of " + strconv.Itoa(t.Resources), Href: "/projects", Detail: "Apps, databases and services"}
	switch {
	case t.Down > 0:
		f.Flag, f.FlagTone = strconv.Itoa(t.Down)+" down", ui.ToneDanger
	case t.Running == t.Resources:
		f.Flag, f.FlagTone = "All running", ui.ToneOK
	}
	// The rest is neither running nor down: stopped on purpose, or made
	// and not deployed yet.
	if rest := t.Resources - t.Running - t.Down; rest > 0 {
		f.Detail = strconv.Itoa(rest) + " stopped or not deployed"
	}
	return f
}

// deploymentsFigure: how the deployments of the last day went.
func deploymentsFigure(c db.DeployCount) ui.FigureProps {
	f := ui.FigureProps{Label: "Deployments", Icon: "rocket", Value: strconv.Itoa(c.Total), Href: "#home-activity", Detail: "In the last 24 hours"}
	switch {
	case c.Failed > 0:
		f.Flag, f.FlagTone = strconv.Itoa(c.Failed)+" failed", ui.ToneDanger
		if c.InProgress > 0 {
			f.Detail = strconv.Itoa(c.InProgress) + " in progress now"
		}
	case c.InProgress > 0:
		f.Flag, f.FlagTone = strconv.Itoa(c.InProgress)+" in progress", ui.ToneBusy
	case c.Total > 0:
		f.Flag, f.FlagTone = "All succeeded", ui.ToneOK
	}
	return f
}

// serversFigure: how many servers are there to deploy to, and how full the
// fullest of them is. This machine is ready: it is where the page comes
// from. A remote server is as its last check found it.
func serversFigure(servers []HomeServer) ui.FigureProps {
	ready, fullest := 0, -1
	for i, h := range servers {
		if h.Server.Kind == db.ServerLocal || h.Server.Status == db.ServerOK {
			ready++
		}
		if h.Disk >= 0 && (fullest < 0 || h.Disk > servers[fullest].Disk) {
			fullest = i
		}
	}
	f := ui.FigureProps{Label: "Servers ready", Icon: "server", Value: strconv.Itoa(ready), Of: "of " + strconv.Itoa(len(servers)), Href: "/servers", Detail: "No recent reading of their disks"}
	if fullest >= 0 {
		full := ui.Percent(math.Round(servers[fullest].Disk * 100))
		f.Detail = "Disk " + full + " full"
		if len(servers) > 1 {
			f.Detail = "Fullest disk: " + full + ", " + servers[fullest].Server.Name
		}
	}
	switch {
	case ready < len(servers):
		f.Flag, f.FlagTone = strconv.Itoa(len(servers)-ready)+" not ready", ui.ToneDanger
	case fullest >= 0 && servers[fullest].Disk >= 0.9:
		f.Flag, f.FlagTone = "Disk nearly full", ui.ToneDanger
	case fullest >= 0 && servers[fullest].Disk >= 0.75:
		f.Flag, f.FlagTone = "Disk filling up", ui.ToneWarn
	default:
		f.Flag, f.FlagTone = "All ready", ui.ToneOK
	}
	return f
}

// backupsFigure: when a backup last succeeded, and whether every database
// has one coming. A team without a database has nothing to back up, and
// the card says so and leads nowhere.
func backupsFigure(b db.BackupState) ui.FigureProps {
	f := ui.FigureProps{Label: "Last backup", Icon: "archive", Value: "None yet", Href: "#home-activity"}
	if b.Databases == 0 {
		return ui.FigureProps{Label: "Last backup", Icon: "archive", Value: "–", Detail: "No databases to back up"}
	}
	if b.LastSuccess > 0 {
		f.Value = Said(ui.Ago(b.LastSuccess))
	}
	f.Detail = strconv.Itoa(b.Scheduled) + " of " + plural(b.Databases, "database", "databases") + " on a schedule"
	switch {
	case b.Failed > 0:
		f.Flag, f.FlagTone = strconv.Itoa(b.Failed)+" failed", ui.ToneDanger
		f.Href = ResourcePath(b.BrokenProjectID, b.BrokenEnvironmentID, db.KindDatabase, b.BrokenID) + "/backups"
	case b.Scheduled < b.Databases:
		f.Flag, f.FlagTone = strconv.Itoa(b.Databases-b.Scheduled)+" not scheduled", ui.ToneWarn
	default:
		f.Flag, f.FlagTone = "All scheduled", ui.ToneOK
	}
	return f
}

func eventHref(e db.Event) string {
	switch e.Kind {
	case db.EventBackup:
		return ResourcePath(e.ProjectID, e.EnvironmentID, db.KindDatabase, e.ResourceID) + "/backups"
	case db.EventTask:
		return ResourcePath(e.ProjectID, e.EnvironmentID, db.KindApp, e.ResourceID) + "/tasks/" + e.TaskID
	}
	return ResourcePath(e.ProjectID, e.EnvironmentID, db.KindApp, e.ResourceID) + "/deployments/" + e.ID
}

func eventIcon(kind string) string {
	switch kind {
	case db.EventBackup:
		return "drive"
	case db.EventTask:
		return "clock"
	}
	return "deploy"
}

// eventWhat names what was done, after the resource's name. It does not
// say how it went: the pill does.
func eventWhat(e db.Event) string {
	switch e.Kind {
	case db.EventBackup:
		return "backup"
	case db.EventTask:
		return "task " + e.Detail
	}
	return "deployment"
}

// eventState is the state an event's row is drawn in. A deployment that is
// "running" is in progress, which is not what "running" says of an app,
// so it is given the state of something being deployed.
func eventState(e db.Event) string {
	if e.Status == db.DeployRunning {
		return "deploying"
	}
	return e.Status
}

func eventLabel(e db.Event) string {
	if e.Status == db.DeployRunning {
		return "In progress"
	}
	return ui.StateLabel(e.Status)
}

// eventCommit is a deployment's commit, shortened, or "".
func eventCommit(e db.Event) string {
	if e.Kind != db.EventDeployment || len(e.Detail) < 7 {
		return ""
	}
	return e.Detail[:7]
}

func projectLine(p db.ActiveProject) string {
	if p.Resources == 0 {
		return "Nothing deployed yet"
	}
	return strconv.Itoa(p.Running) + " of " + strconv.Itoa(p.Resources) + " running"
}

func serverHost(s db.Server) string {
	if s.Kind == db.ServerLocal {
		return orDefault(s.IP, "localhost")
	}
	return s.Host
}

// Home is the page a person lands on.
templ Home(s ui.Shell, v HomeView) {
	@ui.Layout(s) {
		@ui.PageHeader("Home", "What was done lately, and where it all runs.") {
			if v.Totals.Projects > 0 {
				@ui.Button(ui.ButtonProps{Variant: ui.Primary, Icon: "plus", Opens: "new-project"}) {
					New project
				}
			}
		}
		@HomeLive(v)
		@NewProjectDialog(s.CSRF, ui.Form{})
	}
}

// HomeLive is everything on Home under its title: the four figures, then
// what was done lately and where it runs. An install with nothing deployed
// has the steps that get the first thing running in the figures' place:
// four noughts say nothing. While a deployment, a backup or a task is in
// progress it asks for itself again; once nothing is, it stops.
templ HomeLive(v HomeView) {
	<div
		id="home-live"
		class="grid gap-6"
		if v.Next != "" {
			hx-get={ v.Next }
			hx-trigger={ "every " + v.Every }
			hx-swap="outerHTML"
		}
	>
		if v.Totals.Resources == 0 {
			@homeStart(v)
		} else {
			@ui.Figures("At a glance") {
				@ui.Figure(runningFigure(v.Totals))
				@ui.Figure(deploymentsFigure(v.Deployments))
				@ui.Figure(serversFigure(v.Servers))
				@ui.Figure(backupsFigure(v.Backups))
			}
		}
		<div class="grid items-start gap-6 xl:grid-cols-3">
			<div class="grid min-w-0 gap-6 xl:col-span-2">
				@homeActivity(v)
			</div>
			<div class="grid min-w-0 gap-6">
				@homeProjects(v)
				@homeServers(v)
			</div>
		</div>
	</div>
}

// homeStart is the way in for an install with nothing deployed on it yet.
templ homeStart(v HomeView) {
	<section class="card" aria-labelledby="home-start">
		<div class="card-head">
			<div>
				<h2 class="card-title" id="home-start">Getting started</h2>
				<p class="muted text-sm">Nothing is deployed yet. These steps get the first thing running.</p>
			</div>
		</div>
		<ol class="rows steps">
			@homeStep(v.Totals.Projects > 0, "Create a project", "A project groups the apps, databases and services of one product.") {
				if v.Totals.Projects == 0 {
					@ui.Button(ui.ButtonProps{Variant: ui.Primary, Small: true, Icon: "plus", Opens: "new-project"}) {
						New project
					}
				}
			}
			if v.Admin {
				@homeStep(v.Totals.Sources > 0, "Connect GitHub or GitLab (optional)", "To deploy from private repositories. Public repositories and Docker images need nothing.") {
					if v.Totals.Sources == 0 {
						@ui.LinkButton("/sources", ui.ButtonProps{Small: true, Icon: "git-branch"}) {
							Sources
						}
					}
				}
			}
			@homeStep(false, "Deploy an app, a database or a service", "From a Docker image, a Git repository, or a ready-made template such as WordPress or n8n.") {
				if len(v.Projects) > 0 {
					@ui.LinkButton("/projects/"+v.Projects[0].ID, ui.ButtonProps{Variant: ui.Primary, Small: true}) {
						Open { v.Projects[0].Name }
					}
				}
			}
		</ol>
	</section>
}

templ homeStep(done bool, title, description string) {
	<li class="row step" data-done?={ done }>
		<div class="min-w-0 flex-1">
			<p class="font-semibold">
				{ title }
				if done {
					<span class="muted font-normal">· Done</span>
				}
			</p>
			<p class="muted text-sm">{ description }</p>
		</div>
		{ children... }
	</li>
}

templ homeActivity(v HomeView) {
	<section class="card" aria-labelledby="home-activity">
		<div class="card-head">
			<div>
				<h2 class="card-title" id="home-activity">Recent activity</h2>
				<p class="muted text-sm">Deployments, and the last backup of each database and run of each scheduled task.</p>
			</div>
		</div>
		if len(v.Events) == 0 {
			@ui.EmptyState(ui.EmptyProps{Icon: "clock", Title: "No activity yet", Text: "Nothing has been deployed, backed up or run yet.", Size: ui.EmptySmall})
		} else {
			<div class="rows">
				for _, e := range v.Events {
					<a class="row rail" data-state={ eventState(e) } href={ templ.SafeURL(eventHref(e)) }>
						@ui.Icon(eventIcon(e.Kind), "text-ink-mute")
						<div class="min-w-0 flex-1">
							<p class="truncate">
								<span class="font-semibold">{ e.Resource }</span>
								{ eventWhat(e) }
							</p>
							<p class="muted truncate text-sm">
								{ e.Project } / { e.Environment } · { ui.StateLabel(e.Trigger) }
								if commit := eventCommit(e); commit != "" {
									· <span class="fact">{ commit }</span>
								}
								if took := ui.Took(e.Started, e.Finished); took != "" {
									· took { took }
								}
							</p>
						</div>
						<span class="muted hidden text-sm whitespace-nowrap sm:inline">{ ui.Ago(e.At) }</span>
						@ui.StatePill(eventState(e), eventLabel(e))
						@ui.Icon("chevron-right", "text-ink-mute")
					</a>
				}
			</div>
		}
	</section>
}

templ homeProjects(v HomeView) {
	<section class="card" aria-labelledby="home-projects">
		<div class="card-head">
			<h2 class="card-title" id="home-projects">Projects</h2>
			if v.Totals.Projects > 0 {
				<a class="text-sm" href="/projects">All { plural(v.Totals.Projects, "project", "projects") }</a>
			}
		</div>
		if len(v.Projects) == 0 {
			@ui.EmptyState(ui.EmptyProps{Icon: "folder", Title: "No projects yet", Text: "A project groups the apps, databases and services of one product.", Size: ui.EmptySmall})
		} else {
			<div class="rows">
				for _, p := range v.Projects {
					<a class="row" href={ templ.SafeURL("/projects/" + p.ID) }>
						@ui.Icon("folder", "text-ink-mute")
						<div class="min-w-0 flex-1">
							<p class="truncate font-semibold">{ p.Name }</p>
							<p class="muted truncate text-sm">{ projectLine(p) }</p>
						</div>
						if p.Down > 0 {
							@ui.Badge(strconv.Itoa(p.Down)+" down", ui.ToneDanger)
						}
						@ui.Icon("chevron-right", "text-ink-mute")
					</a>
				}
			</div>
		}
	</section>
}

templ homeServers(v HomeView) {
	<section class="card" aria-labelledby="home-servers">
		<div class="card-head">
			<h2 class="card-title" id="home-servers">Servers</h2>
			<a class="text-sm" href="/servers">All servers</a>
		</div>
		<div class="rows">
			for _, h := range v.Servers {
				<a class="row flex-col items-stretch" href={ templ.SafeURL("/servers/" + h.Server.ID + "/metrics") }>
					<div class="flex min-w-0 items-center gap-3">
						@ui.Icon("server", "text-ink-mute")
						<div class="min-w-0 flex-1">
							<p class="truncate font-semibold">{ h.Server.Name }</p>
							<p class="fact truncate text-ink-mute">{ serverHost(h.Server) }</p>
						</div>
						if h.Server.Kind == db.ServerLocal {
							@ui.Badge("This machine", ui.ToneBrand)
						} else {
							@ui.Pill(serverTone(h.Server), serverStateLabel(h.Server))
						}
					</div>
					if len(h.Meters) > 0 {
						<div class="grid gap-3">
							for _, m := range h.Meters {
								@ui.Meter(m)
							}
						</div>
					} else {
						<p class="muted text-sm">No recent reading of what it uses.</p>
					}
				</a>
			}
		</div>
	</section>
}
