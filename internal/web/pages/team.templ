package pages

import (
	"github.com/MahmoudDahdouh/musdash-go/internal/db"
	"github.com/MahmoudDahdouh/musdash-go/internal/web/ui"
)

// TeamIntro is what the Team page says under its name, on every tab.
const TeamIntro = "Who can sign in to this musdash, and what each of them may do."

// TeamView is what the Members and the Invitations tabs of the Team page
// show. Each is given only its own list.
type TeamView struct {
	Team        db.Team
	Me          string // the reader's own user id, for Members
	Role        string // and their role
	Members     []db.Member
	Invitations []db.Invitation
	// Link is a link that was just made and is shown this once: an
	// invitation, or a password reset. LinkFor says whose it is.
	Link     string
	LinkFor  string
	LinkKind string // "invitation" or "reset"
}

// RoleLabel is a role as a person reads it.
func RoleLabel(role string) string {
	switch role {
	case db.RoleOwner:
		return "Owner"
	case db.RoleAdmin:
		return "Admin"
	}
	return "Member"
}

func roleTone(role string) string {
	if role == db.RoleOwner {
		return ui.ToneBrand
	}
	return ui.ToneNeutral
}

var roleOptions = []ui.Option{
	{Value: db.RoleMember, Label: "Member"},
	{Value: db.RoleAdmin, Label: "Admin"},
	{Value: db.RoleOwner, Label: "Owner"},
}

func twoStepLabel(on bool) string {
	if on {
		return "On"
	}
	return "Off"
}

templ oneTimeLink(v TeamView) {
	if v.Link != "" {
		@ui.Notice(ui.ToneOK) {
			if v.LinkKind == "reset" {
				<p class="font-semibold">Reset link for { v.LinkFor }</p>
				<p>Send it to them. It works once, within one hour, and is not shown again.</p>
			} else {
				<p class="font-semibold">Invitation link for { v.LinkFor }</p>
				<p>Send it to them. It works once, within seven days, and is not shown again.</p>
			}
			<p class="code mt-2 block break-all">{ v.Link }</p>
			<p class="mt-2">
				<button type="button" class="btn btn-secondary btn-sm" data-copy={ v.Link }>
					@ui.Icon("copy")
					<span data-copy-label>Copy link</span>
				</button>
			</p>
		}
	}
}

// inviteButton opens the dialog that makes an invitation (inviteDialog).
templ inviteButton() {
	@ui.Button(ui.ButtonProps{Variant: ui.Primary, Icon: "plus", Opens: "invite"}) {
		Invite
	}
}

// inviteDialog is on both tabs an Admin can invite from. Whatever its form
// is answered with is the Invitations tab, so only that tab is ever given
// a form that was refused.
templ inviteDialog(s ui.Shell, f ui.Form) {
	@ui.FormDialog(ui.DialogProps{ID: "invite", Title: "Invite someone", Description: "You get a link to send them. It works once, within seven days, and is shown once.", Action: "/team/invitations", CSRF: s.CSRF, Submit: "Create invitation link", Open: !f.OK()}) {
		@ui.Once()
		@ui.TextField(f, "Email", "The address they will sign in with.", ui.InputProps{ID: "email", Type: "email", Required: true, Autocomplete: "off"})
		if s.Owner {
			@ui.Field(ui.FieldProps{Label: "Role", For: "role", Error: f.E("role")}) {
				@ui.Select("role", roleOptions[:2], orDefault(f.V("role"), db.RoleMember), nil)
			}
		}
	}
}

templ Team(s ui.Shell, v TeamView, rename ui.Form) {
	@ui.Layout(s) {
		@ui.PageHeader(v.Team.Name, TeamIntro) {
			if s.Admin {
				@ui.Button(ui.ButtonProps{Icon: "pencil", Opens: "rename-team"}) {
					Rename
				}
				@inviteButton()
			}
		}
		@ui.Tabs(TeamTabs(), "members")
		<div class="grid max-w-4xl gap-6">
			@oneTimeLink(v)
			<section class="card">
				<div class="card-head">
					<div>
						<h2 class="card-title">Members</h2>
						<p class="muted text-sm">A Member works with projects and what is in them. An Admin also manages servers, sources, settings and invitations. An Owner also decides who holds which role.</p>
					</div>
				</div>
				@ui.Table("Name", "Role", "Second step", "Joined", "") {
					for _, m := range v.Members {
						<tr>
							<td>
								<p class="font-semibold">
									{ m.Name }
									if m.UserID == v.Me {
										<span class="muted font-normal">(you)</span>
									}
								</p>
								<p class="muted text-sm break-all">{ m.Email }</p>
							</td>
							<td>
								if s.Owner {
									<form class="flex items-center gap-2" method="post" action={ templ.SafeURL("/team/members/" + m.UserID + "/role") }>
										@ui.CSRF(s.CSRF)
										<label class="sr-only" for={ "role-" + m.UserID }>Role of { m.Name }</label>
										@ui.SelectNamed("role-"+m.UserID, "role", roleOptions, m.Role, nil)
										@ui.Button(ui.ButtonProps{Small: true, Type: "submit", Attrs: ui.Ask("Change the role of "+m.Name+"?", "A higher role signs them out everywhere and ends their reset links and API tokens. A lower one withdraws the invitations they made.", "Change role", false)}) {
											Save
										}
									</form>
								} else {
									@ui.Badge(RoleLabel(m.Role), roleTone(m.Role))
								}
							</td>
							<td>{ twoStepLabel(m.TwoStep) }</td>
							<td class="whitespace-nowrap">{ ui.Ago(m.JoinedAt) }</td>
							<td>
								if db.CanManage(v.Role, v.Me, m) {
									<div class="flex flex-wrap justify-end gap-2">
										<form method="post" action={ templ.SafeURL("/team/members/" + m.UserID + "/reset") }>
											@ui.CSRF(s.CSRF)
											@ui.Once()
											@ui.Button(ui.ButtonProps{Small: true, Type: "submit", Icon: "key", Attrs: ui.Ask("Make a reset link for "+m.Name+"?", "Whoever opens the link chooses a new password for this account. It is shown once, right after it is made.", "Make reset link", false)}) {
												Reset link
											}
										</form>
										if m.TwoStep {
											<form method="post" action={ templ.SafeURL("/team/members/" + m.UserID + "/two-step-off") }>
												@ui.CSRF(s.CSRF)
												@ui.Button(ui.ButtonProps{Small: true, Type: "submit", Icon: "lock", Attrs: ui.Ask("Turn off the second step of "+m.Name+"?", "Their password alone signs them in from now on, and their recovery codes are deleted. They can set it up again from their Account page.", "Turn off second step", true)}) {
													Turn off second step
												}
											</form>
										}
										@ui.Confirm(ui.ConfirmProps{
											ID: "remove-" + m.UserID, Title: "Remove " + m.Name, Action: "/team/members/" + m.UserID + "/delete",
											CSRF: s.CSRF, Match: m.Email, Submit: "Remove member", Trigger: "Remove",
										}) {
											<p>{ m.Name } is signed out everywhere and their account, API tokens and second step are deleted. Invitations they made stop working. What they deployed stays. To let them back in, invite them again.</p>
										}
									</div>
								}
							</td>
						</tr>
					}
				}
			</section>
		</div>
		if s.Admin {
			@inviteDialog(s, ui.Form{})
			@ui.FormDialog(ui.DialogProps{ID: "rename-team", Title: "Rename team", Action: "/team", CSRF: s.CSRF, Submit: "Save name", Open: !rename.OK()}) {
				@ui.TextField(rename, "Name", "", ui.InputProps{ID: "team-name", Name: "name", Value: v.Team.Name, Required: true, Attrs: templ.Attributes{"maxlength": "60"}})
			}
		}
	}
}

// TeamInvitations is the Invitations tab of the Team page: who was sent a
// link and has not used it yet.
templ TeamInvitations(s ui.Shell, v TeamView, invite ui.Form) {
	@ui.Layout(s) {
		@ui.PageHeader(v.Team.Name, TeamIntro) {
			if s.Admin && len(v.Invitations) > 0 {
				@inviteButton()
			}
		}
		@ui.Tabs(TeamTabs(), "invitations")
		<div class="grid max-w-4xl gap-6">
			@oneTimeLink(v)
			if len(v.Invitations) > 0 {
				<section class="card">
					@ui.Table("Email", "Role", "Invited by", "Made", "Expires", "") {
						for _, inv := range v.Invitations {
							<tr>
								<td class="min-w-56 font-semibold break-all">{ inv.Email }</td>
								<td>
									@ui.Badge(RoleLabel(inv.Role), roleTone(inv.Role))
								</td>
								<td>
									if inv.InviterName != "" {
										{ inv.InviterName }
									} else {
										<span class="muted">Unknown</span>
									}
								</td>
								<td class="whitespace-nowrap">{ upperFirst(ui.Ago(inv.CreatedAt)) }</td>
								<td class="whitespace-nowrap">{ upperFirst(ui.Until(inv.ExpiresAt)) }</td>
								<td class="text-right">
									if s.Admin {
										<form method="post" action={ templ.SafeURL("/team/invitations/" + inv.ID + "/delete") }>
											@ui.CSRF(s.CSRF)
											@ui.Button(ui.ButtonProps{Variant: ui.DangerQuiet, Small: true, Type: "submit", Attrs: ui.Ask("Cancel the invitation of "+inv.Email+"?", "The link stops working at once.", "Cancel invitation", true)}) {
												Cancel
											}
										</form>
									}
								</td>
							</tr>
						}
					}
				</section>
			} else {
				@ui.EmptyState(ui.EmptyProps{Icon: "mail", Title: "Nobody is invited at the moment", Text: inviteHint(s.Admin)}) {
					if s.Admin {
						@inviteButton()
					}
				}
			}
		</div>
		if s.Admin {
			@inviteDialog(s, invite)
		}
	}
}

// Invite is the page an invitation link opens: it creates the account.
templ Invite(f ui.Form, csrf, token string, inv db.Invitation, team string) {
	@ui.AuthLayout("Join "+team, nil) {
		@authCard("Join "+team, "You were invited as "+RoleLabel(inv.Role)+". Choose how you sign in.", "/invite/"+token, csrf, "Create account") {
			if f.E("form") != "" {
				@ui.Notice(ui.ToneDanger) {
					{ f.E("form") }
				}
			}
			@ui.Field(ui.FieldProps{Label: "Email", For: "email"}) {
				@ui.Input(ui.InputProps{ID: "email", Type: "email", Value: inv.Email, Disabled: true, Autocomplete: "username"})
			}
			@ui.TextField(f, "Name", "", ui.InputProps{ID: "name", Autocomplete: "name", Required: true, Autofocus: true})
			@ui.TextField(f, "Password", "10 to 72 characters.", ui.InputProps{ID: "password", Type: "password", Autocomplete: "new-password", Required: true})
		}
	}
}

// InviteInvalid is shown for an unknown, used, cancelled or expired link.
templ InviteInvalid() {
	@ui.AuthLayout("Invitation", nil) {
		@ui.Notice(ui.ToneWarn) {
			<p class="font-semibold">This invitation has expired, was cancelled or was already used.</p>
			<p class="muted mt-1">Ask whoever invited you for a new link.</p>
		}
		<p><a href="/login">Go to sign in</a></p>
	}
}

// inviteHint is what the empty list of invitations says to do about it.
func inviteHint(admin bool) string {
	if admin {
		return "Invite someone with a link. Whoever opens it chooses a name and a password and becomes a member."
	}
	return "An Admin can invite someone."
}

// Forbidden is the page for a request the person's role does not allow.
templ Forbidden(s ui.Shell, needs string) {
	@ui.Layout(s) {
		@ui.EmptyState(ui.EmptyProps{Icon: "lock", Title: "Your role does not allow this", Text: "It needs " + needs + " of the team. Ask one of them to do it, or to change your role.", Size: ui.EmptyPage}) {
			@ui.LinkButton("/team", ui.ButtonProps{Variant: ui.Primary}) {
				See who is in the team
			}
		}
	}
}
