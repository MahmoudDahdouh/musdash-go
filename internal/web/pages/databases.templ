package pages

import (
	"strconv"

	"github.com/MahmoudDahdouh/musdash-go/internal/catalog"
	"github.com/MahmoudDahdouh/musdash-go/internal/db"
	"github.com/MahmoudDahdouh/musdash-go/internal/web/ui"
)

// DatabaseView is what every database page needs for its frame.
type DatabaseView struct {
	DB      db.Database
	Project db.Project
	Env     db.Environment
	Engine  catalog.DBTemplate
}

func (v DatabaseView) base() string { return "/databases/" + v.DB.ID }

func databaseTabs(v DatabaseView) []ui.Tab {
	b := v.base()
	return []ui.Tab{
		{Key: "overview", Label: "Overview", Href: b},
		{Key: "logs", Label: "Logs", Href: b + "/logs"},
		{Key: "metrics", Label: "Metrics", Href: b + "/metrics"},
		{Key: "backups", Label: "Backups", Href: b + "/backups"},
		{Key: "settings", Label: "Settings", Href: b + "/settings"},
	}
}

// engineLabel is the engine's display name, or its key for an engine this
// version no longer knows.
func engineLabel(engine string) string {
	if t, ok := catalog.Database(engine); ok {
		return t.Label
	}
	return engine
}

// databaseState is the state a database's pill and rail show. A database
// has no deployments: while its container is being replaced it is starting.
func databaseState(m db.Database) string {
	switch m.Status {
	case db.AppDeploying:
		return "starting"
	case db.AppCreated:
		return "stopped"
	}
	return m.Status
}

func databasePoll(m db.Database) string {
	if m.Status == db.AppDeploying {
		return "every 2s"
	}
	return "every 15s"
}

// DatabaseHeader is the database's name, status and actions. Like an app's
// header it refreshes itself, so the page follows a start without a reload.
templ DatabaseHeader(csrf string, m db.Database) {
	<header
		id="database-header"
		class="mb-5 flex flex-wrap items-start justify-between gap-x-6 gap-y-3"
		hx-get={ "/databases/" + m.ID + "/status?was=" + m.Status }
		hx-trigger={ databasePoll(m) }
		hx-swap="outerHTML"
	>
		<div class="min-w-0">
			<div class="flex flex-wrap items-center gap-x-3 gap-y-1">
				<h1 class="text-xl font-semibold tracking-tight">{ m.Name }</h1>
				@ui.StatusPill(databaseState(m))
			</div>
			<p class="mt-0.5 truncate text-ink-mute">{ engineLabel(m.Engine) } <span class="fact">{ m.Image }</span></p>
		</div>
		if m.Status != db.AppDeploying {
			<div class="flex flex-wrap items-center gap-2">
				if m.Container != "" {
					<form method="post" action={ templ.SafeURL("/databases/" + m.ID + "/stop") }>
						@ui.CSRF(csrf)
						@ui.Button(ui.ButtonProps{Type: "submit", Icon: "stop"}) {
							Stop
						}
					</form>
					<form method="post" action={ templ.SafeURL("/databases/" + m.ID + "/start") }>
						@ui.CSRF(csrf)
						@ui.Button(ui.ButtonProps{Type: "submit", Icon: "refresh"}) {
							Restart
						}
					</form>
				} else {
					<form method="post" action={ templ.SafeURL("/databases/" + m.ID + "/start") }>
						@ui.CSRF(csrf)
						@ui.Button(ui.ButtonProps{Variant: ui.Primary, Type: "submit", Icon: "play"}) {
							Start
						}
					</form>
				}
			</div>
		}
	</header>
}

templ databaseFrame(s ui.Shell, v DatabaseView, tab string) {
	@ui.Layout(s) {
		@DatabaseHeader(s.CSRF, v.DB)
		@ui.Tabs(databaseTabs(v), tab)
		{ children... }
	}
}

// DatabaseRows lists an environment's databases on the project page.
templ DatabaseRows(list []db.Database) {
	<div class="card rows">
		for _, m := range list {
			<a class="row rail" data-state={ databaseState(m) } href={ templ.SafeURL("/databases/" + m.ID) }>
				@ui.Icon("database", "text-ink-mute")
				<div class="min-w-0 flex-1">
					<p class="truncate font-semibold">{ m.Name }</p>
					<p class="truncate text-ink-mute">{ engineLabel(m.Engine) } <span class="fact">{ m.Image }</span></p>
				</div>
				if m.PublicPort > 0 {
					@ui.Badge("Public", ui.ToneWarn)
				}
				@ui.StatusPill(databaseState(m))
				@ui.Icon("chevron-right", "text-ink-mute")
			</a>
		}
	</div>
}

// DatabaseEngines is the first step of creating a database: which engine.
templ DatabaseEngines(s ui.Shell, p db.Project, env db.Environment, engines []catalog.DBTemplate) {
	@ui.Layout(s) {
		@ui.PageHeader("New database", "Runs in "+env.Name+". Choose an engine.")
		<div class="grid max-w-3xl gap-3 sm:grid-cols-2">
			for _, t := range engines {
				<a class="card row" href={ templ.SafeURL("/projects/" + p.ID + "/databases/new?env=" + env.ID + "&engine=" + t.Engine) }>
					@ui.Icon("database", "text-ink-mute")
					<div class="min-w-0 flex-1">
						<p class="font-semibold">{ t.Label }</p>
						<p class="muted text-sm">{ t.About }</p>
					</div>
					@ui.Icon("chevron-right", "text-ink-mute")
				</a>
			}
		</div>
	}
}

// DatabaseNew is the second step: a name, and the choices with a default.
templ DatabaseNew(s ui.Shell, p db.Project, env db.Environment, t catalog.DBTemplate, f ui.Form, serverList []db.Server) {
	@ui.Layout(s) {
		@ui.PageHeader("New "+t.Label+" database", "Runs in "+env.Name+".")
		<div class="max-w-xl">
			<form class="card" method="post" action={ templ.SafeURL("/projects/" + p.ID + "/databases") }>
				@ui.CSRF(s.CSRF)
				<input type="hidden" name="env" value={ env.ID }/>
				<input type="hidden" name="engine" value={ t.Engine }/>
				<div class="card-body grid gap-4">
					@ui.TextField(f, "Name", "Lowercase letters, numbers and hyphens. Apps in this environment connect to the database by this name.", ui.InputProps{ID: "name", Mono: true, Required: true, Autofocus: true, Value: t.Engine, Attrs: templ.Attributes{"maxlength": "32"}})
					@ui.TextField(f, "Docker image", "Change the tag to choose another version.", ui.InputProps{ID: "image", Mono: true, Required: true, Value: t.Image})
					@ServerChoice(f, serverList)
					<p class="muted text-sm">A user, a 32-character password and a data volume are created for you. The connection string is on the database's page.</p>
					<div>
						@ui.Checkbox("public", f.V("public") == "1", nil) {
							Also make it reachable from the internet, on a port of the server
						}
						if f.E("public") != "" {
							<p class="field-error mt-1" role="alert">{ f.E("public") }</p>
						}
					</div>
				</div>
				<div class="card-foot">
					@ui.LinkButton("/projects/"+p.ID+"/databases/new?env="+env.ID, ui.ButtonProps{}) {
						Back
					}
					@ui.Button(ui.ButtonProps{Variant: ui.Primary, Type: "submit"}) {
						Create database
					}
				</div>
			</form>
		</div>
	}
}

// Connection is how a database is reached, with its password opened. It is
// built for the database's own Overview page and nowhere else.
type Connection struct {
	Host     string // the name on the environment's network
	Port     int
	User     string
	Password string
	DBName   string
	URL      string
	// PublicURL is empty while the public port is off.
	PublicURL  string
	PublicHost string
	// Undecryptable is set when the password could not be opened.
	Undecryptable bool
}

func limitText(memoryMB int, cpus float64) string {
	switch {
	case memoryMB > 0 && cpus > 0:
		return strconv.Itoa(memoryMB) + " MB, " + cpusValue(cpus) + " CPU"
	case memoryMB > 0:
		return strconv.Itoa(memoryMB) + " MB"
	case cpus > 0:
		return cpusValue(cpus) + " CPU"
	}
	return "none"
}

templ DatabaseOverview(s ui.Shell, v DatabaseView, server db.Server, c Connection, volume string) {
	@databaseFrame(s, v, "overview") {
		<div class="grid gap-6 lg:grid-cols-2">
			if v.DB.Status == db.AppFailed && v.DB.LastError != "" {
				<div class="lg:col-span-2">
					@ui.Notice(ui.ToneDanger) {
						<p class="font-semibold">The database did not start</p>
						if v.DB.Container != "" {
							<p>Its container is still there: the Logs tab shows what it is doing, and Stop removes it.</p>
						}
						<p class="break-words">{ v.DB.LastError }</p>
					}
				</div>
			}
			if c.Undecryptable {
				<div class="lg:col-span-2">
					@ui.Notice(ui.ToneDanger) {
						<p>The stored password cannot be decrypted. Was the master key changed?</p>
					}
				</div>
			} else {
				<section class="card lg:col-span-2">
					<div class="card-head">
						<div>
							<h2 class="card-title">Connect from this environment</h2>
							<p class="muted text-sm">Apps in { v.Env.Name } reach the database by its name. Paste this into an app's variables.</p>
						</div>
					</div>
					<div class="card-body grid min-w-0 gap-4">
						@ui.Secret(c.URL, c.Password)
						<dl class="kv">
							<dt>Host</dt>
							<dd class="fact">{ c.Host }</dd>
							<dt>Port</dt>
							<dd class="fact">{ strconv.Itoa(c.Port) }</dd>
							<dt>User</dt>
							<dd class="fact">{ c.User }</dd>
							if c.DBName != "" {
								<dt>Database</dt>
								<dd class="fact">{ c.DBName }</dd>
							}
							<dt>Password</dt>
							<dd>
								@ui.Secret(c.Password, c.Password)
							</dd>
						</dl>
					</div>
				</section>
				<section class="card">
					<div class="card-head">
						<h2 class="card-title">Connect from outside</h2>
						@ui.LinkButton(v.base()+"/settings", ui.ButtonProps{Variant: ui.Ghost, Small: true}) {
							Change
						}
					</div>
					<div class="card-body grid min-w-0 gap-3">
						if c.PublicURL == "" {
							<p class="muted">Only this environment can reach the database. Switch on the public port in Settings to connect from your own machine.</p>
						} else {
							@ui.Secret(c.PublicURL, c.Password)
							<p class="muted text-sm">
								Port <span class="fact">{ strconv.Itoa(v.DB.PublicPort) }</span> of the server is open to anyone who has the password. Docker opens it past ufw and firewalld; only a firewall in front of the server, such as your provider's, can narrow who reaches it.
								if c.PublicHost == "SERVER_IP" {
									Replace SERVER_IP with the server's address, or set it under Servers.
								}
							</p>
						}
					</div>
				</section>
			}
			<section class="card">
				<div class="card-head">
					<h2 class="card-title">Running now</h2>
				</div>
				<div class="card-body">
					@ui.KeyValue([]ui.KVItem{
						{Key: "Engine", Value: v.Engine.Label},
						{Key: "Image", Value: v.DB.Image, Mono: true},
						{Key: "Server", Value: server.Name},
						{Key: "Container", Value: orNone(v.DB.Container), Mono: true},
						{Key: "Data volume", Value: volume, Mono: true},
						{Key: "Limits", Value: limitText(v.DB.MemoryMB, v.DB.CPUs)},
					})
				</div>
			</section>
		</div>
	}
}

templ DatabaseLogs(s ui.Shell, v DatabaseView) {
	@databaseFrame(s, v, "logs") {
		if v.DB.Container == "" {
			@ui.EmptyState("terminal", "Nothing is running", "The database's output appears here once it is started.")
		} else {
			<div class="grid gap-2">
				<p class="muted text-sm">The last 200 lines, then new output as it arrives.</p>
				@ui.LogView("runtime-log", templ.Attributes{
					"hx-ext":      "sse",
					"sse-connect": v.base() + "/logs/stream",
					"sse-swap":    "line",
					"sse-close":   "done",
					"hx-swap":     "beforeend",
				})
			</div>
		}
	}
}

func publicPortValue(f ui.Form, m db.Database) string {
	if v, ok := f.Values["public_port"]; ok {
		return v
	}
	return zeroBlank(m.PublicPort)
}

templ DatabaseSettings(s ui.Shell, v DatabaseView, f ui.Form, volume string) {
	@databaseFrame(s, v, "settings") {
		<div class="grid max-w-2xl gap-6">
			@ui.FormCard("Settings", "Saving a change restarts a running database to apply it: expect a few seconds during which it does not answer.", v.base()+"/settings", s.CSRF, "Save changes") {
				@ui.TextField(f, "Docker image", "Change the tag to move to another version of the same major release. An image already on the server is not downloaded again. A new major version usually cannot open the old data: create a new database and move the data instead.", ui.InputProps{ID: "image", Mono: true, Required: true, Value: v.DB.Image})
				@ui.Checkbox("public", checked(f, "public", v.DB.PublicPort > 0), nil) {
					Reachable from the internet, on a port of the server
				}
				@ui.TextField(f, "Public port", "Leave it empty and musdash picks a free one. Use 1024 to 65535, outside 20000 to 29999.", ui.InputProps{ID: "public_port", Mono: true, Value: publicPortValue(f, v.DB), Attrs: templ.Attributes{"inputmode": "numeric"}})
				<div class="grid gap-4 sm:grid-cols-2">
					@ui.TextField(f, "Memory limit (MB)", "Empty for no limit.", ui.InputProps{ID: "memory_mb", Mono: true, Value: zeroBlank(v.DB.MemoryMB), Attrs: templ.Attributes{"inputmode": "numeric"}})
					@ui.TextField(f, "CPU limit (cores)", "Such as 0.5 or 2. Empty for no limit.", ui.InputProps{ID: "cpus", Mono: true, Value: cpusValue(v.DB.CPUs), Attrs: templ.Attributes{"inputmode": "decimal"}})
				</div>
			}
			<section class="card card-danger">
				<div class="card-head">
					<div>
						<h2 class="card-title">Delete database</h2>
						<p class="muted text-sm">Stops the database and removes it from musdash. Its data is kept unless you choose otherwise.</p>
					</div>
					@ui.Confirm(ui.ConfirmProps{
						ID:      "delete-database",
						Title:   "Delete database",
						Action:  v.base() + "/delete",
						CSRF:    s.CSRF,
						Match:   v.DB.Name,
						Submit:  "Delete database",
						Trigger: "Delete database",
					}) {
						<div class="grid gap-3">
							<p><strong>{ v.DB.Name }</strong> is stopped and removed, with its password. Apps that connect to it will fail.</p>
							<p>Its data stays on the server in the Docker volume <span class="code">{ volume }</span> unless you tick the box.</p>
							@ui.Checkbox("delete_data", false, nil) {
								Also delete the data. This cannot be undone.
							}
						</div>
					}
				</div>
			</section>
		</div>
	}
}
