package pages

import (
	"strconv"
	"strings"
	"time"

	"github.com/MahmoudDahdouh/musdash-go/internal/db"
	"github.com/MahmoudDahdouh/musdash-go/internal/notify"
	"github.com/MahmoudDahdouh/musdash-go/internal/ops"
	"github.com/MahmoudDahdouh/musdash-go/internal/web/static"
	"github.com/MahmoudDahdouh/musdash-go/internal/web/ui"
)

// scheduleHint explains the schedule field wherever one appears.
const scheduleHint = "Five fields: minute, hour, day of month, month, day of week, as in cron. 0 3 * * * is every day at 03:00. Also @hourly, @daily, @weekly, @monthly. Times are in UTC."

// nextRun words a schedule's next time.
func nextRun(enabled bool, unix int64) string {
	switch {
	case !enabled:
		return "Switched off"
	case unix <= 0:
		return "Not scheduled"
	}
	return time.Unix(unix, 0).UTC().Format("2 Jan 2006, 15:04") + " UTC"
}

// BackupsView is what the Backups tab shows.
type BackupsView struct {
	Config   db.BackupConfig // zero when none was saved
	HasCfg   bool
	Storages []db.S3Storage
	List     []db.Backup
}

func (b BackupsView) storageName(id string) string {
	for _, s := range b.Storages {
		if s.ID == id {
			return s.Name
		}
	}
	return ""
}

func storageOptions(list []db.S3Storage) []ui.Option {
	opts := []ui.Option{{Value: "", Label: "Keep on this server only"}}
	for _, s := range list {
		opts = append(opts, ui.Option{Value: s.ID, Label: s.Name + " (" + s.Bucket + ")"})
	}
	return opts
}

func backupNext(b BackupsView) string {
	if !b.HasCfg {
		return "Not scheduled"
	}
	return nextRun(b.Config.Enabled, b.Config.NextRun)
}

func backupSchedule(f ui.Form, b BackupsView) string {
	if v, ok := f.Values["schedule"]; ok {
		return v
	}
	if b.HasCfg {
		return b.Config.Schedule
	}
	return "0 3 * * *"
}

func backupKeep(f ui.Form, b BackupsView) string {
	if v, ok := f.Values["keep"]; ok {
		return v
	}
	if b.HasCfg {
		return strconv.Itoa(b.Config.Keep)
	}
	return strconv.Itoa(ops.DefaultKeep)
}

// backupBusy reports whether the list should keep refreshing.
func backupBusy(list []db.Backup) bool {
	for _, b := range list {
		if b.Status == db.RunRunning || b.RestoreStatus == db.RunRunning {
			return true
		}
	}
	return false
}

// backupPoll is how often the list asks for itself: only while a backup or
// a restore is going.
func backupPoll(list []db.Backup) string {
	if backupBusy(list) {
		return "every 2s"
	}
	return ""
}

func backupWhere(v BackupsView, b db.Backup) string {
	if b.Status != db.RunSuccess {
		return ""
	}
	if name := v.storageName(b.StorageID); name != "" {
		return "Server and " + name
	}
	return "Server"
}

templ DatabaseBackups(s ui.Shell, v DatabaseView, b BackupsView, f ui.Form) {
	@databaseFrame(s, v, "backups") {
		<div class="grid gap-6">
			if v.Engine.DumpCmd == "" {
				@ui.Notice(ui.ToneWarn) {
					<p class="font-semibold">musdash cannot back up { v.Engine.Label } yet</p>
					<p>Its data is in the Docker volume of this database. Back it up with the engine's own tools, or with a snapshot of the server.</p>
				}
			} else {
				<div class="grid gap-6 lg:grid-cols-2 lg:items-start">
					<section class="card">
						<div class="card-head">
							<div>
								<h2 class="card-title">Schedule</h2>
								<p class="muted text-sm">A backup is a dump made by the database's own tool, compressed and kept on this server. The newest ones are kept; older ones are removed.</p>
							</div>
							if b.HasCfg {
								@ui.Button(ui.ButtonProps{Small: true, Icon: "pencil", Opens: "edit-schedule"}) {
									Change
								}
							}
						</div>
						if b.HasCfg {
							<div class="card-body">
								@ui.KeyValue([]ui.KVItem{
									{Key: "Scheduled", Value: yesNo(b.Config.Enabled, "On", "Off")},
									{Key: "Schedule", Value: b.Config.Schedule, Mono: true},
									{Key: "Backups kept", Value: strconv.Itoa(b.Config.Keep)},
									{Key: "Copied to", Value: optionLabel(storageOptions(b.Storages), b.Config.StorageID)},
								})
							</div>
						} else {
							@ui.EmptyState(ui.EmptyProps{Icon: "clock", Title: "No schedule yet", Text: "This database is backed up only when you choose Back up now.", Size: ui.EmptySmall}) {
								@ui.Button(ui.ButtonProps{Variant: ui.Primary, Small: true, Opens: "edit-schedule"}) {
									Set up
								}
							}
						}
					</section>
					@ui.FormDialog(ui.DialogProps{ID: "edit-schedule", Title: "Backup schedule", Action: v.Path() + "/backups/schedule", CSRF: s.CSRF, Submit: "Save schedule", Open: !f.OK()}) {
						@ui.Checkbox("enabled", checked(f, "enabled", !b.HasCfg || b.Config.Enabled), nil) {
							Back up on a schedule
						}
						@ui.TextField(f, "Schedule", scheduleHint, ui.InputProps{ID: "schedule", Mono: true, Required: true, Value: backupSchedule(f, b)})
						@ui.TextField(f, "Backups to keep", "From 1 to 365.", ui.InputProps{ID: "keep", Mono: true, Required: true, Value: backupKeep(f, b), Attrs: templ.Attributes{"inputmode": "numeric"}})
						@ui.Field(ui.FieldProps{Label: "Copy to", For: "storage_id", Hint: "A copy off the server survives the server. Add a bucket under Settings, Backup storage.", Error: f.E("storage_id")}) {
							@ui.Select("storage_id", storageOptions(b.Storages), orDefault(f.V("storage_id"), b.Config.StorageID), templ.Attributes{"aria-describedby": "storage_id-hint"})
						}
					}
					<section class="card">
						<div class="card-head">
							<div>
								<h2 class="card-title">Back up now</h2>
								<p class="muted text-sm">Next scheduled backup: <span class="fact">{ backupNext(b) }</span></p>
							</div>
							<form method="post" action={ templ.SafeURL(v.Path() + "/backups") }>
								@ui.CSRF(s.CSRF)
								@ui.Button(ui.ButtonProps{Variant: ui.Primary, Type: "submit", Disabled: v.DB.Status != db.AppRunning}) {
									Back up now
								}
							</form>
						</div>
						if v.DB.Status != db.AppRunning {
							<p class="card-body muted">The database has to be running to be backed up.</p>
						} else {
							<p class="card-body muted">The database keeps answering while the dump is made.</p>
						}
					</section>
				</div>
			}
			@BackupList(s.CSRF, v, b)
		</div>
	}
}

// BackupList is the table of backups. It refreshes itself while a backup or
// a restore is going.
templ BackupList(csrf string, v DatabaseView, b BackupsView) {
	<section
		class="card"
		id="backup-list"
		{ ui.Poll(ctx, v.Path()+"/backups/list", backupPoll(b.List), backupListBody(csrf, v, b))... }
	>
		@backupListBody(csrf, v, b)
	</section>
}

// backupListBody is what the list shows, and so what its poll compares.
templ backupListBody(csrf string, v DatabaseView, b BackupsView) {
	<div class="card-head">
		<h2 class="card-title">Backups</h2>
	</div>
	if len(b.List) == 0 {
		@ui.EmptyState(ui.EmptyProps{Icon: "archive", Title: "No backup has been made yet", Text: "Backups are listed here as they are made.", Size: ui.EmptySmall})
	} else {
		@ui.Table("Made", "Status", "Size", "Kept on", "") {
			for _, m := range b.List {
				<tr>
					<td class="whitespace-nowrap">
						{ ui.Ago(m.StartedAt) }
						<span class="muted">· { ui.StateLabel(m.Trigger) }</span>
					</td>
					<td>
						@ui.JobPill(m.Status)
						if m.Error != "" {
							<p class="muted mt-1 max-w-md break-words text-sm">{ m.Error }</p>
						}
						if m.RestoreStatus == db.RunRunning {
							<p class="mt-1 text-sm">Being restored…</p>
						} else if m.RestoreStatus == db.RunSuccess {
							<p class="muted mt-1 text-sm">Restored { ui.Ago(m.RestoredAt) }</p>
						} else if m.RestoreStatus == db.RunFailed {
							<p class="mt-1 max-w-md break-words text-sm text-danger">Restore failed: { m.RestoreError }</p>
						}
					</td>
					<td class="fact whitespace-nowrap">
						if m.Status == db.RunSuccess {
							{ ops.HumanSize(m.Size) }
						}
					</td>
					<td>{ backupWhere(b, m) }</td>
					<td class="text-right">
						if m.Status == db.RunSuccess && m.RestoreStatus != db.RunRunning {
							<div class="flex justify-end gap-2">
								@ui.LinkButton(v.Path()+"/backups/"+m.ID+"/download", ui.ButtonProps{Variant: ui.Ghost, Small: true}) {
									Download
								}
								if v.Engine.RestoreCmd != "" {
									@ui.Button(ui.ButtonProps{Variant: ui.Ghost, Small: true, Attrs: templ.Attributes{"data-open": "restore-" + m.ID}}) {
										Restore
									}
								}
								<form method="post" action={ templ.SafeURL(v.Path() + "/backups/" + m.ID + "/delete") }>
									@ui.CSRF(csrf)
									@ui.Button(ui.ButtonProps{Variant: ui.DangerQuiet, Small: true, Type: "submit", Attrs: ui.Ask("Delete this backup?", "The backup made "+ui.Ago(m.StartedAt)+" is deleted from this server and from the bucket it was uploaded to. This cannot be undone.", "Delete backup", true)}) {
										Delete
									}
								</form>
							</div>
						} else if m.Status == db.RunFailed {
							<form method="post" action={ templ.SafeURL(v.Path() + "/backups/" + m.ID + "/delete") }>
								@ui.CSRF(csrf)
								@ui.Button(ui.ButtonProps{Variant: ui.Ghost, Small: true, Type: "submit"}) {
									Dismiss
								}
							</form>
						}
					</td>
				</tr>
			}
		}
	}
	for _, m := range b.List {
		if m.Status == db.RunSuccess && v.Engine.RestoreCmd != "" {
			@ui.Modal("restore-"+m.ID, "Restore this backup") {
				<form method="post" action={ templ.SafeURL(v.Path() + "/backups/" + m.ID + "/restore") }>
					@ui.CSRF(csrf)
					<div class="card-body grid gap-4">
						<div class="grid gap-3 text-ink-soft">
							<p>The content of <strong>{ v.DB.Name }</strong> is replaced with what it held { ui.Ago(m.StartedAt) }. Everything written since then is lost.</p>
							<p>The database keeps running. Apps that use it may see errors until the restore has finished.</p>
						</div>
						@ui.Field(ui.FieldProps{Label: "Type " + v.DB.Name + " to confirm", For: "restore-" + m.ID + "-confirm"}) {
							@ui.Input(ui.InputProps{ID: "restore-" + m.ID + "-confirm", Name: "confirm", Mono: true, Autocomplete: "off", Required: true, Attrs: templ.Attributes{"data-match": v.DB.Name}})
						}
					</div>
					<div class="card-foot">
						@ui.Button(ui.ButtonProps{Attrs: templ.Attributes{"data-close": true}}) {
							Cancel
						}
						@ui.Button(ui.ButtonProps{Variant: ui.Danger, Type: "submit", Disabled: true}) {
							Restore backup
						}
					</div>
				</form>
			}
		}
	}
}

// TaskRow is a task with its latest run, for the list.
type TaskRow struct {
	Task db.Task
	Last *db.TaskRun
}

templ AppTasks(s ui.Shell, v AppView, rows []TaskRow, f ui.Form) {
	@appFrame(s, v, "tasks") {
		<div class="grid max-w-4xl gap-6">
			<section class="card">
				<div class="card-head">
					<div>
						<h2 class="card-title">Scheduled tasks</h2>
						<p class="muted text-sm">Commands musdash runs inside the app's running container, on a schedule.</p>
					</div>
					if len(rows) > 0 {
						@ui.Button(ui.ButtonProps{Small: true, Icon: "plus", Opens: "add-task"}) {
							Add task
						}
					}
				</div>
				if len(rows) == 0 {
					@ui.EmptyState(ui.EmptyProps{Icon: "clock", Title: "No tasks yet", Text: "A task is the place for what a cron job would do: clearing a cache, sending a digest, running a framework's scheduler.", Size: ui.EmptySmall}) {
						@ui.Button(ui.ButtonProps{Variant: ui.Primary, Small: true, Icon: "plus", Opens: "add-task"}) {
							Add task
						}
					}
				} else {
					@ui.Table("Task", "Schedule", "Next run", "Last run", "") {
						for _, row := range rows {
							<tr>
								<td>
									<a class="link font-semibold" href={ templ.SafeURL(v.Path() + "/tasks/" + row.Task.ID) }>{ row.Task.Name }</a>
									<p class="fact muted max-w-xs truncate">{ row.Task.Command }</p>
								</td>
								<td class="fact whitespace-nowrap">{ row.Task.Schedule }</td>
								<td class="whitespace-nowrap">{ nextRun(row.Task.Enabled, row.Task.NextRun) }</td>
								<td class="whitespace-nowrap">
									if row.Last == nil {
										<span class="muted">Never</span>
									} else {
										@ui.JobPill(row.Last.Status)
										<span class="muted">{ ui.Ago(row.Last.StartedAt) }</span>
									}
								</td>
								<td class="text-right">
									<form method="post" action={ templ.SafeURL(v.Path() + "/tasks/" + row.Task.ID + "/run") }>
										@ui.CSRF(s.CSRF)
										@ui.Button(ui.ButtonProps{Variant: ui.Ghost, Small: true, Type: "submit"}) {
											Run now
										}
									</form>
								</td>
							</tr>
						}
					}
				}
			</section>
			@ui.FormDialog(ui.DialogProps{ID: "add-task", Title: "Add a task", Action: v.Path() + "/tasks", CSRF: s.CSRF, Submit: "Add task", Open: !f.OK()}) {
				@taskFields(f, db.Task{Enabled: true})
			}
		</div>
	}
}

func taskValue(f ui.Form, key, stored string) string {
	if v, ok := f.Values[key]; ok {
		return v
	}
	return stored
}

templ taskFields(f ui.Form, t db.Task) {
	@ui.TextField(f, "Name", "What the task is for, such as Nightly digest.", ui.InputProps{ID: "name", Required: true, Value: taskValue(f, "name", t.Name)})
	@ui.TextField(f, "Command", "Run with sh -c in the app's container, as the container's user and in its working directory.", ui.InputProps{ID: "command", Mono: true, Required: true, Value: taskValue(f, "command", t.Command), Placeholder: "php artisan schedule:run"})
	@ui.TextField(f, "Schedule", scheduleHint, ui.InputProps{ID: "schedule", Mono: true, Required: true, Value: taskValue(f, "schedule", t.Schedule), Placeholder: "*/5 * * * *"})
	@ui.Checkbox("enabled", checked(f, "enabled", t.Enabled), nil) {
		Run on this schedule
	}
}

func runBusy(runs []db.TaskRun) bool {
	for _, r := range runs {
		if r.Status == db.RunRunning {
			return true
		}
	}
	return false
}

// runPoll is how often the history asks for itself: only while a run is
// going.
func runPoll(runs []db.TaskRun) string {
	if runBusy(runs) {
		return "every 2s"
	}
	return ""
}

func exitText(r db.TaskRun) string {
	if r.Status == db.RunRunning {
		return ""
	}
	return strconv.Itoa(r.ExitCode)
}

templ AppTask(s ui.Shell, v AppView, t db.Task, runs []db.TaskRun, shown string, output string, f ui.Form) {
	@appFrame(s, v, "tasks") {
		<div class="grid max-w-4xl gap-6">
			<p>
				<a class="link" href={ templ.SafeURL(v.Path() + "/tasks") }>← All tasks</a>
			</p>
			<section class="card">
				<div class="card-head">
					<div>
						<h2 class="card-title">{ t.Name }</h2>
						<p class="muted text-sm">Next run: <span class="fact">{ nextRun(t.Enabled, t.NextRun) }</span></p>
					</div>
					<form method="post" action={ templ.SafeURL(v.Path() + "/tasks/" + t.ID + "/run") }>
						@ui.CSRF(s.CSRF)
						@ui.Button(ui.ButtonProps{Variant: ui.Primary, Type: "submit"}) {
							Run now
						}
					</form>
				</div>
				@TaskRuns(v, t, runs, shown)
			</section>
			if shown != "" {
				<section class="card">
					<div class="card-head">
						<h2 class="card-title">Output</h2>
					</div>
					if strings.TrimSpace(output) == "" {
						@ui.EmptyState(ui.EmptyProps{Icon: "terminal", Title: "This run wrote nothing", Size: ui.EmptySmall})
					} else {
						<pre class="logview" tabindex="0" aria-label="Output of the run">{ output }</pre>
					}
				</section>
			}
			<section class="card">
				<div class="card-head">
					<h2 class="card-title">Settings</h2>
					@ui.Button(ui.ButtonProps{Small: true, Icon: "pencil", Opens: "edit-task"}) {
						Edit
					}
				</div>
				<div class="card-body">
					@ui.KeyValue([]ui.KVItem{
						{Key: "Name", Value: t.Name},
						{Key: "Command", Value: t.Command, Mono: true},
						{Key: "Schedule", Value: t.Schedule, Mono: true},
						{Key: "Scheduled", Value: yesNo(t.Enabled, "On", "Off")},
					})
				</div>
			</section>
			@ui.FormDialog(ui.DialogProps{ID: "edit-task", Title: "Task settings", Action: v.Path() + "/tasks/" + t.ID, CSRF: s.CSRF, Submit: "Save task", Open: !f.OK()}) {
				@taskFields(f, t)
			}
			<section class="card card-danger">
				<div class="card-head">
					<div>
						<h2 class="card-title">Delete task</h2>
						<p class="muted text-sm">Removes the task and the history of its runs.</p>
					</div>
					<form method="post" action={ templ.SafeURL(v.Path() + "/tasks/" + t.ID + "/delete") }>
						@ui.CSRF(s.CSRF)
						@ui.Button(ui.ButtonProps{Variant: ui.DangerQuiet, Icon: "trash", Type: "submit", Attrs: ui.Ask("Delete the task "+t.Name+"?", "The task no longer runs, and the history of its runs is deleted. This cannot be undone.", "Delete task", true)}) {
							Delete task
						}
					</form>
				</div>
			</section>
		</div>
	}
}

// TaskRuns is a task's history. It refreshes itself while a run is going,
// and says which run the page shows the output of when it asks: the answer
// has to mark the same row, or it would never be what the page holds.
templ TaskRuns(v AppView, t db.Task, runs []db.TaskRun, shown string) {
	<div
		id="task-runs"
		{ ui.Poll(ctx, v.Path()+"/tasks/"+t.ID+"/runs?shown="+shown, runPoll(runs), taskRunsBody(v, t, runs, shown))... }
	>
		@taskRunsBody(v, t, runs, shown)
	</div>
}

// taskRunsBody is what the history shows, and so what its poll compares.
templ taskRunsBody(v AppView, t db.Task, runs []db.TaskRun, shown string) {
	if len(runs) == 0 {
		@ui.EmptyState(ui.EmptyProps{Icon: "clock", Title: "This task has not run yet", Text: "Each run is listed here with its output.", Size: ui.EmptySmall})
	} else {
		@ui.Table("Started", "Trigger", "Status", "Exit status", "Took", "") {
			for _, r := range runs {
				<tr>
					<td class="whitespace-nowrap">{ ui.Ago(r.StartedAt) }</td>
					<td>{ ui.StateLabel(r.Trigger) }</td>
					<td>
						@ui.JobPill(r.Status)
						if r.Error != "" {
							<p class="muted mt-1 max-w-md break-words text-sm">{ r.Error }</p>
						}
					</td>
					<td class="fact">{ exitText(r) }</td>
					<td class="fact">{ ui.Took(r.StartedAt, r.FinishedAt) }</td>
					<td class="text-right">
						if r.ID == shown {
							<span class="muted text-sm">Shown below</span>
						} else if r.Status != db.RunRunning {
							@ui.LinkButton(v.Path()+"/tasks/"+t.ID+"?run="+r.ID, ui.ButtonProps{Variant: ui.Ghost, Small: true}) {
								Output
							}
						}
					</td>
				</tr>
			}
		}
	}
}

func settingsTabs() []ui.Tab {
	return []ui.Tab{
		{Key: "dashboard", Label: "Dashboard", Href: "/settings", Icon: "globe"},
		{Key: "storages", Label: "Backup storage", Href: "/settings/storages", Icon: "archive"},
	}
}

// settingsFrame is the Settings page with its tabs.
templ settingsFrame(s ui.Shell, tab string) {
	@ui.Layout(s) {
		@ui.PageHeader("Settings", "Settings for this musdash install.")
		@ui.Tabs(settingsTabs(), tab)
		{ children... }
	}
}

func storageWhere(m db.S3Storage) string {
	where := m.Bucket
	if m.Prefix != "" {
		where += "/" + m.Prefix
	}
	return where
}

templ Storages(s ui.Shell, list []db.S3Storage, f ui.Form) {
	@settingsFrame(s, "storages") {
		<div class="grid max-w-3xl gap-6">
			<section class="card">
				<div class="card-head">
					<div>
						<h2 class="card-title">Backup storage</h2>
						<p class="muted text-sm">S3-compatible buckets that database backups are copied to: Amazon S3, Cloudflare R2, Backblaze B2, MinIO and the like.</p>
					</div>
					if len(list) > 0 {
						@ui.Button(ui.ButtonProps{Small: true, Icon: "plus", Opens: "add-bucket"}) {
							Add bucket
						}
					}
				</div>
				if len(list) == 0 {
					@ui.EmptyState(ui.EmptyProps{Icon: "drive", Title: "No bucket yet", Text: "Until one is added, backups are kept on the server only, and are lost with it.", Size: ui.EmptySmall}) {
						@ui.Button(ui.ButtonProps{Variant: ui.Primary, Small: true, Icon: "plus", Opens: "add-bucket"}) {
							Add bucket
						}
					}
				} else {
					@ui.Table("Name", "Bucket", "Endpoint", "") {
						for _, m := range list {
							<tr>
								<td class="font-semibold">{ m.Name }</td>
								<td class="fact">{ storageWhere(m) }</td>
								<td class="fact">{ orDefault(m.Endpoint, "Amazon S3") }</td>
								<td class="text-right">
									<div class="flex flex-wrap justify-end gap-2">
										<form method="post" action={ templ.SafeURL("/settings/storages/" + m.ID + "/test") }>
											@ui.CSRF(s.CSRF)
											@ui.Button(ui.ButtonProps{Variant: ui.Ghost, Small: true, Type: "submit"}) {
												Test
											}
										</form>
										<form method="post" action={ templ.SafeURL("/settings/storages/" + m.ID + "/delete") }>
											@ui.CSRF(s.CSRF)
											@ui.Button(ui.ButtonProps{Variant: ui.DangerQuiet, Small: true, Type: "submit", Attrs: ui.Ask("Remove the bucket "+m.Name+"?", "musdash forgets the bucket and its keys. Backups already uploaded stay in the bucket, where musdash no longer reaches them.", "Remove bucket", true)}) {
												Remove
											}
										</form>
									</div>
								</td>
							</tr>
						}
					}
				}
			</section>
			@ui.FormDialog(ui.DialogProps{ID: "add-bucket", Title: "Add a bucket", Description: "The keys are stored encrypted and are not shown again.", Action: "/settings/storages", CSRF: s.CSRF, Submit: "Add bucket", Wide: true, Open: !f.OK()}) {
				@ui.TextField(f, "Name", "What you call it here, such as Offsite.", ui.InputProps{ID: "name", Required: true})
				@ui.TextField(f, "Endpoint", "The address of the S3 service, such as https://s3.eu-central-1.amazonaws.com. Leave empty for Amazon S3 with the region below.", ui.InputProps{ID: "endpoint", Mono: true, Placeholder: "https://…"})
				<div class="grid items-start gap-4 sm:grid-cols-2">
					@ui.TextField(f, "Region", "Such as eu-central-1. Many providers accept auto or nothing.", ui.InputProps{ID: "region", Mono: true})
					@ui.TextField(f, "Bucket", "It must exist already.", ui.InputProps{ID: "bucket", Mono: true, Required: true})
				</div>
				@ui.TextField(f, "Folder", "Optional. A folder inside the bucket to keep the backups in.", ui.InputProps{ID: "prefix", Mono: true, Placeholder: "musdash"})
				@ui.TextField(f, "Access key", "", ui.InputProps{ID: "access_key", Mono: true, Required: true, Autocomplete: "off"})
				@ui.TextField(f, "Secret key", "", ui.InputProps{ID: "secret_key", Type: "password", Mono: true, Required: true, Autocomplete: "off"})
			}
		</div>
	}
}

func kindLabel(kind string) string {
	if k, ok := notify.Kind(kind); ok {
		return k.Label
	}
	return kind
}

// channelLogo is the mark of a channel's kind. Every kind has one, by its
// name (a test asks); a row of a kind this build does not know gets the
// bell, since ui.Logo has no file to point at.
templ channelLogo(kind string) {
	if static.Has(ui.LogoFile(kind)) {
		@ui.Logo(kind)
	} else {
		@ui.Icon("bell", "text-ink-mute")
	}
}

// channelEvents says in a few words what a channel is told about.
func channelEvents(c db.Channel) string {
	var out []string
	for _, e := range notify.Events {
		if c.Wants(e.Kind) {
			out = append(out, e.Short)
		}
	}
	switch len(out) {
	case 0:
		return "Nothing"
	case len(notify.Events):
		return "Everything"
	}
	return strings.Join(out, ", ")
}

func fieldType(f notify.Field) string {
	if f.Secret {
		return "password"
	}
	return "text"
}

func fieldLabel(f notify.Field) string {
	if f.Optional {
		return f.Label + " (optional)"
	}
	return f.Label
}

// addChannelMenu is the button a channel is added with: it opens a menu of
// the kinds, and each kind opens its own dialog. end says the button is at
// the end of a row, so the menu hangs from its right edge.
templ addChannelMenu(end bool) {
	@ui.Menu(ui.MenuProps{ID: "new-channel", Label: "Add channel", Class: "btn btn-primary", End: end, Button: addChannelButton()}) {
		for _, k := range notify.Kinds {
			@ui.MenuItem(ui.MenuItemProps{Label: k.Label, Logo: k.Kind, Opens: "add-channel-" + k.Kind})
		}
	}
}

templ addChannelButton() {
	@ui.Icon("plus")
	Add channel
	@ui.Icon("chevron-down")
}

// Notifications is the team's channels in one table. kind and f are the
// Add dialog that was sent and refused, if one was.
templ Notifications(s ui.Shell, list []db.Channel, kind notify.KindInfo, f ui.Form) {
	@ui.Layout(s) {
		@ui.PageHeader("Notifications", "Where musdash tells you what happened: a deployment, a backup, a task, a container that stopped, a disk that is filling up.") {
			if len(list) > 0 {
				@addChannelMenu(true)
			}
		}
		if len(list) == 0 {
			@ui.EmptyState(ui.EmptyProps{Icon: "bell", Title: "No channel yet", Text: "Without one, a failed backup or deployment is only visible here in the dashboard. Add a channel to be told in chat, by email or through a webhook."}) {
				@addChannelMenu(false)
			}
		} else {
			<section class="card">
				@ui.Table("Name", "Type", "Tells about", "State", "") {
					for _, c := range list {
						<tr>
							<td>
								<span class="inline-flex items-center gap-2">
									@channelLogo(c.Kind)
									<span class="font-semibold">{ c.Name }</span>
								</span>
							</td>
							<td>
								@ui.Badge(kindLabel(c.Kind), ui.ToneNeutral)
							</td>
							<td>{ channelEvents(c) }</td>
							<td>
								if c.Enabled {
									@ui.Pill(ui.ToneOK, "On")
								} else {
									@ui.Pill(ui.ToneNeutral, "Switched off")
								}
							</td>
							<td class="text-right">
								<div class="flex flex-wrap justify-end gap-2">
									<form method="post" action={ templ.SafeURL("/notifications/" + c.ID + "/test") }>
										@ui.CSRF(s.CSRF)
										@ui.Button(ui.ButtonProps{Variant: ui.Ghost, Small: true, Type: "submit"}) {
											Send a test
										}
									</form>
									@ui.Button(ui.ButtonProps{Small: true, Icon: "pencil", Opens: "edit-channel-" + c.ID}) {
										Edit
									}
									<form method="post" action={ templ.SafeURL("/notifications/" + c.ID + "/delete") }>
										@ui.CSRF(s.CSRF)
										@ui.Button(ui.ButtonProps{Variant: ui.DangerQuiet, Small: true, Type: "submit", Attrs: ui.Ask("Remove the channel "+c.Name+"?", "Nothing is sent to it any more.", "Remove channel", true)}) {
											Remove
										}
									</form>
								</div>
							</td>
						</tr>
					}
				}
			</section>
			for _, c := range list {
				@editChannelDialog(s.CSRF, c)
			}
		}
		for _, k := range notify.Kinds {
			@channelDialog(s.CSRF, k, channelForm(f, k.Kind == kind.Kind))
		}
	}
}

// editChannelDialog changes what a channel is told about and whether it is
// switched on. Every channel has one on the page, so its fields carry the
// channel's id.
templ editChannelDialog(csrf string, c db.Channel) {
	@ui.FormDialog(ui.DialogProps{ID: "edit-channel-" + c.ID, Title: "Edit " + c.Name, Description: "What this " + kindLabel(c.Kind) + " channel is told about. Its address and tokens are not shown again, so they cannot be changed here: remove the channel and add it again.", Action: "/notifications/" + c.ID, CSRF: csrf, Submit: "Save"}) {
		<fieldset class="grid gap-2">
			<legend class="field-label">Tell this channel when</legend>
			for _, e := range notify.Events {
				@ui.Checkbox("ev-"+c.ID+"-"+e.Kind, c.Wants(e.Kind), nil) {
					{ e.Label }
				}
			}
		</fieldset>
		@ui.Checkbox("on-"+c.ID, c.Enabled, nil) {
			<span class="font-semibold">Channel switched on</span>
		}
	}
}

// channelForm gives the dialog of the kind that was sent the form that came
// back, and the others an empty one.
func channelForm(f ui.Form, sent bool) ui.Form {
	if sent {
		return f
	}
	return ui.Form{}
}

// channelDialog is the form one kind of channel is added with. Every kind
// has one on the page, so the ids of its fields carry the kind.
templ channelDialog(csrf string, k notify.KindInfo, f ui.Form) {
	@ui.FormDialog(ui.DialogProps{ID: "add-channel-" + k.Kind, Title: "Add a " + k.Label + " channel", Description: "Addresses and tokens are stored encrypted and are not shown again.", Action: "/notifications", CSRF: csrf, Submit: "Add channel", Wide: len(k.Fields) > 4, Open: !f.OK()}) {
		<input type="hidden" name="kind" value={ k.Kind }/>
		if f.E("_form") != "" {
			@ui.Notice(ui.ToneDanger) {
				<p>{ f.E("_form") }</p>
			}
		}
		@ui.TextField(f, "Name", "What you call it here, such as Team chat.", ui.InputProps{ID: k.Kind + "-name", Name: "name", Required: true})
		for _, field := range k.Fields {
			@ui.TextField(f, fieldLabel(field), field.Hint, ui.InputProps{ID: k.Kind + "-cfg_" + field.Key, Name: "cfg_" + field.Key, Type: fieldType(field), Mono: true, Required: !field.Optional, Autocomplete: "off"})
		}
	}
}
