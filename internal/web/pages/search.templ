package pages

import (
	"net/url"
	"sort"
	"strconv"
	"strings"

	"github.com/MahmoudDahdouh/musdash-go/internal/catalog"
	"github.com/MahmoudDahdouh/musdash-go/internal/db"
	"github.com/MahmoudDahdouh/musdash-go/internal/web/ui"
)

// SearchRow is one row of the search's answer: a link to what was found.
type SearchRow struct {
	Href string
	Icon string
	Name string
	// Said is the line under the name, in words: what kind of thing the
	// row is and where it is. Empty for a page listed with nothing typed,
	// which the heading above the list says already.
	Said []string
	// Fact is one value a machine made, after Said: an image, a
	// repository, an engine, a host.
	Fact string
	// Pill is the state of what has one.
	Pill templ.Component
	// Logo is the name of the logo drawn in place of the icon, for a row
	// that is a product, and Badge a word where a state would be: what
	// opening the row does, for a row that is not something the team has.
	Logo  string
	Badge string
	// Rank is how well the row fits what was typed (db.RankExact …).
	Rank int
}

// SearchResults is the answer to one search.
type SearchResults struct {
	// Words are what was looked for; none when nothing was typed, and
	// then Rows are the pages a person can go to.
	Words []string
	Rows  []SearchRow
	// Offers are what the catalogue has that the words name (OfferRows):
	// listed after Rows, under a heading of their own.
	Offers []SearchRow
	// More says there are rows beyond Limit.
	More  bool
	Limit int
	// Problem is said instead of rows: the search could not be done.
	Problem string
}

// typed is the search as a person wrote it, for a sentence about it.
func (v SearchResults) typed() string { return strings.Join(v.Words, " ") }

// count is what a reader who does not see the list is told of an answer.
// With nothing typed the list is the same pages every time, and there is
// nothing to tell.
func (v SearchResults) count() string {
	switch {
	case v.Problem != "":
		return v.Problem
	case len(v.Words) == 0:
		return ""
	case v.all() == 0:
		return "No results"
	case v.More:
		return "The first " + strconv.Itoa(v.all()) + " results"
	case v.all() == 1:
		return "1 result"
	}
	return strconv.Itoa(v.all()) + " results"
}

// all is how many rows the answer lists.
func (v SearchResults) all() int { return len(v.Rows) + len(v.Offers) }

// said is the row's line of words, with the dot that parts it from a
// fact when one follows.
func (r SearchRow) said(fact bool) string {
	text := strings.Join(r.Said, " · ")
	if fact && text != "" {
		text += " · "
	}
	return text
}

// place is where a hit is, as the trail writes it.
func place(h db.Hit) string {
	switch {
	case h.Project == "":
		return ""
	case h.Env == "" || h.Kind == db.HitEnvironment:
		return h.Project
	}
	return h.Project + " / " + h.Env
}

// said is a row's line of words, without the ones it has nothing for.
func said(parts ...string) []string {
	var out []string
	for _, p := range parts {
		if p != "" {
			out = append(out, p)
		}
	}
	return out
}

// HitRow is the row of something the database found. A hit leads to the
// page that shows it, and a domain to where its routing is set.
func HitRow(h db.Hit) SearchRow {
	row := SearchRow{Name: h.Name, Rank: h.Rank}
	switch h.Kind {
	case db.HitProject:
		row.Href, row.Icon = "/projects/"+h.ID, "folder"
		row.Said = said("Project", h.Detail)
	case db.HitEnvironment:
		row.Href, row.Icon = EnvPath(h.ProjectID, h.ID), "box"
		row.Said = said("Environment", place(h))
	case db.KindApp:
		row.Href, row.Icon, row.Fact = ResourcePath(h.ProjectID, h.EnvID, db.KindApp, h.ID), KindIcon(db.KindApp), h.Detail
		row.Said = said("App", place(h))
		row.Pill = ui.StatusPill(h.Status)
	case db.KindDatabase:
		row.Href, row.Icon, row.Fact = ResourcePath(h.ProjectID, h.EnvID, db.KindDatabase, h.ID), KindIcon(db.KindDatabase), h.Detail
		row.Said = said("Database", place(h))
		row.Pill = ui.StatusPill(databaseState(db.Database{Status: h.Status}))
	case db.KindService:
		row.Href, row.Icon, row.Fact = ResourcePath(h.ProjectID, h.EnvID, db.KindService, h.ID), KindIcon(db.KindService), h.Detail
		row.Said = said("Service", place(h))
		row.Pill = ui.StatusPill(serviceState(db.Service{Status: h.Status}))
	case db.HitDomain:
		row.Href, row.Icon = ResourcePath(h.ProjectID, h.EnvID, db.KindService, h.OwnerID), "globe"
		if h.OwnerKind == db.KindApp {
			row.Href = ResourcePath(h.ProjectID, h.EnvID, db.KindApp, h.OwnerID) + "/domains"
		}
		row.Said = said("Domain of "+h.Owner, place(h))
	case db.HitServer:
		server := db.Server{Status: h.Status}
		row.Href, row.Icon, row.Fact = "/servers/"+h.ID, "server", h.Detail
		row.Said = said("Server")
		row.Pill = ui.Pill(serverTone(server), serverStateLabel(server))
	case db.HitTag:
		row.Href, row.Icon = "/tags/"+url.PathEscape(h.Name), "tag"
		row.Said = said("Tag")
	}
	return row
}

// nameRank says whether every one of the words is in a name or in what
// else the thing is known by (in lower case), and how well the name fits
// them, as the database ranks a row by its name.
func nameRank(name, known string, words []string) (rank int, found bool) {
	label := strings.ToLower(name)
	text := label + " " + known
	rank, found = db.RankOther, true
	for _, w := range words {
		w = strings.ToLower(w)
		found = found && strings.Contains(text, w)
		switch {
		case strings.HasPrefix(label, w):
			rank = min(rank, db.RankPrefix)
		case strings.Contains(label, w):
			rank = min(rank, db.RankInside)
		}
	}
	if label == strings.ToLower(strings.Join(words, " ")) {
		rank = db.RankExact
	}
	return rank, found
}

// PageRows is the pages among dests that hold every one of the words in
// their name or in the words they are known by, each ranked as the
// database ranks a row by its name. Without words it is all of them, as
// the list a person is shown before typing.
func PageRows(dests []ui.Destination, words []string) []SearchRow {
	var out []SearchRow
	for _, d := range dests {
		row := SearchRow{Href: d.Href, Icon: d.Icon, Name: d.Label}
		if len(words) > 0 {
			var found bool
			if row.Rank, found = nameRank(d.Label, d.Words, words); !found {
				continue
			}
			row.Said = []string{"Page"}
		}
		out = append(out, row)
	}
	return out
}

// OfferRows is what the catalogue has that the words name: the database
// engines and the service templates whose name or key holds every word,
// the best fits first and no more than limit of them. A row leads to the
// page that asks where the thing goes (DeployPath); projectID and envID
// are where the person is searching from, if that is inside a project,
// and are handed on as that page's first choice. Without words it is
// nothing: the catalogue is not a list of places to go.
//
// Only the name is looked in. What a template says of itself would find
// half the catalogue for "git" or "data", in a list of twenty rows that is
// the team's own things first.
func OfferRows(words []string, limit int, projectID, envID string) []SearchRow {
	if len(words) == 0 || limit <= 0 {
		return nil
	}
	var out []SearchRow
	offer := func(kind, key, name, said string) {
		rank, found := nameRank(name, strings.ToLower(key), words)
		if !found {
			return
		}
		row := SearchRow{Href: DeployPath(kind, key, projectID, envID), Icon: KindIcon(kind), Name: name, Said: []string{said}, Badge: "Deploy", Rank: rank}
		if ui.HasLogo(key) {
			row.Logo = key
		}
		out = append(out, row)
	}
	for _, t := range catalog.Databases() {
		offer(db.KindDatabase, t.Engine, t.Label, "Database engine")
	}
	for _, t := range catalog.Services() {
		offer(db.KindService, t.Key, t.Name, "Service template")
	}
	// Each list is in its own order already: by rank alone, an engine stays
	// before a template that fits as well.
	sort.SliceStable(out, func(i, j int) bool { return out[i].Rank < out[j].Rank })
	if len(out) > limit {
		out = out[:limit]
	}
	return out
}

// marked cuts a name in three at the first place one of the words is in
// it: what is before, the part that was typed, and what is after. A name
// that holds none is all "before". Letters are compared without their
// case; a name whose lower case is not as long as itself (a few letters
// outside ASCII) is left unmarked, because the place found would not be
// the same place in it.
func marked(name string, words []string) (before, hit, after string) {
	lower := strings.ToLower(name)
	if len(lower) != len(name) {
		return name, "", ""
	}
	at, length := -1, 0
	for _, w := range words {
		w = strings.ToLower(w)
		if i := strings.Index(lower, w); i >= 0 && w != "" && (at < 0 || i < at || (i == at && len(w) > length)) {
			at, length = i, len(w)
		}
	}
	if at < 0 {
		return name, "", ""
	}
	return name[:at], name[at : at+length], name[at+length:]
}

// SearchOptions is what GET /search answers with: the rows for the
// dialog's list, a line when there are none or more than are shown, and
// the count for the dialog's status line, which htmx puts there by its id
// (its content only: a region that is replaced whole is not announced).
// A list holds rows and nothing else, so the lines in it that are not rows
// are for the eye, and the status line says the same to who does not see.
templ SearchOptions(v SearchResults) {
	if v.Problem != "" {
		@ui.MenuNote(v.Problem, true)
	} else {
		if len(v.Words) == 0 {
			<p class="eyebrow search-heading" aria-hidden="true">Go to</p>
		}
		for _, row := range v.Rows {
			@searchRow(row, v.Words)
		}
		if len(v.Offers) > 0 {
			<p class="eyebrow search-heading" aria-hidden="true">Deploy something new</p>
			for _, row := range v.Offers {
				@searchRow(row, v.Words)
			}
		}
		if v.all() == 0 {
			<p class="menu-note" aria-hidden="true">Nothing matches “{ v.typed() }”.</p>
		} else if v.More {
			<p class="menu-note" aria-hidden="true">Showing the first { strconv.Itoa(v.Limit) }. Keep typing to narrow it down.</p>
		}
	}
	<p id="search-status" hx-swap-oob="innerHTML">{ v.count() }</p>
}

templ searchRow(row SearchRow, words []string) {
	{{ before, hit, after := marked(row.Name, words) }}
	<a class="menu-item search-hit" role="option" aria-selected="false" tabindex="-1" href={ templ.SafeURL(row.Href) }>
		if row.Logo != "" {
			@ui.Logo(row.Logo)
		} else {
			@ui.Icon(row.Icon, "text-ink-mute")
		}
		<span class="min-w-0 flex-1">
			// On one line each: a break between the parts would be a space
			// in the middle of a name.
			if hit != "" {
				<span class="search-name">{ before }<mark>{ hit }</mark>{ after }</span>
			} else {
				<span class="search-name">{ row.Name }</span>
			}
			if row.Fact != "" {
				<span class="search-said">{ row.said(true) }<span class="fact">{ row.Fact }</span></span>
			} else if len(row.Said) > 0 {
				<span class="search-said">{ row.said(false) }</span>
			}
		</span>
		if row.Pill != nil {
			@row.Pill
		}
		if row.Badge != "" {
			@ui.Badge(row.Badge, ui.ToneBrand)
		}
	</a>
}
