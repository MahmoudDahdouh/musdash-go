package pages

import (
	"strconv"

	"github.com/MahmoudDahdouh/musdash-go/internal/db"
	"github.com/MahmoudDahdouh/musdash-go/internal/web/ui"
)

// KindIcon is the icon of a kind of resource, the same wherever one is
// drawn: a tile, a switcher, a count.
func KindIcon(kind string) string {
	switch kind {
	case db.KindDatabase:
		return "database"
	case db.KindService:
		return "layers"
	}
	return "app-window"
}

// Resources is what one environment holds.
type Resources struct {
	Apps      []db.App
	Databases []db.Database
	Services  []db.Service
	// Places says where each environment of the list is, by its id: the
	// address of a resource starts with its project.
	Places map[string]db.Place
}

func (r Resources) Count() int { return len(r.Apps) + len(r.Databases) + len(r.Services) }

func appSourceKind(a db.App) string {
	if a.Source == db.SourceGit {
		return "App from Git"
	}
	return "App from an image"
}

// ResourceTiles draws apps, databases and services as one grid: they are
// all things that run in the environment, told apart by their icon.
templ ResourceTiles(res Resources) {
	@ui.Tiles("Resources") {
		for _, a := range res.Apps {
			@ui.Tile(ui.TileProps{Href: res.path(a.EnvironmentID, db.KindApp, a.ID), Icon: KindIcon(db.KindApp), Title: a.Name, Text: appSourceLine(a), Mono: true, State: a.Status}) {
				@ui.Meta("", appSourceKind(a), "")
			}
		}
		for _, m := range res.Databases {
			@ui.Tile(ui.TileProps{Href: res.path(m.EnvironmentID, db.KindDatabase, m.ID), Icon: KindIcon(db.KindDatabase), Title: m.Name, Text: m.Image, Mono: true, State: databaseState(m)}) {
				@ui.Meta("", engineLabel(m.Engine)+" database", "")
				if m.PublicPort > 0 {
					@ui.Badge("Public", ui.ToneWarn)
				}
			}
		}
		for _, s := range res.Services {
			@ui.Tile(ui.TileProps{Href: res.path(s.EnvironmentID, db.KindService, s.ID), Icon: KindIcon(db.KindService), Title: s.Name, Text: templateName(s.Template), State: serviceState(s)}) {
				@ui.Meta("", "Service", "")
			}
		}
	}
}

// ProjectOptions is what the project switcher lists: the team's projects.
// at is the id of the one the person is in.
templ ProjectOptions(projects []db.Project, at string) {
	for _, p := range projects {
		@ui.SwitchOption("/projects/"+p.ID, "folder", p.Name, p.ID == at)
	}
	if len(projects) > 0 {
		@ui.MenuSep()
	}
	@ui.MenuAction("/projects", "dashboard", "All projects")
}

// EnvironmentOptions is what the environment switcher lists, and under
// them the way up to the project's page, where they are cards, and to the
// Settings of the one the person is in.
templ EnvironmentOptions(p db.Project, envs []db.Environment, at string) {
	for _, e := range envs {
		@ui.SwitchOption(EnvPath(p.ID, e.ID), "", e.Name, e.ID == at)
	}
	@ui.MenuSep()
	@ui.MenuAction("/projects/"+p.ID, "dashboard", "All environments")
	for _, e := range envs {
		if e.ID == at {
			@ui.MenuAction(EnvPath(p.ID, e.ID)+"/settings", "settings", "Environment settings")
		}
	}
}

// TeamOptions is what the team switcher lists: the team the person is in,
// which leads to Home, the page that is the team's own.
templ TeamOptions(team string) {
	@ui.SwitchOption("/", "users", team, true)
	@ui.MenuSep()
	@ui.MenuAction("/team", "settings", "Manage team")
}

// ResourceOptions is what the resource switcher lists. at is the current
// one, as "kind:id".
templ ResourceOptions(env db.Environment, res Resources, at string) {
	for _, a := range res.Apps {
		@ui.SwitchOption(res.path(a.EnvironmentID, db.KindApp, a.ID), KindIcon(db.KindApp), a.Name, at == db.KindApp+":"+a.ID) {
			@ui.StatusPill(a.Status)
		}
	}
	for _, m := range res.Databases {
		@ui.SwitchOption(res.path(m.EnvironmentID, db.KindDatabase, m.ID), KindIcon(db.KindDatabase), m.Name, at == db.KindDatabase+":"+m.ID) {
			@ui.StatusPill(databaseState(m))
		}
	}
	for _, s := range res.Services {
		@ui.SwitchOption(res.path(s.EnvironmentID, db.KindService, s.ID), KindIcon(db.KindService), s.Name, at == db.KindService+":"+s.ID) {
			@ui.StatusPill(serviceState(s))
		}
	}
	if res.Count() > 0 {
		@ui.MenuSep()
	}
	@ui.MenuAction(EnvPath(env.ProjectID, env.ID)+"/new", "plus", "Add resource")
}

// kindGroup is one kind of thing the page lists, under its heading. A count
// is said after the title: how many there are of the kind, on this page of
// the list and the ones after it. 0 says none.
templ kindGroup(title string, count int, about string) {
	<section class="grid gap-3">
		<div>
			<h2 class="section-title">
				{ title }
				if count > 0 {
					<span class="font-normal text-ink-mute">({ strconv.Itoa(count) })</span>
				}
			</h2>
			<p class="muted text-sm">{ about }</p>
		</div>
		{ children... }
	</section>
}

// ResourceNew is the one page a resource of any kind is added from. The
// row above the list is a form that asks this same address for the list
// again (ResourceFound) as its field is typed in and a category is ticked.
// The field's own typing is waited out, and the Category menu's filter
// field, which has no name, asks nothing: hence the "from" of each trigger.
templ ResourceNew(s ui.Shell, v NewResource) {
	@ui.Layout(s) {
		@ui.PageHeader("Add resource", "It goes into "+v.Env.Name+" of "+v.Project.Name+". Choose what to run.")
		@ui.IconDefs(ui.OfferIcons("git-branch", "github", "gitlab", "key", "box", "code", KindIcon(db.KindDatabase), KindIcon(db.KindService))...)
		<div class="grid gap-8">
			<form
				class="flex flex-wrap items-center gap-2"
				role="search"
				method="get"
				action={ templ.SafeURL(v.Path() + "/new") }
				hx-get={ v.Path() + "/new" }
				hx-trigger="input delay:300ms from:#kind-filter, search from:#kind-filter, change from:#category-list, submit"
				hx-target="#kinds"
				hx-swap="innerHTML"
				hx-sync="this:replace"
				hx-indicator="#kinds"
			>
				<div class="min-w-0 max-w-md grow basis-64">
					<label class="sr-only" for="kind-filter">Find a kind of resource</label>
					@ui.Input(ui.InputProps{ID: "kind-filter", Name: "q", Type: "search", Value: v.Query, Placeholder: "Find: postgres, wordpress, git…", Autofocus: true, Autocomplete: "off"})
				</div>
				@ui.MultiSelect(ui.MultiSelectProps{ID: "category", Name: "category", Label: "Category", Options: v.categoryOptions()})
				@clearFilters(v, false)
			</form>
			<div class="found grid gap-8" id="kinds">
				@resourceKinds(v)
			</div>
		</div>
	}
}

// ResourceFound is the answer to the form: what goes into the list, and the
// Clear filters button for its place beside the field, which is outside
// the list.
templ ResourceFound(v NewResource) {
	@resourceKinds(v)
	@clearFilters(v, true)
}

// clearFilters is the way back to everything, there only while something
// narrows. It is a link to the bare address: a page drawn from that has the
// field empty and nothing ticked.
templ clearFilters(v NewResource, outOfBand bool) {
	<span
		id="kinds-clear"
		if outOfBand {
			hx-swap-oob="true"
		}
	>
		if v.Narrowed() {
			@ui.LinkButton(v.Path()+"/new", ui.ButtonProps{Variant: ui.Ghost, Icon: "x"}) {
				Clear filters
			}
		}
	</span>
}

// resourceKinds is the list: a group for each kind that has something.
templ resourceKinds(v NewResource) {
	if len(v.apps) > 0 {
		@kindGroup("Apps", 0, "Your own code, image or Compose file. musdash builds it, runs it and gives it a domain.") {
			@ui.Offers("Kinds of app") {
				for _, a := range v.apps {
					@ui.Offer(a)
				}
			}
		}
	}
	if len(v.engines) > 0 {
		@kindGroup("Databases", 0, "One container with a volume, a user and a generated password. Backups can be scheduled.") {
			@ui.Offers("Database engines") {
				for _, t := range v.engines {
					@ui.Offer(ui.OfferProps{Href: v.Path() + "/database/new?engine=" + t.Engine, Logo: t.Engine, Icon: KindIcon(db.KindDatabase), Title: t.Label, Text: t.About, Docs: t.Docs, Website: t.Website, Shared: true})
				}
			}
		}
	}
	if v.found > 0 {
		@kindGroup("Services", v.found, "One or more containers described by a Docker Compose file, ready to deploy. Each is its makers' Compose file, held to the same rules as your own.") {
			@ui.Offers("Kinds of service") {
				@ResourceMore(v)
			}
		}
	}
	if v.Nothing() {
		@ui.EmptyState(ui.EmptyProps{Icon: "search", Title: "Nothing matches", Text: "A service that is not listed can be run from its own Compose file.", Link: "Use your own Compose file", LinkHref: v.Path() + "/service/new?template=" + db.TemplateCustom}) {
			@ui.LinkButton(v.Path()+"/new", ui.ButtonProps{Variant: ui.Primary}) {
				Clear filters
			}
		}
	}
}

// ResourceMore is one page of the services and, while there are more, the
// list's last row, which asks for the next page when it comes near the
// window and is replaced by the answer: this again. Its button is for a
// request that failed, and asks once more.
templ ResourceMore(v NewResource) {
	for _, t := range v.services {
		@ui.Offer(ui.OfferProps{Href: v.Path() + "/service/new?template=" + t.Key, Logo: t.Key, Icon: KindIcon(db.KindService), Title: t.Name, Text: t.About, Docs: t.Docs, Website: t.Website, TagLabels: categoryLabels(t.Categories), Shared: true})
	}
	if v.More() {
		<li class="offers-more" hx-get={ v.address(v.Page + 1) } hx-trigger="intersect once, click" hx-swap="outerHTML">
			@ui.Button(ui.ButtonProps{}) {
				Show more
			}
		</li>
	}
}
