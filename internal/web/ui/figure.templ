package ui

// FigureProps configures a Figure.
type FigureProps struct {
	// Label says what is counted, and is the card's link when it has one.
	Label string
	Icon  string
	// Value is the figure, and Of what it is a part of, said after it in
	// smaller letters: "12" and "of 14".
	Value string
	Of    string
	// Flag is what a person should know of the figure at a glance, in the
	// tone that says how it stands; none with an empty Flag.
	Flag     string
	FlagTone string
	// Detail is one line under the figure: what it counts, or what the
	// flag is about.
	Detail string
	// Href is where the figure is looked into. A card with none is not a
	// link.
	Href string
}

// Figures is a row of the few figures a page opens with: four across where
// there is room, two on a tablet, one on a phone. label says what they
// are, for a screen reader.
templ Figures(label string) {
	<ul class="figures" aria-label={ label }>
		{ children... }
	</ul>
}

// Figure is one of them: a number a person came to read, said large, with
// what it counts above it and how it stands under it. The flag has a line
// of its own at the card's foot: beside the label it cut the label short
// in a card a quarter of the page wide. The whole card is
// one link to where the number is looked into, as a Tile is. It differs
// from a Stat, which is a cell of a strip inside a card and has a bar.
templ Figure(p FigureProps) {
	<li class="tile figure">
		<div class="figure-head">
			@Icon(p.Icon, "text-ink-mute")
			<h2 class="figure-label">
				if p.Href != "" {
					<a class="tile-link" href={ templ.SafeURL(p.Href) }>{ p.Label }</a>
				} else {
					{ p.Label }
				}
			</h2>
		</div>
		<p class="figure-value">
			{ p.Value }
			if p.Of != "" {
				<span class="figure-of">{ p.Of }</span>
			}
		</p>
		if p.Detail != "" {
			<p class="figure-detail">{ p.Detail }</p>
		}
		if p.Flag != "" {
			<p class="figure-flag">
				@Pill(p.FlagTone, p.Flag)
			</p>
		}
	</li>
}
