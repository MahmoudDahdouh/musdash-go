package ui

import (
	"strconv"
	"strings"
)

// PageHeader is the title row at the top of a page. Its children are the
// page's actions, shown on the right.
templ PageHeader(title, description string) {
	<header class="mb-6 flex flex-wrap items-start justify-between gap-x-6 gap-y-3 sm:flex-nowrap">
		// The least width is what sends the buttons under the title on a
		// narrow screen, where two of them would leave it a column of one
		// word a line.
		<div class="min-w-40 flex-1">
			<h1 class="text-xl font-semibold tracking-tight">{ title }</h1>
			if description != "" {
				<p class="muted mt-0.5 max-w-2xl">{ description }</p>
			}
		</div>
		<div class="flex flex-none flex-wrap items-center gap-2">
			{ children... }
		</div>
	</header>
}

// Crumb is one step of the trail in the bar at the top. The last one has no
// Href: it is where you are. A step with a Menu is a switcher: a button
// naming the place, and a menu of the places beside it that is fetched from
// Menu (SwitchOption, MenuSep, MenuNote) the first time it is opened.
type Crumb struct {
	Label string
	Href  string
	Icon  string
	Menu  string
	// Filter is the label of the menu's filter field, for a list that can
	// be long. Empty for a menu without one.
	Filter string
}

// Trail is the bar's content.
templ Trail(items []Crumb) {
	if len(items) > 0 {
		<nav class="crumbs" aria-label="Breadcrumb">
			for i, c := range items {
				if i > 0 {
					<span class="crumb-sep" aria-hidden="true">/</span>
				}
				if c.Menu != "" {
					@switcher("crumb-"+strconv.Itoa(i), c)
				} else if c.Href != "" {
					<a class="crumb" href={ templ.SafeURL(c.Href) }>
						if c.Icon != "" {
							@Icon(c.Icon)
						}
						<span class="truncate">{ c.Label }</span>
					</a>
				} else {
					<span class="crumb" aria-current="page">
						if c.Icon != "" {
							@Icon(c.Icon)
						}
						<span class="truncate">{ c.Label }</span>
					</span>
				}
			}
		</nav>
	}
}

// switcher is a step of the trail that opens a menu of links. It is built
// like a Picker, so static/app.js places and steers it the same way; its
// options are links, which is what choosing one does.
templ switcher(id string, c Crumb) {
	<div class="select" data-select>
		<button
			type="button"
			id={ id }
			class="crumb"
			aria-haspopup="listbox"
			aria-expanded="false"
			aria-controls={ id + "-list" }
			popovertarget={ id + "-menu" }
		>
			if c.Icon != "" {
				@Icon(c.Icon)
			}
			<span class="truncate">{ c.Label }</span>
			@Icon("unfold")
		</button>
		<div class="menu" id={ id + "-menu" } popover hx-get={ c.Menu } hx-trigger="select-load" hx-target="find [role=listbox]" hx-swap="innerHTML">
			if c.Filter != "" {
				@menuFilter(id+"-list", c.Filter)
			}
			<div class="menu-options" id={ id + "-list" } role="listbox" aria-labelledby={ id }>
				@MenuNote("Loading…", false)
			</div>
			if c.Filter != "" {
				@menuNoMatch()
			}
		</div>
	</div>
}

// SwitchOption is one place a switcher's Menu answers with: a link. current
// marks where the person is now. Its children come after the label, on the
// right: a state, a count.
templ SwitchOption(href, icon, label string, current bool) {
	<a
		class="menu-item"
		role="option"
		href={ templ.SafeURL(href) }
		aria-selected={ strconv.FormatBool(current) }
		if current {
			aria-current="page"
		}
		tabindex="-1"
		data-search={ label }
	>
		@Icon("check", "menu-tick")
		if icon != "" {
			@Icon(icon, "text-ink-mute")
		}
		<span class="min-w-0 flex-1 truncate">{ label }</span>
		{ children... }
	</a>
}

// MenuAction is a link at the foot of a menu that goes somewhere else than
// the places above it: to add one, to manage them. A filter does not hide it.
templ MenuAction(href, icon, label string) {
	@MenuItem(MenuItemProps{Href: href, Icon: icon, Label: label, Attrs: templ.Attributes{"data-keep": true}})
}

// MenuProps describes a Menu.
type MenuProps struct {
	ID string
	// Label says what the button is to a reader who does not see it.
	Label string
	// Class is the button's: a .btn, or a class of the place it is in.
	Class string
	// End hangs the menu from the button's right edge, for a button at the
	// end of a row.
	End bool
	// Button is what the button shows; Head, if any, is said above the
	// items: whose menu it is.
	Button templ.Component
	Head   templ.Component
}

// Menu is a button that opens a menu of things to do and places to go: its
// children, MenuItem and MenuSep. A Select and a switcher open on the option
// that is chosen. A Menu has none, so it opens with nothing marked and the
// focus still on its button (data-menu-actions, static/app.js): an item is
// marked when the pointer or the arrow keys are on it.
templ Menu(p MenuProps) {
	<div class="select" data-select>
		<button
			type="button"
			id={ p.ID }
			class={ p.Class }
			aria-label={ p.Label }
			aria-haspopup="listbox"
			aria-expanded="false"
			aria-controls={ p.ID + "-list" }
			popovertarget={ p.ID + "-menu" }
		>
			@p.Button
		</button>
		<div class="menu" id={ p.ID + "-menu" } popover data-menu-actions data-menu-end?={ p.End }>
			if p.Head != nil {
				<div class="menu-head">
					@p.Head
				</div>
			}
			<div class="menu-options" id={ p.ID + "-list" } role="listbox" aria-labelledby={ p.ID }>
				{ children... }
			</div>
		</div>
	</div>
}

// MenuItemProps describes one item of a menu.
type MenuItemProps struct {
	Label string
	Icon  string
	// Logo is the name of a Logo to show in place of an Icon: the item is
	// a product, told by its mark.
	Logo string
	// Href makes the item a link. Without one it is a button that sends the
	// form it is in.
	Href string
	// Opens makes the item a button that opens the dialog with this id, and
	// sends nothing.
	Opens string
	// Danger is for what ends or removes something. It is red in its text
	// and a pale red under the pointer, never a red block: a menu is read
	// before it is pressed.
	Danger bool
	// Current marks the page the person is on.
	Current bool
	Attrs   templ.Attributes
}

// MenuItem is one thing a menu offers.
templ MenuItem(p MenuItemProps) {
	if p.Href != "" {
		<a
			class={ "menu-item", templ.KV("menu-item-danger", p.Danger) }
			role="option"
			href={ templ.SafeURL(p.Href) }
			aria-selected="false"
			if p.Current {
				aria-current="page"
			}
			tabindex="-1"
			{ p.Attrs... }
		>
			@menuItemBody(p)
		</a>
	} else if p.Opens != "" {
		<button type="button" class={ "menu-item", templ.KV("menu-item-danger", p.Danger) } role="option" aria-selected="false" tabindex="-1" data-open={ p.Opens } { p.Attrs... }>
			@menuItemBody(p)
		</button>
	} else {
		<button type="submit" class={ "menu-item", templ.KV("menu-item-danger", p.Danger) } role="option" aria-selected="false" tabindex="-1" { p.Attrs... }>
			@menuItemBody(p)
		</button>
	}
}

templ menuItemBody(p MenuItemProps) {
	if p.Logo != "" {
		@Logo(p.Logo)
	} else if p.Icon != "" {
		// A danger item's icon has the item's colour.
		if p.Danger {
			@Icon(p.Icon)
		} else {
			@Icon(p.Icon, "text-ink-mute")
		}
	}
	<span class="min-w-0 flex-1 truncate">{ p.Label }</span>
}

// MenuSep is the rule between a menu's places and its actions.
templ MenuSep() {
	<div class="menu-sep" role="separator"></div>
}

// Card is a bordered surface. Pass a title to get a header row.
templ Card(title string) {
	<section class="card">
		if title != "" {
			<div class="card-head">
				<h2 class="card-title">{ title }</h2>
			</div>
		}
		{ children... }
	</section>
}

// TileProps configures a Tile.
type TileProps struct {
	Href  string
	Icon  string
	Title string
	// Text is the description, cut after three lines. Mono draws it as a
	// machine's value: an image, a repository, a domain.
	Text string
	Mono bool
	// State, when set, is written as a pill at the top right.
	State string
	// Compact is the small form, for a choice among many: no square behind
	// the icon and no row of figures.
	Compact bool
	// Search is the text a filter field looks in. Empty leaves the tile
	// out of filtering.
	Search string
}

// Tiles is a grid of tiles. label says what they are, for a screen reader.
templ Tiles(label string, compact bool) {
	<ul class={ "tiles", templ.KV("tiles-compact", compact) } aria-label={ label }>
		{ children... }
	</ul>
}

// Tile is one thing among several of its kind, the whole of it a link:
// a project, a resource, a kind of resource to add. Its children are the
// figures in the row at its bottom (Meta).
templ Tile(p TileProps) {
	<li
		class={ "tile", templ.KV("tile-compact", p.Compact) }
		if p.State != "" {
			data-state={ p.State }
		}
		if p.Search != "" {
			data-search={ p.Search }
		}
	>
		<div class="tile-head">
			<span class="tile-icon">
				@Icon(p.Icon)
			</span>
			<h3 class={ "tile-title flex-1", templ.KV("truncate", !p.Compact) }>
				<a class="tile-link" href={ templ.SafeURL(p.Href) }>{ p.Title }</a>
			</h3>
			if p.State != "" {
				@StatusPill(p.State)
			}
		</div>
		if p.Text != "" {
			<p class={ "tile-text", templ.KV("fact", p.Mono) }>{ p.Text }</p>
		}
		if !p.Compact {
			<div class="tile-meta">
				{ children... }
			</div>
		}
	</li>
}

// Meta is one figure in a tile's bottom row: an icon and a short text.
// title says what a bare figure counts, for a pointer and a screen reader;
// a text that says it itself has none.
templ Meta(icon, text, title string) {
	<span
		if title != "" {
			title={ title }
		}
	>
		if icon != "" {
			@Icon(icon)
		}
		<span class="truncate">{ text }</span>
		if title != "" {
			<span class="sr-only">{ title }</span>
		}
	</span>
}

// FormCard is a card that holds one form: fields in the body and the submit
// action in the footer, so every settings form reads the same way.
templ FormCard(title, description, action, csrf, submit string) {
	<form class="card" method="post" action={ templ.SafeURL(action) }>
		@CSRF(csrf)
		<div class="card-head">
			<div>
				<h2 class="card-title">{ title }</h2>
				if description != "" {
					<p class="muted text-sm">{ description }</p>
				}
			</div>
		</div>
		<div class="card-body grid gap-4">
			{ children... }
		</div>
		<div class="card-foot">
			@Button(ButtonProps{Variant: Primary, Type: "submit"}) {
				{ submit }
			}
		</div>
	</form>
}

// Table renders a table with the given column headers inside a scroll
// wrapper. Its children are the <tr> rows.
templ Table(headers ...string) {
	<div class="table-wrap">
		<table class="table">
			<thead>
				<tr>
					for _, h := range headers {
						<th scope="col">{ h }</th>
					}
				</tr>
			</thead>
			<tbody>
				{ children... }
			</tbody>
		</table>
	</div>
}

// Tones shared by Badge, Notice and Pill.
const (
	ToneNeutral = ""
	ToneBrand   = "brand"
	ToneOK      = "ok"
	ToneWarn    = "warn"
	ToneDanger  = "danger"
)

// ToneBusy is a pill's alone: something is in progress.
const ToneBusy = "busy"

templ Badge(text, tone string) {
	<span class={ "badge", templ.KV("badge-"+tone, tone != "") }>{ text }</span>
}

// stateTone maps a resource state to the tone its pill is drawn in. The same
// state names drive the .rail colour through the data-state attribute.
func stateTone(state string) string {
	switch state {
	case "running", "healthy", "success", "done":
		return ToneOK
	case "deploying", "building", "queued", "starting", "restarting":
		return ToneBusy
	case "degraded", "unhealthy":
		return ToneWarn
	case "failed", "error", "exited":
		return ToneDanger
	}
	return ToneNeutral
}

// toneIcon is the icon a pill of a tone shows, so that a state is told by
// its shape as well as its colour.
func toneIcon(tone string) string {
	switch tone {
	case ToneOK:
		return "check"
	case ToneBusy:
		return "loading"
	case ToneWarn:
		return "alert"
	case ToneDanger:
		return "x"
	}
	return "minus"
}

// stateIcon is the icon of a state's pill: its tone's, but for two.
// Waiting in the queue is not work in progress, so it does not turn, and
// stopped on request is a state of its own, not the lack of one.
func stateIcon(state string) string {
	switch state {
	case "queued":
		return "clock"
	case "stopped":
		return "stop"
	}
	return toneIcon(stateTone(state))
}

// pillIconClass turns the icon of work in progress.
func pillIconClass(icon string) string {
	if icon == "loading" {
		return "animate-spin"
	}
	return ""
}

// StateLabel is the human wording of a state: "running" → "Running".
func StateLabel(state string) string {
	switch state {
	case "":
		return "Unknown"
	case "created":
		return "Not deployed"
	case "exited":
		return "Not running"
	case "success":
		return "Succeeded"
	}
	return strings.ToUpper(state[:1]) + strings.ReplaceAll(state[1:], "_", " ")
}

templ pill(tone, icon, text string, class []string) {
	<span class={ "pill", templ.KV("pill-"+tone, tone != ""), class }>
		@Icon(icon, pillIconClass(icon))
		{ text }
	</span>
}

// Pill writes something out in a tone, with the tone's icon. Every pill
// is one of these three, so none is drawn without its icon.
templ Pill(tone, text string, class ...string) {
	@pill(tone, toneIcon(tone), text, class)
}

// StatePill is the pill of a state under words of the page's own.
templ StatePill(state, text string, class ...string) {
	@pill(stateTone(state), stateIcon(state), text, class)
}

// StatusPill writes a state out in words, with its icon.
templ StatusPill(state string) {
	@StatePill(state, StateLabel(state))
}

// JobPill is the pill of a deployment, a backup or a run. "running" says of
// those that they are in progress, which is not what it says of an app.
templ JobPill(status string) {
	if status == "running" {
		@pill(ToneBusy, toneIcon(ToneBusy), StateLabel(status), nil)
	} else {
		@StatusPill(status)
	}
}

// Tab is one entry of a Tabs bar.
type Tab struct {
	Key   string
	Label string
	Href  string
	Icon  string
}

templ Tabs(items []Tab, active string) {
	<nav class="tabs mb-5" aria-label="Sections">
		for _, t := range items {
			<a
				class="tab"
				href={ templ.SafeURL(t.Href) }
				if t.Key == active {
					aria-current="page"
				}
			>
				if t.Icon != "" {
					@Icon(t.Icon)
				}
				{ t.Label }
			</a>
		}
	</nav>
}

// Modal is a native dialog. Open it with a control carrying data-open={ id }.
templ Modal(id, title string) {
	<dialog class="modal" id={ id } aria-labelledby={ id + "-title" }>
		<div class="card-head">
			<h2 class="card-title" id={ id + "-title" }>{ title }</h2>
			@Button(ButtonProps{Variant: Ghost, Small: true, IconOnly: true, Icon: "x", Label: "Close", Attrs: templ.Attributes{"data-close": true}})
		</div>
		{ children... }
	</dialog>
}

// DialogProps configures a FormDialog.
type DialogProps struct {
	ID          string // dialog id, unique on the page; a button with Opens: ID opens it
	Title       string
	Description string
	Action      string
	CSRF        string
	Submit      string // label of the submit button
	// Open shows the dialog as soon as the page is loaded: the form came
	// back from the server with errors.
	Open bool
	Wide bool
	// Danger draws the submit button red: the form takes something away.
	Danger bool
}

// FormDialog is a short form in a dialog: what creating or changing
// something of up to five fields looks like. Its children are the fields.
// When the server refuses what was sent it renders the page again with
// Open set, and the dialog is where the person left it, errors in place.
templ FormDialog(p DialogProps) {
	<dialog class={ "modal", templ.KV("modal-wide", p.Wide) } id={ p.ID } aria-labelledby={ p.ID + "-title" } data-autoopen?={ p.Open }>
		<form method="post" action={ templ.SafeURL(p.Action) }>
			@CSRF(p.CSRF)
			<div class="card-head">
				<h2 class="card-title" id={ p.ID + "-title" }>{ p.Title }</h2>
				@Button(ButtonProps{Variant: Ghost, Small: true, IconOnly: true, Icon: "x", Label: "Close", Attrs: templ.Attributes{"data-close": true}})
			</div>
			<div class="card-body grid gap-4">
				if p.Description != "" {
					<p class="muted text-sm">{ p.Description }</p>
				}
				{ children... }
			</div>
			<div class="card-foot">
				@Button(ButtonProps{Attrs: templ.Attributes{"data-close": true}}) {
					Cancel
				}
				@Button(ButtonProps{Variant: dialogSubmit(p), Type: "submit"}) {
					{ p.Submit }
				}
			</div>
		</form>
	</dialog>
}

func dialogSubmit(p DialogProps) string {
	if p.Danger {
		return Danger
	}
	return Primary
}

// Ask marks a submit button as critical: pressing it opens the page's
// confirm dialog with this question, and only its confirm button sends the
// form. submit is the confirm button's label; danger draws it red. Without
// script the form is sent as any other.
func Ask(title, question, submit string, danger bool) templ.Attributes {
	a := templ.Attributes{"data-confirm": question, "data-confirm-title": title, "data-confirm-submit": submit}
	if danger {
		a["data-confirm-tone"] = "danger"
	}
	return a
}

// Merge joins attribute sets into one, for a control that needs several:
// a later set wins where two name the same attribute.
func Merge(sets ...templ.Attributes) templ.Attributes {
	out := templ.Attributes{}
	for _, set := range sets {
		for k, v := range set {
			out[k] = v
		}
	}
	return out
}

// Masked stands where a secret value is not shown.
const Masked = "••••••••"

// ConfirmProps configures a destructive action guarded by typed confirmation.
type ConfirmProps struct {
	ID      string // dialog id, unique on the page
	Title   string // "Delete project"
	Action  string // form action
	CSRF    string
	Match   string // the exact text the person must type
	Submit  string // "Delete project"
	Trigger string // label of the button that opens the dialog
}

// Confirm renders a quiet danger button and the dialog it opens. The dialog's
// submit button stays disabled until Match has been typed. Its children
// explain what will be lost.
templ Confirm(p ConfirmProps) {
	@ConfirmTrigger(p)
	@ConfirmDialog(p) {
		{ children... }
	}
}

// ConfirmTrigger is the button of a Confirm alone, for one that stands where
// its dialog cannot: inside another form, which cannot hold the dialog's.
templ ConfirmTrigger(p ConfirmProps) {
	@Button(ButtonProps{Variant: DangerQuiet, Icon: "trash", Attrs: templ.Attributes{"data-open": p.ID}}) {
		{ p.Trigger }
	}
}

// ConfirmDialog is the dialog of a Confirm alone, to go with a
// ConfirmTrigger.
templ ConfirmDialog(p ConfirmProps) {
	@Modal(p.ID, p.Title) {
		<form method="post" action={ templ.SafeURL(p.Action) }>
			@CSRF(p.CSRF)
			<div class="card-body grid gap-4">
				<div class="text-ink-soft">
					{ children... }
				</div>
				@Field(FieldProps{Label: "Type " + p.Match + " to confirm", For: p.ID + "-confirm"}) {
					@Input(InputProps{ID: p.ID + "-confirm", Name: "confirm", Mono: true, Autocomplete: "off", Required: true, Attrs: templ.Attributes{"data-match": p.Match}})
				}
			</div>
			<div class="card-foot">
				@Button(ButtonProps{Attrs: templ.Attributes{"data-close": true}}) {
					Cancel
				}
				@Button(ButtonProps{Variant: Danger, Type: "submit", Disabled: true}) {
					{ p.Submit }
				}
			</div>
		</form>
	}
}

func noticeIcon(tone string) string {
	switch tone {
	case ToneOK:
		return "check"
	case ToneWarn, ToneDanger:
		return "alert"
	}
	return "info"
}

func noticeIconClass(tone string) string {
	switch tone {
	case ToneOK:
		return "mt-0.5 text-ok"
	case ToneWarn:
		return "mt-0.5 text-warn"
	case ToneDanger:
		return "mt-0.5 text-danger"
	}
	return "mt-0.5 text-brand-600"
}

// Notice is an inline message. Its children are the message.
templ Notice(tone string) {
	<div class={ "notice", templ.KV("notice-"+tone, tone != "") } role={ noticeRole(tone) }>
		@Icon(noticeIcon(tone), noticeIconClass(tone))
		<div class="min-w-0 flex-1">
			{ children... }
		</div>
	</div>
}

func noticeRole(tone string) string {
	if tone == ToneDanger {
		return "alert"
	}
	return "status"
}

// Flash is a one-time message shown after a redirect.
type Flash struct {
	Tone    string
	Message string
}

// Toasts renders the flash message, if any, as a toast. Confirmations leave
// on their own; errors stay until dismissed.
templ Toasts(f *Flash) {
	<div class="toasts" id="toasts">
		if f != nil {
			<div
				class={ "notice", templ.KV("notice-"+f.Tone, f.Tone != "") }
				role={ noticeRole(f.Tone) }
				if f.Tone != ToneDanger {
					data-autodismiss
				}
			>
				@Icon(noticeIcon(f.Tone), noticeIconClass(f.Tone))
				<div class="min-w-0 flex-1">{ f.Message }</div>
				@Button(ButtonProps{Variant: Ghost, Small: true, IconOnly: true, Icon: "x", Label: "Dismiss", Attrs: templ.Attributes{"data-dismiss": true}})
			</div>
		}
	</div>
}

// Sizes of an EmptyState. The default stands where a page's list would be.
const (
	// EmptySmall is the one inside a card, where its table or rows would be.
	EmptySmall = "sm"
	// EmptyPage is all a page holds: a page that is not there, or not allowed.
	EmptyPage = "page"
)

// EmptyProps configures an EmptyState.
type EmptyProps struct {
	// Icon is the icon of what would be here; a problem has "alert".
	Icon string
	// Title says what is missing, in a few words and without a full stop.
	Title string
	// Text says why it matters or what to do next, without repeating the
	// title. Optional.
	Text string
	Size string
	// Plain writes the title as a line of text, not a heading: for a state
	// that is one of several under a heading that names it already (a
	// chart's title, a group's), where the outline would repeat itself.
	Plain bool
	// Link is a second action, a text link under the first: somewhere
	// useful to go, or nothing.
	Link     string
	LinkHref string
	// Attrs go on the element: data-filter-empty and hidden, for the one a
	// filter shows.
	Attrs templ.Attributes
}

// EmptyState says that a list has nothing in it, or that a page cannot be
// shown, and what to do about it. Its children are the one action that
// does, as a primary button. The title is a heading of the level its place
// has, so the page's outline stays true: under a page's title by default,
// under a card's when small, and the page's own when it is all there is.
templ EmptyState(p EmptyProps) {
	<div class={ "empty", templ.KV("empty-"+p.Size, p.Size != "") } { p.Attrs... }>
		@Icon(p.Icon)
		if p.Plain {
			<p class="empty-title">{ p.Title }</p>
		} else {
			switch p.Size {
				case EmptyPage:
					<h1 class="empty-title">{ p.Title }</h1>
				case EmptySmall:
					<h3 class="empty-title">{ p.Title }</h3>
				default:
					<h2 class="empty-title">{ p.Title }</h2>
			}
		}
		if p.Text != "" {
			<p class="empty-text">{ p.Text }</p>
		}
		<div class="empty-actions">
			{ children... }
		</div>
		if p.Link != "" {
			<a class="empty-link" href={ templ.SafeURL(p.LinkHref) }>{ p.Link }</a>
		}
	</div>
}

// Fact renders a machine-produced value (domain, tag, port, hash) in the
// monospaced face.
templ Fact(value string) {
	<span class="fact">{ value }</span>
}

// Copyable is a Fact with a copy button.
templ Copyable(value string) {
	<span class="inline-flex max-w-full min-w-0 items-center gap-1.5">
		<span class="code truncate">{ value }</span>
		<button type="button" class="btn btn-ghost btn-sm" data-copy={ value }>
			@Icon("copy")
			<span data-copy-label>Copy</span>
		</button>
	</span>
}

// mask replaces the secret part of a value with bullets.
func mask(value, hidden string) string {
	if hidden == "" {
		return value
	}
	return strings.ReplaceAll(value, hidden, Masked)
}

// Secret is a Copyable that does not show all of its value: the hidden part
// (a password inside a connection string, or the whole value) is drawn as
// bullets, and the copy button yields the real thing. It keeps a password
// off the screen during a screen share, not out of the page.
templ Secret(value, hidden string) {
	<span class="inline-flex max-w-full min-w-0 items-center gap-1.5">
		<span class="code truncate">{ mask(value, hidden) }</span>
		<button type="button" class="btn btn-ghost btn-sm" data-copy={ value }>
			@Icon("copy")
			<span data-copy-label>Copy</span>
		</button>
	</span>
}

// KVItem is one row of a KeyValue list.
type KVItem struct {
	Key   string
	Value string
	Mono  bool
}

templ KeyValue(items []KVItem) {
	<dl class="kv">
		for _, it := range items {
			<dt>{ it.Key }</dt>
			<dd class={ templ.KV("fact", it.Mono) }>{ it.Value }</dd>
		}
	</dl>
}

// LogView is a scrolling log panel that follows new output. Its children are
// the log text.
templ LogView(id string, attrs templ.Attributes) {
	<pre class="logview" id={ id } data-follow="on" tabindex="0" aria-label="Log output" { attrs... }>
		{ children... }
	</pre>
}
