package ui

import (
	"encoding/json"
	"strconv"

	"github.com/MahmoudDahdouh/musdash-go/internal/web/static"
)

// Shell carries what the application frame needs on every page.
type Shell struct {
	Title  string
	Active string // key of the current navigation item
	Name   string // signed-in person's name
	Email  string
	CSRF   string
	MemMB  int // musdash's own memory use, shown in the sidebar
	Crumbs []Crumb
	Flash  *Flash
	Dev    bool
}

// NavItem is one entry in the sidebar.
type NavItem struct {
	Key   string
	Label string
	Href  string
	Icon  string
}

// Nav is the sidebar's content. Later phases append their sections here.
var Nav = []NavItem{
	{Key: "projects", Label: "Projects", Href: "/", Icon: "folder"},
	{Key: "servers", Label: "Servers", Href: "/servers", Icon: "server"},
	{Key: "settings", Label: "Settings", Href: "/settings", Icon: "settings"},
}

func csrfHeader(token string) string {
	b, _ := json.Marshal(map[string]string{"X-CSRF-Token": token})
	return string(b)
}

func pageTitle(title string) string {
	if title == "" {
		return "musdash"
	}
	return title + " · musdash"
}

templ head(title string) {
	<head>
		<meta charset="utf-8"/>
		<meta name="viewport" content="width=device-width, initial-scale=1"/>
		<meta name="robots" content="noindex"/>
		<meta name="htmx-config" content='{"allowEval":false,"includeIndicatorStyles":false,"historyCacheSize":0}'/>
		<title>{ pageTitle(title) }</title>
		<link rel="icon" href={ static.URL("favicon.svg") } type="image/svg+xml"/>
		<link rel="stylesheet" href={ static.URL("app.css") }/>
		<script src={ static.URL("htmx.min.js") } defer></script>
		<script src={ static.URL("htmx-sse.js") } defer></script>
		<script src={ static.URL("app.js") } defer></script>
	</head>
}

// MemReadout is the sidebar's live footprint figure. It refreshes itself.
templ MemReadout(mb int) {
	<span class="fact" id="mem" hx-get="/sys/mem" hx-trigger="every 30s" hx-swap="outerHTML">{ strconv.Itoa(mb) } MB</span>
}

templ sidebar(s Shell) {
	<aside class="sidebar" id="sidebar" aria-label="Main navigation">
		<a href="/" class="flex h-14 items-center gap-2.5 px-4 text-ink hover:no-underline">
			@Mark("size-6")
			<span class="text-lg font-semibold tracking-tight">musdash</span>
		</a>
		<nav class="grid gap-0.5 px-2 py-2">
			for _, item := range Nav {
				<a
					class="nav-item"
					href={ templ.SafeURL(item.Href) }
					if item.Key == s.Active {
						aria-current="page"
					}
				>
					@Icon(item.Icon)
					{ item.Label }
				</a>
			}
			if s.Dev {
				<a
					class="nav-item"
					href="/_ui"
					if s.Active == "ui" {
						aria-current="page"
					}
				>
					@Icon("layers")
					Components
				</a>
			}
		</nav>
		<div class="mt-auto grid gap-0.5 border-t border-line px-2 py-2">
			<a
				class="nav-item"
				href="/account"
				if s.Active == "account" {
					aria-current="page"
				}
			>
				@Icon("user")
				<span class="min-w-0 flex-1 truncate">{ orDefault(s.Name, s.Email) }</span>
			</a>
			<form method="post" action="/logout">
				@CSRF(s.CSRF)
				<button type="submit" class="nav-item w-full cursor-pointer">
					@Icon("log-out")
					Sign out
				</button>
			</form>
			<p class="flex items-center justify-between px-2.5 pt-2 pb-1 text-xs text-ink-mute" title="Memory musdash itself is using right now">
				<span>musdash is using</span>
				@MemReadout(s.MemMB)
			</p>
		</div>
	</aside>
}

// Layout is the signed-in application frame.
templ Layout(s Shell) {
	<!DOCTYPE html>
	<html lang="en">
		@head(s.Title)
		<body hx-headers={ csrfHeader(s.CSRF) }>
			<a href="#content" class="sr-only focus:not-sr-only focus:absolute focus:z-50 focus:m-2 focus:rounded-md focus:bg-paper focus:px-3 focus:py-2">Skip to content</a>
			<div class="shell">
				@sidebar(s)
				<div class="main">
					<div class="topbar">
						<button type="button" class="btn btn-ghost btn-icon" data-nav-toggle aria-controls="sidebar" aria-expanded="false" aria-label="Menu">
							@Icon("menu")
						</button>
						@Mark("size-5")
						<span class="font-semibold">musdash</span>
					</div>
					<main class="page" id="content">
						@Crumbs(s.Crumbs)
						{ children... }
					</main>
				</div>
			</div>
			@Toasts(s.Flash)
		</body>
	</html>
}

// AuthLayout frames the signed-out pages: setup, sign in, reset password.
templ AuthLayout(title string, flash *Flash) {
	<!DOCTYPE html>
	<html lang="en">
		@head(title)
		<body>
			<main class="mx-auto grid min-h-dvh w-full max-w-sm content-center gap-6 px-4 py-10">
				<div class="flex items-center gap-2.5">
					@Mark("size-7")
					<span class="text-xl font-semibold tracking-tight">musdash</span>
				</div>
				{ children... }
			</main>
			@Toasts(flash)
		</body>
	</html>
}
