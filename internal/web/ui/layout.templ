package ui

import (
	"encoding/json"
	"strconv"

	"github.com/MahmoudDahdouh/musdash-go/internal/web/static"
)

// Shell carries what the application frame needs on every page.
type Shell struct {
	Title  string
	Active string // key of the current navigation item
	Name   string // signed-in person's name
	Email  string
	// Admin and Owner say what the person's role lets them do, so a page
	// can leave out what they could not use.
	Admin  bool
	Owner  bool
	CSRF   string
	MemMB  int // musdash's own memory use, shown in the sidebar
	Crumbs []Crumb
	Flash  *Flash
	Dev    bool
}

// NavItem is one entry in the sidebar.
type NavItem struct {
	Key   string
	Label string
	Href  string
	Icon  string
	// Admin items are left out for a Member, whose requests they refuse.
	Admin bool
}

// NavGroup is the sidebar entries that serve one purpose, under a heading.
// The first group has none: it is what the product is for.
type NavGroup struct {
	Title string
	Items []NavItem
	// Dev groups are drawn only in development mode.
	Dev bool
}

// Nav is the sidebar's content, grouped by what a person comes to do: run
// things, say where they run and where their code comes from, and manage
// the install itself. A new entry goes in the group whose purpose it shares.
var Nav = []NavGroup{
	{Items: []NavItem{
		{Key: "home", Label: "Home", Href: "/", Icon: "home"},
		{Key: "projects", Label: "Projects", Href: "/projects", Icon: "folder"},
		{Key: "tags", Label: "Tags", Href: "/tags", Icon: "tag"},
	}},
	{Title: "Infrastructure", Items: []NavItem{
		{Key: "servers", Label: "Servers", Href: "/servers", Icon: "server"},
		{Key: "sources", Label: "Sources", Href: "/sources", Icon: "git-branch"},
	}},
	{Title: "Administration", Items: []NavItem{
		{Key: "team", Label: "Team", Href: "/team", Icon: "users"},
		{Key: "settings", Label: "Settings", Href: "/settings", Icon: "settings", Admin: true},
	}},
	{Title: "Development", Dev: true, Items: []NavItem{
		{Key: "ui", Label: "Components", Href: "/_ui", Icon: "layers"},
	}},
}

// navGroups is the part of Nav this person sees: without the entries their
// role cannot use, and without a group that is left with none.
func navGroups(s Shell) []NavGroup {
	var out []NavGroup
	for _, g := range Nav {
		if g.Dev && !s.Dev {
			continue
		}
		shown := NavGroup{Title: g.Title}
		for _, item := range g.Items {
			if !item.Admin || s.Admin {
				shown.Items = append(shown.Items, item)
			}
		}
		if len(shown.Items) > 0 {
			out = append(out, shown)
		}
	}
	return out
}

func csrfHeader(token string) string {
	b, _ := json.Marshal(map[string]string{"X-CSRF-Token": token})
	return string(b)
}

func pageTitle(title string) string {
	if title == "" {
		return "musdash"
	}
	return title + " · musdash"
}

templ head(title string) {
	<head>
		<meta charset="utf-8"/>
		<meta name="viewport" content="width=device-width, initial-scale=1"/>
		<meta name="robots" content="noindex"/>
		<meta name="htmx-config" content='{"allowEval":false,"includeIndicatorStyles":false,"historyCacheSize":0}'/>
		<title>{ pageTitle(title) }</title>
		<link rel="icon" href={ static.URL("favicon.svg") } type="image/svg+xml"/>
		<link rel="stylesheet" href={ static.URL("app.css") }/>
		<script src={ static.URL("htmx.min.js") } defer></script>
		<script src={ static.URL("htmx-sse.js") } defer></script>
		<script src={ static.URL("app.js") } defer></script>
	</head>
}

// MemReadout is the sidebar's live footprint figure. It refreshes itself.
templ MemReadout(mb int) {
	<span class="fact" id="mem" hx-get="/sys/mem" hx-trigger="every 30s" hx-swap="outerHTML">{ strconv.Itoa(mb) } MB</span>
}

templ sidebar(s Shell) {
	<aside class="sidebar" id="sidebar" aria-label="Main navigation">
		<a href="/" class="flex h-14 items-center gap-2.5 px-4 text-ink hover:no-underline">
			@Mark("size-6")
			<span class="text-lg font-semibold tracking-tight">musdash</span>
		</a>
		<nav class="nav px-4 py-2">
			for i, g := range navGroups(s) {
				<div
					class="nav-group"
					if g.Title != "" {
						role="group"
						aria-labelledby={ "nav-group-" + strconv.Itoa(i) }
					}
				>
					if g.Title != "" {
						<h2 class="nav-heading" id={ "nav-group-" + strconv.Itoa(i) }>{ g.Title }</h2>
					}
					for _, item := range g.Items {
						<a
							class="nav-item"
							href={ templ.SafeURL(item.Href) }
							if item.Key == s.Active {
								aria-current="page"
							}
						>
							@Icon(item.Icon)
							{ item.Label }
						</a>
					}
				</div>
			}
		</nav>
		<div class="mt-auto grid gap-0.5 border-t border-line px-4 py-2">
			<a
				class="nav-item"
				href="/account"
				if s.Active == "account" {
					aria-current="page"
				}
			>
				@Icon("user")
				<span class="min-w-0 flex-1 truncate">{ orDefault(s.Name, s.Email) }</span>
			</a>
			<form method="post" action="/logout">
				@CSRF(s.CSRF)
				<button type="submit" class="nav-item w-full cursor-pointer">
					@Icon("log-out")
					Sign out
				</button>
			</form>
			<p class="flex items-center justify-between px-2 pt-2 pb-1 text-xs text-ink-mute" title="Memory musdash itself is using right now">
				<span>musdash is using</span>
				@MemReadout(s.MemMB)
			</p>
		</div>
	</aside>
}

// Layout is the signed-in application frame.
templ Layout(s Shell) {
	<!DOCTYPE html>
	<html lang="en">
		@head(s.Title)
		<body hx-headers={ csrfHeader(s.CSRF) }>
			<a href="#content" class="sr-only focus:not-sr-only focus:absolute focus:z-50 focus:m-2 focus:rounded-md focus:bg-paper focus:px-3 focus:py-2">Skip to content</a>
			<div class="shell">
				@sidebar(s)
				<div class="main">
					<div class="topbar">
						<button type="button" class="btn btn-ghost btn-icon" data-nav-toggle aria-controls="sidebar" aria-expanded="false" aria-label="Menu">
							@Icon("menu")
						</button>
						@Mark("size-5")
						<span class="font-semibold">musdash</span>
					</div>
					<main class="page" id="content">
						@Crumbs(s.Crumbs)
						{ children... }
					</main>
				</div>
			</div>
			@Toasts(s.Flash)
		</body>
	</html>
}

// AuthLayout frames the signed-out pages: setup, sign in, reset password.
templ AuthLayout(title string, flash *Flash) {
	<!DOCTYPE html>
	<html lang="en">
		@head(title)
		<body>
			<main class="mx-auto grid min-h-dvh w-full max-w-sm content-center gap-6 px-4 py-10">
				<div class="flex items-center gap-2.5">
					@Mark("size-7")
					<span class="text-xl font-semibold tracking-tight">musdash</span>
				</div>
				{ children... }
			</main>
			@Toasts(flash)
		</body>
	</html>
}
