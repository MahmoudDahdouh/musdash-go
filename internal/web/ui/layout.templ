package ui

import (
	"encoding/json"
	"strconv"
	"strings"
	"unicode/utf8"

	"github.com/MahmoudDahdouh/musdash-go/internal/web/static"
)

// Shell carries what the application frame needs on every page.
type Shell struct {
	Title  string
	Active string // key of the current navigation item
	Team   string // the team the person is in: the first step of the trail
	Name   string // signed-in person's name
	Email  string
	// Admin and Owner say what the person's role lets them do, so a page
	// can leave out what they could not use.
	Admin  bool
	Owner  bool
	CSRF   string
	Crumbs []Crumb
	Flash  *Flash
	Dev    bool
	// Address is set on a page that is the answer to a POST and shows what
	// that POST made: the address the same page has for a GET. The browser
	// is given it in place of the POST's own (static/app.js), so that
	// Refresh fetches the page instead of sending the form again.
	Address string
}

// NavItem is one entry in the sidebar.
type NavItem struct {
	Key   string
	Label string
	Href  string
	Icon  string
	// Admin items are left out for a Member, whose requests they refuse.
	Admin bool
}

// NavGroup is the sidebar entries that serve one purpose, under a heading.
// The first group has none: it is what the product is for.
type NavGroup struct {
	Title string
	Items []NavItem
	// Dev groups are drawn only in development mode.
	Dev bool
}

// Nav is the sidebar's content, grouped by what a person comes to do: run
// things, say where they run and where their code comes from, and manage
// the install itself. A new entry goes in the group whose purpose it shares.
var Nav = []NavGroup{
	{Items: []NavItem{
		{Key: "home", Label: "Home", Href: "/", Icon: "home"},
		{Key: "projects", Label: "Projects", Href: "/projects", Icon: "folder"},
		{Key: "tags", Label: "Tags", Href: "/tags", Icon: "tag"},
	}},
	{Title: "Infrastructure", Items: []NavItem{
		{Key: "servers", Label: "Servers", Href: "/servers", Icon: "server"},
		{Key: "sources", Label: "Sources", Href: "/sources", Icon: "git-branch"},
	}},
	{Title: "Administration", Items: []NavItem{
		{Key: "team", Label: "Team", Href: "/team", Icon: "users"},
		{Key: "keys", Label: "Keys & tokens", Href: "/keys", Icon: "key"},
		{Key: "notifications", Label: "Notifications", Href: "/notifications", Icon: "bell", Admin: true},
		{Key: "settings", Label: "Settings", Href: "/settings", Icon: "settings", Admin: true},
	}},
	{Title: "Development", Dev: true, Items: []NavItem{
		{Key: "ui", Label: "Components", Href: "/_ui", Icon: "layers"},
	}},
}

// navGroups is the part of Nav this person sees: without the entries their
// role cannot use, and without a group that is left with none.
func navGroups(s Shell) []NavGroup {
	var out []NavGroup
	for _, g := range Nav {
		if g.Dev && !s.Dev {
			continue
		}
		shown := NavGroup{Title: g.Title}
		for _, item := range g.Items {
			if !item.Admin || s.Admin {
				shown.Items = append(shown.Items, item)
			}
		}
		if len(shown.Items) > 0 {
			out = append(out, shown)
		}
	}
	return out
}

// trail is what the bar at the top shows: the team, which is the root of
// everything a person can open, then the page's crumbs or, for a page that
// has none, its own title, so the bar always says where you are. The team
// is put in front here and not by the handlers, so no page can leave it
// out. It is a switcher: the place another team would be chosen.
func trail(s Shell) []Crumb {
	steps := s.Crumbs
	if len(steps) == 0 && s.Title != "" {
		steps = []Crumb{{Label: s.Title}}
	}
	if s.Team == "" {
		return steps
	}
	return append([]Crumb{{Label: s.Team, Icon: "users", Menu: "/switch/teams"}}, steps...)
}

// initial is the letter in the person's mark.
func initial(s Shell) string {
	r, _ := utf8.DecodeRuneInString(strings.TrimSpace(orDefault(s.Name, s.Email)))
	if r == utf8.RuneError {
		return "?"
	}
	return strings.ToUpper(string(r))
}

func csrfHeader(token string) string {
	b, _ := json.Marshal(map[string]string{"X-CSRF-Token": token})
	return string(b)
}

func pageTitle(title string) string {
	if title == "" {
		return "musdash"
	}
	return title + " · musdash"
}

templ head(title string) {
	<head>
		<meta charset="utf-8"/>
		<meta name="viewport" content="width=device-width, initial-scale=1"/>
		<meta name="robots" content="noindex"/>
		<meta name="htmx-config" content='{"allowEval":false,"includeIndicatorStyles":false,"historyCacheSize":0}'/>
		<title>{ pageTitle(title) }</title>
		<link rel="icon" href={ static.URL("favicon.svg") } type="image/svg+xml"/>
		<link rel="stylesheet" href={ static.URL("app.css") }/>
		<script src={ static.URL("htmx.min.js") } defer></script>
		<script src={ static.URL("htmx-sse.js") } defer></script>
		<script src={ static.URL("app.js") } defer></script>
	</head>
}

templ sidebar(s Shell) {
	<aside class="sidebar" id="sidebar" aria-label="Main navigation">
		<a href="/" class="flex h-14 items-center gap-2.5 px-4 text-ink hover:no-underline">
			@Mark("size-6")
			<span class="text-lg font-semibold tracking-tight">musdash</span>
		</a>
		<nav class="nav px-4 py-2">
			for i, g := range navGroups(s) {
				<div
					class="nav-group"
					if g.Title != "" {
						role="group"
						aria-labelledby={ "nav-group-" + strconv.Itoa(i) }
					}
				>
					if g.Title != "" {
						<h2 class="nav-heading" id={ "nav-group-" + strconv.Itoa(i) }>{ g.Title }</h2>
					}
					for _, item := range g.Items {
						<a
							class="nav-item"
							href={ templ.SafeURL(item.Href) }
							if item.Key == s.Active {
								aria-current="page"
							}
						>
							@Icon(item.Icon)
							{ item.Label }
						</a>
					}
				</div>
			}
		</nav>
	</aside>
}

// userMenu is the end of the bar: who is signed in, and what is theirs
// rather than the team's. Sign out is a form, so the form is in the menu
// with its button: the question it asks is read from there.
templ userMenu(s Shell) {
	<div class="topbar-end">
		@Menu(MenuProps{ID: "usermenu", Label: "Account: " + orDefault(s.Name, s.Email), Class: "user-button", End: true, Button: userButton(s), Head: userHead(s)}) {
			@MenuItem(MenuItemProps{Href: "/account", Icon: "user", Label: "Account", Current: s.Active == "account"})
			if s.Admin {
				@MenuItem(MenuItemProps{Href: "/settings", Icon: "settings", Label: "Settings", Current: s.Active == "settings"})
			}
			@MenuSep()
			<form method="post" action="/logout">
				@CSRF(s.CSRF)
				@MenuItem(MenuItemProps{Icon: "log-out", Label: "Sign out", Danger: true, Attrs: Ask("Sign out of musdash?", "You will need your password to come back in.", "Sign out", true)})
			</form>
		}
	</div>
}

templ userButton(s Shell) {
	<span class="avatar" aria-hidden="true">{ initial(s) }</span>
	<span class="hidden truncate sm:block">{ orDefault(s.Name, s.Email) }</span>
	@Icon("chevron-down")
}

templ userHead(s Shell) {
	if s.Name != "" {
		<p class="truncate font-semibold">{ s.Name }</p>
	}
	<p class="truncate text-sm text-ink-mute">{ s.Email }</p>
}

// Layout is the signed-in application frame.
templ Layout(s Shell) {
	<!DOCTYPE html>
	<html lang="en">
		@head(s.Title)
		<body
			hx-headers={ csrfHeader(s.CSRF) }
			if s.Address != "" {
				data-address={ s.Address }
			}
		>
			<a href="#content" class="sr-only focus:not-sr-only focus:absolute focus:z-50 focus:m-2 focus:rounded-md focus:bg-paper focus:px-3 focus:py-2">Skip to content</a>
			<div class="shell">
				@sidebar(s)
				<div class="main">
					<div class="topbar">
						<button type="button" class="btn btn-ghost btn-icon topbar-menu" data-nav-toggle aria-controls="sidebar" aria-expanded="false" aria-label="Menu">
							@Icon("menu")
						</button>
						@Trail(trail(s))
						@userMenu(s)
					</div>
					<main class="page" id="content">
						{ children... }
					</main>
				</div>
			</div>
			@confirmDialog()
			@Toasts(s.Flash)
		</body>
	</html>
}

// confirmDialog is the one dialog that asks before a critical action. A
// submit button carrying data-confirm fills it in and opens it instead of
// submitting (static/app.js); Cancel has the focus, so Enter does not act.
templ confirmDialog() {
	<dialog class="modal" id="confirm" aria-labelledby="confirm-title" aria-describedby="confirm-text">
		<div class="card-head">
			<h2 class="card-title" id="confirm-title">Are you sure?</h2>
			@Button(ButtonProps{Variant: Ghost, Small: true, IconOnly: true, Icon: "x", Label: "Close", Attrs: templ.Attributes{"data-close": true}})
		</div>
		<div class="card-body">
			<p class="text-ink-soft" id="confirm-text"></p>
		</div>
		<div class="card-foot">
			@Button(ButtonProps{Attrs: templ.Attributes{"data-close": true, "autofocus": true}}) {
				Cancel
			}
			<button type="button" class="btn btn-primary" id="confirm-ok">Confirm</button>
		</div>
	</dialog>
}

// AuthLayout frames the signed-out pages: setup, sign in, reset password.
templ AuthLayout(title string, flash *Flash) {
	<!DOCTYPE html>
	<html lang="en">
		@head(title)
		<body>
			<main class="mx-auto grid min-h-dvh w-full max-w-sm content-center gap-6 px-4 py-10">
				<div class="flex items-center gap-2.5">
					@Mark("size-7")
					<span class="text-xl font-semibold tracking-tight">musdash</span>
				</div>
				{ children... }
			</main>
			@Toasts(flash)
		</body>
	</html>
}
