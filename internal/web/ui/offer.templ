package ui

import "github.com/MahmoudDahdouh/musdash-go/internal/web/static"

// OfferProps configures an Offer.
type OfferProps struct {
	// Href is where the action leads: the form that adds the thing.
	Href  string
	Title string
	Text  string
	// Logo names whose mark it has (static/logo-<name>.svg). With none, or
	// with a name this build has no file for, Icon is drawn in its place.
	Logo string
	Icon string
	// Docs and Website are addresses outside the dashboard, each a button
	// at the start of the foot when it is set.
	Docs    string
	Website string
	// Action is what the button at the end says. Empty is "Deploy".
	Action string
	// Search is the text a filter field looks in.
	Search string
}

func (p OfferProps) action() string {
	if p.Action == "" {
		return "Deploy"
	}
	return p.Action
}

// hasLogo asks the build: a name can come from the catalogue, and a file
// that is missing must cost the mark, not the page.
func (p OfferProps) hasLogo() bool {
	return p.Logo != "" && static.Has(LogoFile(p.Logo))
}

// Offers is the grid of what can be added. label says what they are, for a
// screen reader.
templ Offers(label string) {
	<ul class="tiles offers" aria-label={ label }>
		{ children... }
	</ul>
}

// Offer is one thing that can be added: its mark in its owner's colours,
// its name and a line about it and, under a rule, where to read about it
// (at the start) and the button that starts it (at the end). That button
// is the one link into the dashboard and covers the card, so a press
// anywhere on the card is a press on it; the links that lead outside stand
// above it.
templ Offer(p OfferProps) {
	<li
		class="tile offer"
		if p.Search != "" {
			data-search={ p.Search }
		}
	>
		<div class="offer-head">
			<span class="offer-mark">
				if p.hasLogo() {
					<img src={ static.URL(LogoFile(p.Logo)) } alt="" width="48" height="48" loading="lazy" decoding="async"/>
				} else {
					@Icon(p.Icon)
				}
			</span>
			<div class="grid min-w-0 gap-1">
				<h3 class="tile-title">{ p.Title }</h3>
				<p class="tile-text">{ p.Text }</p>
			</div>
		</div>
		<div class="offer-foot">
			if p.Docs != "" {
				<a class="btn btn-sm btn-ghost" href={ templ.SafeURL(p.Docs) } target="_blank" rel="noopener" aria-label={ p.Title + ": Docs" }>
					@Icon("book")
					Docs
				</a>
			}
			if p.Website != "" {
				<a class="btn btn-sm btn-ghost" href={ templ.SafeURL(p.Website) } target="_blank" rel="noopener" aria-label={ p.Title + ": Website" }>
					@Icon("globe")
					Website
				</a>
			}
			<a class="btn btn-sm btn-secondary offer-go" href={ templ.SafeURL(p.Href) } aria-label={ p.action() + ": " + p.Title }>
				{ p.action() }
				@Icon("arrow-right")
			</a>
		</div>
	</li>
}
