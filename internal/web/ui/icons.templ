package ui

// Icon renders one icon from the built-in set as inline SVG. Icons are
// decorative: the control or text next to them carries the meaning, so they
// are hidden from assistive technology. Paths follow the Lucide set (ISC).
templ Icon(name string, class ...string) {
	<svg class={ "icon", class } viewBox="0 0 24 24" aria-hidden="true" focusable="false">
		switch name {
			case "folder":
				<path d="M20 20a2 2 0 0 0 2-2V8a2 2 0 0 0-2-2h-7.9a2 2 0 0 1-1.69-.9L9.6 3.9A2 2 0 0 0 7.93 3H4a2 2 0 0 0-2 2v13a2 2 0 0 0 2 2Z"></path>
			case "server":
				<rect width="20" height="8" x="2" y="2" rx="2"></rect>
				<rect width="20" height="8" x="2" y="14" rx="2"></rect>
				<path d="M6 6h.01M6 18h.01"></path>
			case "box":
				<path d="M21 8a2 2 0 0 0-1-1.73l-7-4a2 2 0 0 0-2 0l-7 4A2 2 0 0 0 3 8v8a2 2 0 0 0 1 1.73l7 4a2 2 0 0 0 2 0l7-4A2 2 0 0 0 21 16Z"></path>
				<path d="m3.3 7 8.7 5 8.7-5M12 22V12"></path>
			case "database":
				<ellipse cx="12" cy="5" rx="9" ry="3"></ellipse>
				<path d="M3 5v14a9 3 0 0 0 18 0V5"></path>
				<path d="M3 12a9 3 0 0 0 18 0"></path>
			case "layers":
				<path d="m12.83 2.18a2 2 0 0 0-1.66 0L2.6 6.08a1 1 0 0 0 0 1.83l8.58 3.91a2 2 0 0 0 1.66 0l8.58-3.9a1 1 0 0 0 0-1.83Z"></path>
				<path d="m22 17.65-9.17 4.16a2 2 0 0 1-1.66 0L2 17.65"></path>
				<path d="m22 12.65-9.17 4.16a2 2 0 0 1-1.66 0L2 12.65"></path>
			case "plus":
				<path d="M5 12h14M12 5v14"></path>
			case "x":
				<path d="M18 6 6 18M6 6l12 12"></path>
			case "check":
				<path d="M20 6 9 17l-5-5"></path>
			case "chevron-right":
				<path d="m9 18 6-6-6-6"></path>
			case "trash":
				<path d="M3 6h18M19 6v14a2 2 0 0 1-2 2H7a2 2 0 0 1-2-2V6M8 6V4a2 2 0 0 1 2-2h4a2 2 0 0 1 2 2v2"></path>
			case "log-out":
				<path d="M9 21H5a2 2 0 0 1-2-2V5a2 2 0 0 1 2-2h4M16 17l5-5-5-5M21 12H9"></path>
			case "user":
				<path d="M19 21v-2a4 4 0 0 0-4-4H9a4 4 0 0 0-4 4v2"></path>
				<circle cx="12" cy="7" r="4"></circle>
			case "users":
				<path d="M16 21v-2a4 4 0 0 0-4-4H6a4 4 0 0 0-4 4v2"></path>
				<circle cx="9" cy="7" r="4"></circle>
				<path d="M22 21v-2a4 4 0 0 0-3-3.87M16 3.13a4 4 0 0 1 0 7.75"></path>
			case "settings":
				<path d="M4 21v-7M4 10V3M12 21v-9M12 8V3M20 21v-5M20 12V3M2 14h4M10 8h4M18 16h4"></path>
			case "globe":
				<circle cx="12" cy="12" r="10"></circle>
				<path d="M12 2a14.5 14.5 0 0 0 0 20 14.5 14.5 0 0 0 0-20M2 12h20"></path>
			case "terminal":
				<path d="m4 17 6-6-6-6M12 19h8"></path>
			case "git-branch":
				<path d="M6 3v12"></path>
				<circle cx="18" cy="6" r="3"></circle>
				<circle cx="6" cy="18" r="3"></circle>
				<path d="M18 9a9 9 0 0 1-9 9"></path>
			case "alert":
				<path d="m21.73 18-8-14a2 2 0 0 0-3.48 0l-8 14A2 2 0 0 0 4 21h16a2 2 0 0 0 1.73-3ZM12 9v4M12 17h.01"></path>
			case "info":
				<circle cx="12" cy="12" r="10"></circle>
				<path d="M12 16v-4M12 8h.01"></path>
			case "copy":
				<rect width="14" height="14" x="8" y="8" rx="2"></rect>
				<path d="M4 16c-1.1 0-2-.9-2-2V4c0-1.1.9-2 2-2h10c1.1 0 2 .9 2 2"></path>
			case "external":
				<path d="M15 3h6v6M10 14 21 3M18 13v6a2 2 0 0 1-2 2H5a2 2 0 0 1-2-2V8a2 2 0 0 1 2-2h6"></path>
			case "menu":
				<path d="M4 6h16M4 12h16M4 18h16"></path>
			case "key":
				<path d="m15.5 7.5 2.3 2.3a1 1 0 0 0 1.4 0l2.1-2.1a1 1 0 0 0 0-1.4L19 4M21 2l-9.6 9.6"></path>
				<circle cx="7.5" cy="15.5" r="5.5"></circle>
			case "clock":
				<circle cx="12" cy="12" r="10"></circle>
				<path d="M12 6v6l4 2"></path>
			case "refresh":
				<path d="M3 12a9 9 0 0 1 9-9 9.75 9.75 0 0 1 6.74 2.74L21 8M21 3v5h-5M21 12a9 9 0 0 1-9 9 9.75 9.75 0 0 1-6.74-2.74L3 16M8 16H3v5"></path>
			case "play":
				<path d="M6 3 20 12 6 21Z"></path>
			case "stop":
				<rect width="18" height="18" x="3" y="3" rx="2"></rect>
			case "bell":
				<path d="M6 8a6 6 0 0 1 12 0c0 7 3 9 3 9H3s3-2 3-9M10.3 21a1.94 1.94 0 0 0 3.4 0"></path>
			case "drive":
				<path d="M22 12H2M5.45 5.11 2 12v6a2 2 0 0 0 2 2h16a2 2 0 0 0 2-2v-6l-3.45-6.89A2 2 0 0 0 16.76 4H7.24a2 2 0 0 0-1.79 1.11zM6 16h.01M10 16h.01"></path>
			case "deploy":
				<path d="M12 13v8M4 14.9A7 7 0 1 1 15.71 8h1.79a4.5 4.5 0 0 1 2.5 8.24M8 17l4-4 4 4"></path>
			case "pencil":
				<path d="M21.17 6.81a1 1 0 0 0-3.99-3.99L3.84 16.17a2 2 0 0 0-.5.83l-1.32 4.35a.5.5 0 0 0 .62.62l4.35-1.32a2 2 0 0 0 .83-.5zM15 5l4 4"></path>
			case "lock":
				<rect width="18" height="11" x="3" y="11" rx="2"></rect>
				<path d="M7 11V7a5 5 0 0 1 10 0v4"></path>
		}
	</svg>
}

// Mark is the musdash logo mark.
templ Mark(class string) {
	<svg class={ class } viewBox="0 0 24 24" aria-hidden="true" focusable="false">
		<rect width="24" height="24" rx="6" class="fill-brand-600"></rect>
		<path d="M7 16.5v-5.25a2.5 2.5 0 0 1 5 0v5.25m0-5.25a2.5 2.5 0 0 1 5 0v5.25" fill="none" class="stroke-white" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"></path>
	</svg>
}
